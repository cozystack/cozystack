# End-to-end coverage for the Proxmox substrate.
#
# Parked as .disabled on purpose. Suites are discovered with
#   find hack/e2e-chainsaw -mindepth 2 -maxdepth 2 -name chainsaw-test.yaml
# so this one is registered nowhere and cannot be selected by the normal lanes.
# That is the point: it needs a Proxmox hypervisor, and the runners those lanes
# use will never have one. .github/workflows/e2e-proxmox.yaml drops the suffix
# on a self-hosted runner that does.
#
# What this asserts is what NO other suite can, and every item is a bug this
# integration actually hit rather than a shape someone imagined:
#
#   ProxmoxCluster Ready      — a missing IPAM provider, or the managed-by
#                               annotation that stops CAPI setting an ownerRef
#   linked-clone boot disk    — 8 KiB per worker against 10.2 GiB, and nothing
#                               fails when it regresses
#   Machine Running + nodeRef — capmox writes proxmox://<UUID>, the CCM's default
#                               mode writes proxmox://<region>/<vmid>, and CAPI
#                               pairs on an exact match
#   node Ready + region label — the CSI node plugin exits fatally without it
#   PVC bound AND on the host — Bound is not proof that a disk exists
#   unattended replacement    — the controller that removes a departed Node
#                               must not itself depend on that Node
#
# It does NOT install Cozystack. The upstream lanes build a sandbox per run;
# this one runs against an existing cluster and an existing hypervisor, which is
# a weaker guarantee and is stated rather than implied.
apiVersion: chainsaw.kyverno.io/v1alpha1
kind: Test
metadata:
  name: kubernetes-proxmox
spec:
  # Teardown is the finally below, which must run whether the suite passed or
  # failed: a leaked tenant leaves VMs on the hypervisor.
  skipDelete: true
  catch:
  - events: {}
  - script:
      content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh diagnostics
  steps:
  - name: tenant-and-cluster
    try:
    # Rendered by run-proxmox.sh rather than applied as is: every stand-specific
    # value in tenant.yaml is a ${COZY_PVE_*} variable, the script supplies the
    # defaults and expands them, and it refuses a fixture with a variable left
    # in it. Another stand sets variables instead of editing the file.
    - script:
        content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh apply-tenant
    # Declarative where the object lives in this cluster, per the conventions in
    # docs/agents/e2e-testing.md — the assert polls to its own timeout and
    # reports a structured diff rather than a generic non-zero exit.
    # Both the name and the namespace matter here. The resource definition
    # prefixes the release, so the Kubernetes CR named k8s-e2e produces
    # ProxmoxCluster/kubernetes-k8s-e2e, and it lives in the tenant's own
    # namespace rather than the suite's default one. Asserted with the wrong
    # pair this step simply spends its 10m and fails on a healthy stand.
    - assert:
        timeout: 10m
        resource:
          apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
          kind: ProxmoxCluster
          metadata:
            name: kubernetes-k8s-e2e
            namespace: tenant-e2eproxmox
          status:
            ready: true
    - assert:
        timeout: 20m
        resource:
          apiVersion: cluster.x-k8s.io/v1beta1
          kind: Machine
          metadata:
            namespace: tenant-e2eproxmox
          status:
            phase: Running
    # The controller half of the CSI driver and the cloud-controller-manager
    # run in THIS cluster, not in the tenant; that is the property the storage
    # PR is about, so the suite asserts it rather than only the tenant side.
    - assert:
        timeout: 5m
        resource:
          apiVersion: apps/v1
          kind: Deployment
          metadata:
            name: kubernetes-k8s-e2e-pcsi-controller
            namespace: tenant-e2eproxmox
          status:
            readyReplicas: 1
    - assert:
        timeout: 5m
        resource:
          apiVersion: apps/v1
          kind: Deployment
          metadata:
            name: kubernetes-k8s-e2e-pccm
            namespace: tenant-e2eproxmox
          status:
            readyReplicas: 1

  - name: vm-shape-on-the-hypervisor
    try:
    - script:
        timeout: 3m
        content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh linked-clone

  - name: tenant-node-usable
    try:
    - script:
        timeout: 10m
        content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh tenant-node

  - name: storage-round-trip
    try:
    - script:
        timeout: 10m
        content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh pvc-round-trip

  - name: replacement-converges-unattended
    try:
    - script:
        timeout: 20m
        content: cd ../../.. && hack/e2e-chainsaw/_lib/run-proxmox.sh replacement
    finally:
    - script:
        content: |
          set -eu
          # keep_tenant is honoured here as well as in the workflow's own
          # teardown, or the suite would delete what the operator asked to keep.
          if [ "${COZY_KEEP_TENANT:-false}" = "true" ]; then
            echo "COZY_KEEP_TENANT=true: leaving the tenant in place"
            exit 0
          fi
          kubectl delete kubernetesnodes.apps.cozystack.io -n "${COZY_PROXMOX_NS:-tenant-e2eproxmox}" --all --ignore-not-found
          kubectl delete kubernetes.apps.cozystack.io -n "${COZY_PROXMOX_NS:-tenant-e2eproxmox}" --all --ignore-not-found
          kubectl delete tenant.apps.cozystack.io e2eproxmox -n tenant-root --ignore-not-found
