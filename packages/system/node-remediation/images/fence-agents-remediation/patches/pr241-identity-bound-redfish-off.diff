+		}
+	})
+	t.Run("namespaced read grants", func(t *testing.T) {
+		var role rbacv1.Role
+		data, err := os.ReadFile(filepath.Join("..", "..", "config", "rbac", "safety", "credential_role.yaml"))
+		if err != nil {
+			t.Fatal(err)
+		}
