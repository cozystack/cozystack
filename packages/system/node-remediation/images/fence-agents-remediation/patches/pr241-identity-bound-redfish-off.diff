+		data, err = os.ReadFile(filepath.Join("..", "..", "config", "rbac", "safety", "cluster_role.yaml"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := yaml.UnmarshalStrict(data, &clusterRole); err != nil {
+			t.Fatal(err)
+		}
