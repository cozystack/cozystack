diff --git a/pkg/redfish/redfish.go b/pkg/redfish/redfish.go
new file mode 100644
index 000000000..da84ba38b
--- /dev/null
+++ b/pkg/redfish/redfish.go
@@ -0,0 +1,275 @@
+package redfish
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+	"unicode"
+)
+
+var uuidPattern = regexp.MustCompile(`^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`)
+var systemPathPattern = regexp.MustCompile(`^/redfish/v1/Systems/[A-Za-z0-9_~-][A-Za-z0-9._~-]*$`)
+
+// Config fixes the authenticated system endpoint for one bounded verification.
+type Config struct {
+	Endpoint     string
+	SystemURI    string
+	SystemUUID   string
+	CA           []byte
+	Username     string
+	Password     string
+	Timeout      time.Duration
+	PollInterval time.Duration
+}
+
+// ValidSystemUUID rejects absent and uninitialized SMBIOS identifiers.
+func ValidSystemUUID(uuid string) bool {
+	return uuidPattern.MatchString(uuid) && uuid != "00000000-0000-0000-0000-000000000000" && strings.ToLower(uuid) != "ffffffff-ffff-ffff-ffff-ffffffffffff"
+}
+
+// ValidateTarget requires an explicit ComputerSystem, not collection discovery.
+func ValidateTarget(endpoint, systemURI string) error {
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || u.Opaque != "" || (u.Path != "" && u.Path != "/") || u.RawPath != "" {
+		return fmt.Errorf("invalid HTTPS Redfish endpoint")
+	}
+	if !systemPathPattern.MatchString(systemURI) {
+		return fmt.Errorf("explicit ComputerSystem URI required")
+	}
+	return nil
+}
+
+type computerSystem struct {
+	UUID       string `json:"UUID"`
+	PowerState string `json:"PowerState"`
+	Actions    map[string]struct {
+		Target string `json:"target"`
+	} `json:"Actions"`
+}
+
+// VerifyOff reports only same-system Off; force permits a guarded ForceOff action.
+func VerifyOff(ctx context.Context, cfg Config, force bool, beforeAction func(context.Context) error) error {
+	if err := ValidateTarget(cfg.Endpoint, cfg.SystemURI); err != nil {
+		return err
+	}
+	if !ValidSystemUUID(cfg.SystemUUID) || cfg.Timeout <= 0 || cfg.Timeout > time.Minute {
+		return fmt.Errorf("invalid Redfish identity or timeout")
+	}
+	ctx, cancel := context.WithTimeout(ctx, cfg.Timeout)
+	defer cancel()
+	var roots *x509.CertPool
+	if len(cfg.CA) > 0 {
+		roots = x509.NewCertPool()
+		if !roots.AppendCertsFromPEM(cfg.CA) {
+			return fmt.Errorf("invalid Redfish CA")
+		}
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}, Proxy: nil}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: cfg.Timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	endpoint := strings.TrimSuffix(cfg.Endpoint, "/")
+	read := func() (*computerSystem, error) {
+		body, err := request(ctx, client, cfg, http.MethodGet, endpoint+cfg.SystemURI, nil)
+		if err != nil {
+			return nil, err
+		}
+		if err := uniqueJSON(body); err != nil {
+			return nil, fmt.Errorf("ambiguous Redfish response")
+		}
+		var fields map[string]json.RawMessage
+		if err := json.Unmarshal(body, &fields); err != nil || fields["UUID"] == nil || fields["PowerState"] == nil {
+			return nil, fmt.Errorf("canonical redfish identity and power fields required")
+		}
+		var uuid, power string
+		if err := json.Unmarshal(fields["UUID"], &uuid); err != nil {
+			return nil, fmt.Errorf("malformed Redfish system UUID")
+		}
+		if err := json.Unmarshal(fields["PowerState"], &power); err != nil {
+			return nil, fmt.Errorf("malformed Redfish power state")
+		}
+		var actions map[string]struct {
+			Target string `json:"target"`
+		}
+		if fields["Actions"] != nil {
+			if err := json.Unmarshal(fields["Actions"], &actions); err != nil {
+				return nil, fmt.Errorf("malformed Redfish actions")
+			}
+		}
+		system := &computerSystem{UUID: uuid, PowerState: power, Actions: actions}
+		if !ValidSystemUUID(system.UUID) || !strings.EqualFold(system.UUID, cfg.SystemUUID) {
+			return nil, fmt.Errorf("redfish system UUID mismatch")
+		}
+		if system.PowerState != "On" && system.PowerState != "Off" {
+			return nil, fmt.Errorf("unknown Redfish power state")
+		}
+		return system, nil
+	}
+	system, err := read()
+	if err != nil {
+		return err
+	}
+	if system.PowerState == "Off" {
+		return nil
+	}
+	if !force {
+		return fmt.Errorf("redfish system is not Off")
+	}
+	action, found := system.Actions["#ComputerSystem.Reset"]
+	if !found {
+		return fmt.Errorf("redfish reset action missing")
+	}
+	allowedAction := cfg.SystemURI + "/Actions/ComputerSystem.Reset"
+	if action.Target != allowedAction && action.Target != endpoint+allowedAction {
+		return fmt.Errorf("redfish reset target differs from bound system")
+	}
+	if beforeAction == nil {
+		return fmt.Errorf("redfish pre-action validation missing")
+	}
+	system, err = read()
+	if err != nil {
+		return err
+	}
+	if system.PowerState == "Off" {
+		return nil
+	}
+	if current, ok := system.Actions["#ComputerSystem.Reset"]; !ok || current.Target != action.Target {
+		return fmt.Errorf("redfish reset target changed")
+	}
+	if err := beforeAction(ctx); err != nil {
+		return err
+	}
+	if _, err := request(ctx, client, cfg, http.MethodPost, endpoint+allowedAction, []byte(`{"ResetType":"ForceOff"}`)); err != nil {
+		return err
+	}
+	interval := cfg.PollInterval
+	if interval <= 0 {
+		interval = 200 * time.Millisecond
+	}
+	for {
+		system, err = read()
+		if err != nil {
+			return err
+		}
+		if system.PowerState == "Off" {
+			return nil
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return fmt.Errorf("redfish Off confirmation timed out: %w", ctx.Err())
+		case <-timer.C:
+		}
+	}
+}
+
+func request(ctx context.Context, client *http.Client, cfg Config, method, target string, body []byte) (data []byte, requestErr error) {
+	req, err := http.NewRequestWithContext(ctx, method, target, bytes.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("construct Redfish request")
+	}
+	req.SetBasicAuth(cfg.Username, cfg.Password)
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("authenticated Redfish request failed")
+	}
+	defer func() {
+		if err := resp.Body.Close(); err != nil && requestErr == nil {
+			requestErr = fmt.Errorf("close redfish response: %w", err)
+		}
+	}()
+	if method == http.MethodGet && resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("redfish GET rejected: HTTP %d", resp.StatusCode)
+	}
+	if method == http.MethodPost {
+		if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusAccepted && resp.StatusCode != http.StatusNoContent {
+			return nil, fmt.Errorf("redfish reset rejected: HTTP %d", resp.StatusCode)
+		}
+		return nil, nil
+	}
+	data, err = io.ReadAll(io.LimitReader(resp.Body, (1<<20)+1))
+	if err != nil || len(data) > 1<<20 {
+		return nil, fmt.Errorf("invalid Redfish response size")
+	}
+	return data, nil
+}
+
+func foldJSONName(name string) string {
+	var folded strings.Builder
+	folded.Grow(len(name))
+	for _, r := range name {
+		for {
+			next := unicode.SimpleFold(r)
+			if next <= r {
+				folded.WriteRune(next)
+				break
+			}
+			r = next
+		}
+	}
+	return folded.String()
+}
+
+func uniqueJSON(data []byte) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	var visit func(int) error
+	visit = func(depth int) error {
+		if depth > 32 {
+			return fmt.Errorf("JSON nesting limit")
+		}
+		token, err := decoder.Token()
+		if err != nil {
+			return err
+		}
+		switch token {
+		case json.Delim('{'):
+			seen := map[string]bool{}
+			for decoder.More() {
+				key, err := decoder.Token()
+				if err != nil {
+					return err
+				}
+				name, ok := key.(string)
+				name = strings.ToLower(foldJSONName(name))
+				if !ok || seen[name] {
+					return fmt.Errorf("duplicate JSON key")
+				}
+				seen[name] = true
+				if err := visit(depth + 1); err != nil {
+					return err
+				}
+			}
+			_, err = decoder.Token()
+			return err
+		case json.Delim('['):
+			for decoder.More() {
+				if err := visit(depth + 1); err != nil {
+					return err
+				}
+			}
+			_, err = decoder.Token()
+			return err
+		}
+		return nil
+	}
+	if err := visit(0); err != nil {
+		return err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return fmt.Errorf("trailing JSON")
+	}
+	return nil
+}
diff --git a/pkg/redfish/redfish_test.go b/pkg/redfish/redfish_test.go
new file mode 100644
index 000000000..4c69d7ef1
--- /dev/null
+++ b/pkg/redfish/redfish_test.go
@@ -0,0 +1,197 @@
+package redfish
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+const testUUID = "00112233-4455-4677-8899-aabbccddeeff"
+const testURI = "/redfish/v1/Systems/1"
+
+func TestVerifyOff(t *testing.T) {
+	for _, tc := range []struct {
+		readOnly                                                                             bool
+		noReset                                                                              bool
+		name, uuid, power, target, raw, wantErrText                                          string
+		status                                                                               int
+		acceptedOn, alreadyOff, redirect, untrusted, deny, timeout, changedUUID, blockAction bool
+		wantErr                                                                              bool
+	}{
+		{name: "off after accepted reset", uuid: testUUID, power: "On"},
+		{name: "already off", uuid: testUUID, power: "Off", alreadyOff: true},
+		{name: "wrong UUID", uuid: "aabbccdd-eeff-4011-8233-445566778899", power: "On", wantErr: true},
+		{name: "missing UUID", power: "Off", wantErr: true},
+		{name: "zero UUID", uuid: "00000000-0000-0000-0000-000000000000", power: "Off", wantErr: true},
+		{name: "ones UUID", uuid: "ffffffff-ffff-ffff-ffff-ffffffffffff", power: "Off", wantErr: true},
+		{name: "malformed UUID", uuid: "bad", power: "Off", wantErr: true},
+		{name: "ambiguous UUID", raw: `{"UUID":"00112233-4455-4677-8899-aabbccddeeff","UUID":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"Off"}`, wantErr: true},
+		{name: "case-aliased UUID", raw: `{"UUID":"aabbccdd-eeff-4011-8233-445566778899","uuid":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"Off"}`, wantErr: true},
+		{name: "missing canonical UUID key", raw: `{"uuid":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"Off"}`, wantErr: true},
+		{name: "case-aliased power", raw: `{"UUID":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"On","powerstate":"Off"}`, wantErr: true},
+		{name: "Unicode-aliased power read-only", raw: `{"UUID":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"On","Powerſtate":"Off"}`, readOnly: true, wantErr: true, wantErrText: "ambiguous Redfish response"},
+		{name: "Unicode-aliased power action", raw: `{"UUID":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"On","Powerſtate":"Off","Actions":{"#ComputerSystem.Reset":{"target":"/redfish/v1/Systems/1/Actions/ComputerSystem.Reset"}}}`, wantErr: true, wantErrText: "ambiguous Redfish response", noReset: true},
+		{name: "Unicode-aliased Off read-only", raw: `{"UUID":"00112233-4455-4677-8899-aabbccddeeff","PowerState":"Off","Powerſtate":"On"}`, readOnly: true, wantErr: true, wantErrText: "ambiguous Redfish response"},
+		{name: "malformed response", raw: `{`, wantErr: true},
+		{name: "unknown power", uuid: testUUID, power: "PoweringOff", wantErr: true},
+		{name: "accepted still on", uuid: testUUID, power: "On", acceptedOn: true, wantErr: true},
+		{name: "cross system action", uuid: testUUID, power: "On", target: "/redfish/v1/Systems/2/Actions/ComputerSystem.Reset", wantErr: true},
+		{name: "cross origin action", uuid: testUUID, power: "On", target: "https://other.example/redfish/v1/Systems/1/Actions/ComputerSystem.Reset", wantErr: true},
+		{name: "redirect", redirect: true, wantErr: true},
+		{name: "untrusted TLS", untrusted: true, wantErr: true},
+		{name: "unauthorized", deny: true, wantErr: true},
+		{name: "server error", status: http.StatusServiceUnavailable, wantErr: true},
+		{name: "timeout", timeout: true, wantErr: true},
+		{name: "UUID changed after reset", uuid: testUUID, power: "On", changedUUID: true, wantErr: true},
+		{name: "target changed before reset", uuid: testUUID, power: "On", blockAction: true, wantErr: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var resets, redirected atomic.Int32
+			server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/elsewhere" {
+					redirected.Add(1)
+					w.WriteHeader(http.StatusOK)
+					return
+				}
+				if tc.timeout {
+					<-r.Context().Done()
+					return
+				}
+				if tc.redirect {
+					http.Redirect(w, r, "/elsewhere", http.StatusFound)
+					return
+				}
+				user, password, ok := r.BasicAuth()
+				if tc.deny || !ok || user != "user" || password != "password" {
+					w.WriteHeader(http.StatusUnauthorized)
+					return
+				}
+				if tc.status != 0 {
+					w.WriteHeader(tc.status)
+					return
+				}
+				if r.Method == http.MethodPost {
+					if r.URL.Path != testURI+"/Actions/ComputerSystem.Reset" {
+						t.Error("wrong action URI")
+					}
+					var action struct{ ResetType string }
+					if err := json.NewDecoder(r.Body).Decode(&action); err != nil || action.ResetType != "ForceOff" {
+						t.Error("wrong reset action")
+					}
+					resets.Add(1)
+					w.WriteHeader(http.StatusAccepted)
+					return
+				}
+				if r.URL.Path != testURI {
+					t.Error("wrong system URI")
+				}
+				if tc.raw != "" {
+					_, _ = w.Write([]byte(tc.raw))
+					return
+				}
+				uuid, power := tc.uuid, tc.power
+				if resets.Load() > 0 {
+					if !tc.acceptedOn {
+						power = "Off"
+					}
+					if tc.changedUUID {
+						uuid = "aabbccdd-eeff-4011-8233-445566778899"
+					}
+				}
+				target := tc.target
+				if target == "" {
+					target = testURI + "/Actions/ComputerSystem.Reset"
+				}
+				_ = json.NewEncoder(w).Encode(map[string]any{"UUID": uuid, "PowerState": power, "Actions": map[string]any{"#ComputerSystem.Reset": map[string]string{"target": target}}})
+			}))
+			defer server.Close()
+			ca := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw})
+			if tc.untrusted {
+				ca = nil
+			}
+			cfg := Config{Endpoint: server.URL, SystemURI: testURI, SystemUUID: testUUID, CA: ca, Username: "user", Password: "password", Timeout: 150 * time.Millisecond, PollInterval: time.Millisecond}
+			force := !tc.readOnly
+			var precondition func(context.Context) error
+			if force {
+				precondition = func(context.Context) error {
+					if tc.blockAction {
+						return errors.New("changed target")
+					}
+					return nil
+				}
+			}
+			err := VerifyOff(context.Background(), cfg, force, precondition)
+			if (err != nil) != tc.wantErr {
+				t.Errorf("error = %v, wantErr %t", err, tc.wantErr)
+			}
+			if tc.wantErrText != "" && (err == nil || !strings.Contains(err.Error(), tc.wantErrText)) {
+				t.Errorf("error = %v, want text %q", err, tc.wantErrText)
+			}
+			if tc.noReset && resets.Load() != 0 {
+				t.Errorf("reset issued for ambiguous response: %d", resets.Load())
+			}
+			if tc.alreadyOff && resets.Load() != 0 {
+				t.Error("reset already-off system")
+			}
+			if tc.blockAction && resets.Load() != 0 {
+				t.Error("reset after failed precondition")
+			}
+			if redirected.Load() != 0 {
+				t.Error("followed redirect")
+			}
+		})
+	}
+}
+
+func TestUnavailableOrCanceled(t *testing.T) {
+	for _, canceled := range []bool{false, true} {
+		name := "unavailable"
+		if canceled {
+			name = "canceled"
+		}
+		t.Run(name, func(t *testing.T) {
+			var requests atomic.Int32
+			server := httptest.NewTLSServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { requests.Add(1) }))
+			cfg := Config{Endpoint: server.URL, SystemURI: testURI, SystemUUID: testUUID, CA: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), Timeout: 100 * time.Millisecond}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if canceled {
+				cancel()
+				defer server.Close()
+			} else {
+				server.Close()
+			}
+			if err := VerifyOff(ctx, cfg, true, func(context.Context) error { t.Error("action precondition after transport failure"); return nil }); err == nil {
+				t.Fatal("transport failure accepted")
+			}
+			if requests.Load() != 0 {
+				t.Fatal("transport failure sent BMC request")
+			}
+		})
+	}
+}
+
+func TestReleaseCheckNeverResets(t *testing.T) {
+	var resets atomic.Int32
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			resets.Add(1)
+		}
+		_ = json.NewEncoder(w).Encode(map[string]string{"UUID": testUUID, "PowerState": "On"})
+	}))
+	defer server.Close()
+	cfg := Config{Endpoint: server.URL, SystemURI: testURI, SystemUUID: testUUID, CA: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), Timeout: time.Second}
+	if err := VerifyOff(context.Background(), cfg, false, nil); err == nil {
+		t.Fatal("release accepted On")
+	}
+	if resets.Load() != 0 {
+		t.Fatal("release check issued reset")
+	}
+}
