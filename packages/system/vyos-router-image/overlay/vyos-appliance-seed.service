[Unit]
Description=Seed VyOS configuration from the NoCloud disk
Documentation=file:///usr/local/sbin/vyos-appliance-seed.sh
# Ordering is the whole contract: vyos-router reads
# /opt/vyatta/etc/config/config.boot when it starts, so the file has to be in
# place before it does. udev must have settled first or blkid cannot see the
# seed disk yet.
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=vyos-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/vyos-appliance-seed.sh

[Install]
WantedBy=vyos.target
