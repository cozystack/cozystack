+		"kind":       "VirtualMachineInstanceMigration",
+		"metadata": map[string]interface{}{
+			"generateName": m.vmiInstance.Name + "-migration-",
+			"namespace":    m.vmiInstance.Namespace,
+		},
+		"spec": map[string]interface{}{
+			"vmiName": m.vmiInstance.Name,
+		},
+	}}
