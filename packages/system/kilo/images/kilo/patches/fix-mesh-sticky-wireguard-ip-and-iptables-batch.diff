+				}
+			}
+			if !exists {
+				f.storage = append(f.storage, c)
+			}
+			continue
+		}
+		tokens := splitRestoreArgs(line)
+		if len(tokens) < 2 {
+			continue
+		}
+		switch tokens[0] {
+		case "-A":
+			f.storage = append(f.storage, &rule{table: table, chain: tokens[1], spec: tokens[2:]})
