+		if line == "" || strings.HasPrefix(line, "#") || line == "COMMIT" {
+			continue
+		}
+		if strings.HasPrefix(line, "*") {
+			table = line[1:]
+			continue
+		}
+		if strings.HasPrefix(line, ":") {
+			fields := strings.Fields(line[1:])
+			if len(fields) == 0 {
+				continue
+			}
+			chName := fields[0]
