+package helper
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/go-logr/logr"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	keycloakApi "github.com/epam/edp-keycloak-operator/api/v1"
+	keycloakAlpha "github.com/epam/edp-keycloak-operator/api/v1alpha1"
+)
+
+// newGrantServer answers the master token endpoint only for the expected
+// form, as Keycloak does, so a client that sends the wrong grant fails.
+func newGrantServer(t *testing.T, want map[string]string) *httptest.Server {
+	t.Helper()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/realms/master/protocol/openid-connect/token" || r.ParseForm() != nil {
+			http.NotFound(w, r)
+			return
+		}
+
+		for key, value := range want {
+			if r.PostForm.Get(key) != value {
+				w.WriteHeader(http.StatusUnauthorized)
+				_, _ = w.Write([]byte(`{"error":"unauthorized_client"}`))
+
+				return
+			}
+		}
+
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]string{
+			"access_token": "test-access-token",
+			"token_type":   "Bearer",
+		})
+	}))
+
+	t.Cleanup(server.Close)
+
+	return server
+}
+
+func TestHelper_CreateKeycloakClientV2FromClusterKeycloak_AdminType(t *testing.T) {
+	s := runtime.NewScheme()
+	require.NoError(t, keycloakAlpha.AddToScheme(s))
+	require.NoError(t, corev1.AddToScheme(s))
+
+	credentials := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{Name: "keycloak-secret", Namespace: "default"},
+		Data: map[string][]byte{
+			"username": []byte("operator-client"),
+			"password": []byte("operator-client-secret"),
+		},
+	}
+
+	tests := []struct {
+		name      string
+		adminType string
+		want      map[string]string
+		wantErr   require.ErrorAssertionFunc
+	}{
+		{
+			name:      "service account signs in with the client credentials grant",
+			adminType: keycloakApi.KeycloakAdminTypeServiceAccount,
+			want: map[string]string{
+				"grant_type":    "client_credentials",
+				"client_id":     "operator-client",
+				"client_secret": "operator-client-secret",
+			},
+			wantErr: require.NoError,
+		},
+		{
+			name:      "user signs in with the password grant through admin-cli",
+			adminType: keycloakApi.KeycloakAdminTypeUser,
+			want: map[string]string{
+				"grant_type": "password",
+				"client_id":  "admin-cli",
+				"username":   "operator-client",
+				"password":   "operator-client-secret",
+			},
+			wantErr: require.NoError,
+		},
+		{
+			name:      "an empty admin type keeps the password grant",
+			adminType: "",
+			want: map[string]string{
+				"grant_type": "password",
+				"client_id":  "admin-cli",
+			},
+			wantErr: require.NoError,
+		},
+		{
+			name:      "service account never falls back to the password grant",
+			adminType: keycloakApi.KeycloakAdminTypeServiceAccount,
+			want: map[string]string{
+				"grant_type": "password",
+			},
+			wantErr: require.Error,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := newGrantServer(t, tt.want)
+
+			h := &Helper{
+				client:            fake.NewClientBuilder().WithScheme(s).WithObjects(credentials.DeepCopy()).Build(),
+				operatorNamespace: "default",
+			}
+
+			kc := &keycloakAlpha.ClusterKeycloak{
+				ObjectMeta: metav1.ObjectMeta{Name: "test-cluster-keycloak"},
+				Spec: keycloakAlpha.ClusterKeycloakSpec{
+					Url:       server.URL,
+					Secret:    "keycloak-secret",
+					AdminType: tt.adminType,
+				},
+			}
+
+			ctx := ctrl.LoggerInto(context.Background(), logr.Discard())
+			kcClient, err := h.CreateKeycloakClientV2FromClusterKeycloak(ctx, kc)
+
+			tt.wantErr(t, err)
+
+			if err == nil {
+				require.NotNil(t, kcClient)
+			}
+		})
+	}
+}
