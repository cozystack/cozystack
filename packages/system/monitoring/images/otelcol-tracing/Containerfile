FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS builder

ARG VERSION=0.136.0
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY

# git lets the GOPROXY fallback to direct fetching work when the proxy fails.
RUN apk add --no-cache git

# The builder runs on the build platform; only the collector it compiles
# targets the image platform.
RUN go install go.opentelemetry.io/collector/cmd/builder@v${VERSION}

WORKDIR /build
COPY builder-config.yaml .
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH CGO_ENABLED=0 builder --config builder-config.yaml

FROM scratch

COPY --from=builder /build/dist/otelcol-tracing /otelcol-tracing
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# The collector Deployment runs as 10001, the user of the upstream image.
USER 10001:10001
ENTRYPOINT ["/otelcol-tracing"]
