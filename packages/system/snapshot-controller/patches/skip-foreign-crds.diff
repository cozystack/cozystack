diff --git a/templates/crds.yaml b/templates/crds.yaml
index f868380e4..6add1b616 100644
--- a/templates/crds.yaml
+++ b/templates/crds.yaml
@@ -62,5 +62,22 @@ data:
 {{- if $ca }}
 {{- $clientConfig = set $clientConfig "caBundle" $ca }}
 {{- end }}
-{{ tpl (.Files.Get "crds.yaml") (dict "ClientConfig" $clientConfig "InsertCaFrom" $insertCaFrom "WebhookEnabled" .Values.webhook.enabled "KeepCRDs" .Values.keepCRDs) }}
+{{- $crds := tpl (.Files.Get "crds.yaml") (dict "ClientConfig" $clientConfig "InsertCaFrom" $insertCaFrom "WebhookEnabled" .Values.webhook.enabled "KeepCRDs" .Values.keepCRDs) }}
+{{- /* cozystack: a CRD is rendered only when it is absent or already belongs
+       to this release. A CRD the distribution ships, or that another release
+       owns, stays out of the manifest, so the upgrade neither takes it over nor
+       rewrites it. */}}
+{{- range $crd := regexSplit "(?m)^---$" $crds -1 }}
+{{- $obj := fromYaml $crd }}
+{{- if hasKey $obj "Error" }}
+{{- fail (printf "snapshot-controller: cannot parse a CRD from crds.yaml: %s" $obj.Error) }}
+{{- end }}
+{{- if $obj.metadata }}
+{{- $live := lookup "apiextensions.k8s.io/v1" "CustomResourceDefinition" "" $obj.metadata.name }}
+{{- if or (not $live) (and (eq (dig "metadata" "annotations" "meta.helm.sh/release-name" "" $live) $.Release.Name) (eq (dig "metadata" "annotations" "meta.helm.sh/release-namespace" "" $live) $.Release.Namespace)) }}
+---
+{{ trim $crd }}
+{{- end }}
+{{- end }}
+{{- end }}
 {{- end }}
