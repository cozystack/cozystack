+func newTestListener(t *testing.T, driver cosi.ProvisionerClient, objects ...runtime.Object) (*BucketListener, *fakebucketclientset.Clientset) {
+	t.Helper()
+
+	client := fakebucketclientset.NewSimpleClientset(objects...)
+	listener := NewBucketListener("driver1", driver)
+	listener.InitializeKubeClient(fakekubeclientset.NewSimpleClientset())
+	listener.InitializeBucketClient(client)
+	listener.InitializeEventRecorder(record.NewFakeRecorder(10))
+
+	return listener, client
+}
