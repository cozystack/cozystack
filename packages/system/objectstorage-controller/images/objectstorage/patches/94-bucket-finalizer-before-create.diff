+func newTestBucket() *v1alpha1.Bucket {
+	return &v1alpha1.Bucket{
+		ObjectMeta: metav1.ObjectMeta{Name: "testbucket"},
+		Spec: v1alpha1.BucketSpec{
+			DriverName:      "driver1",
+			BucketClassName: "class",
+			DeletionPolicy:  v1alpha1.DeletionPolicyDelete,
+		},
+	}
