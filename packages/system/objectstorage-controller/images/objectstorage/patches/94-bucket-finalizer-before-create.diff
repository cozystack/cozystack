+// TestDeleteWithoutIDSkipsDriver checks that a Bucket no bucket was ever
+// created for is released without calling DriverDeleteBucket.
+func TestDeleteWithoutIDSkipsDriver(t *testing.T) {
+	driver := struct{ fakespec.FakeProvisionerClient }{}
+	driver.FakeDriverDeleteBucket = func(context.Context, *cosi.DriverDeleteBucketRequest, ...grpc.CallOption) (*cosi.DriverDeleteBucketResponse, error) {
+		t.Fatalf("DriverDeleteBucket called without a bucket ID")
+		return nil, nil
+	}
+
+	bucket := newTestBucket()
+	now := metav1.Now()
+	bucket.DeletionTimestamp = &now
+	bucket.Finalizers = []string{consts.BucketFinalizer}
+
+	listener, client := newTestListener(t, &driver, bucket)
+
+	if err := listener.Update(context.TODO(), bucket, bucket); err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+
+	live, err := client.ObjectstorageV1alpha1().Buckets().Get(context.TODO(), bucket.Name, metav1.GetOptions{})
+	if err == nil && controllerutil.ContainsFinalizer(live, consts.BucketFinalizer) {
+		t.Fatalf("finalizer still present: %v", live.Finalizers)
+	}
