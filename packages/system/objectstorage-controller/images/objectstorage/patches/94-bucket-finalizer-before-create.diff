+// TestAddPutsFinalizerBeforeCreate checks that the driver is only asked to
+// create a bucket once the Bucket carries the finalizer, so that deleting the
+// Bucket always reaches DriverDeleteBucket.
+func TestAddPutsFinalizerBeforeCreate(t *testing.T) {
+	var client *fakebucketclientset.Clientset
+
+	driver := struct{ fakespec.FakeProvisionerClient }{}
+	driver.FakeDriverCreateBucket = func(ctx context.Context, req *cosi.DriverCreateBucketRequest, _ ...grpc.CallOption) (*cosi.DriverCreateBucketResponse, error) {
+		live, err := client.ObjectstorageV1alpha1().Buckets().Get(ctx, req.GetName(), metav1.GetOptions{})
+		if err != nil {
+			t.Fatalf("getting bucket: %v", err)
+		}
+		if !controllerutil.ContainsFinalizer(live, consts.BucketFinalizer) {
+			t.Fatalf("DriverCreateBucket called before the finalizer was stored")
+		}
+		return &cosi.DriverCreateBucketResponse{BucketId: "id-1"}, nil
+	}
+
+	bucket := newTestBucket()
+	listener, c := newTestListener(t, &driver, bucket)
+	client = c
+
+	if err := listener.Add(context.TODO(), bucket); err != nil {
+		t.Fatalf("Add: %v", err)
+	}
+
+	live, _ := client.ObjectstorageV1alpha1().Buckets().Get(context.TODO(), bucket.Name, metav1.GetOptions{})
+	if live.Status.BucketID != "id-1" || !live.Status.BucketReady {
+		t.Fatalf("status = %+v, want id-1 and ready", live.Status)
+	}
+}
