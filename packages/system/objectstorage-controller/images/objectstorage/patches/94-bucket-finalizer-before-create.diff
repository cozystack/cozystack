+// errBucketDeleting stops an update to a Bucket that is already being
+// deleted: new finalizers cannot be added to it, and its deletion is handled
+// by Update.
+var errBucketDeleting = errors.New("bucket is being deleted")
+
+// updateBucket applies mutate to the live Bucket and writes it back if mutate
+// reports a change, retrying on conflict. It returns the Bucket as stored.
+func (b *BucketListener) updateBucket(ctx context.Context, name string, mutate func(*v1alpha1.Bucket) bool) (*v1alpha1.Bucket, error) {
+	var result *v1alpha1.Bucket
+
+	err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latest, err := b.buckets().Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return err
+		}
+		if !latest.GetDeletionTimestamp().IsZero() {
+			return errBucketDeleting
+		}
+		if !mutate(latest) {
+			result = latest
+			return nil
+		}
+		result, err = b.buckets().Update(ctx, latest, metav1.UpdateOptions{})
+		return err
+	})
+
+	return result, err
+}
