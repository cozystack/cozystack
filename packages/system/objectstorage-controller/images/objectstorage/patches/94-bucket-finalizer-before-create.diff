+// TestAddRetriesConflicts checks that a conflicting write to the Bucket does
+// not leave a created bucket without its finalizer or its recorded ID.
+func TestAddRetriesConflicts(t *testing.T) {
+	driver := struct{ fakespec.FakeProvisionerClient }{}
+	driver.FakeDriverCreateBucket = func(context.Context, *cosi.DriverCreateBucketRequest, ...grpc.CallOption) (*cosi.DriverCreateBucketResponse, error) {
+		return &cosi.DriverCreateBucketResponse{BucketId: "id-2"}, nil
+	}
+
+	bucket := newTestBucket()
+	listener, client := newTestListener(t, &driver, bucket)
+
+	conflicts := map[string]int{"update": 1, "update/status": 1}
+	client.PrependReactor("update", "buckets", func(action k8stesting.Action) (bool, runtime.Object, error) {
+		key := "update"
+		if action.GetSubresource() == "status" {
+			key = "update/status"
+		}
+		if conflicts[key] > 0 {
+			conflicts[key]--
+			return true, nil, kubeerrors.NewConflict(v1alpha1.Resource("buckets"), bucket.Name, errors.New("modified"))
+		}
+		return false, nil, nil
+	})
+
+	if err := listener.Add(context.TODO(), bucket); err != nil {
+		t.Fatalf("Add: %v", err)
+	}
+
+	live, _ := client.ObjectstorageV1alpha1().Buckets().Get(context.TODO(), bucket.Name, metav1.GetOptions{})
+	if !controllerutil.ContainsFinalizer(live, consts.BucketFinalizer) || live.Status.BucketID != "id-2" {
+		t.Fatalf("finalizers = %v, status = %+v", live.Finalizers, live.Status)
+	}
+}
