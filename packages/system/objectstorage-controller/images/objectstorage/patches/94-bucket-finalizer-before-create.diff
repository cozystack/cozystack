+// TestAddSkipsBucketBeingDeleted checks that a Bucket whose deletion started
+// after the informer saw it is not created in the object storage.
+func TestAddSkipsBucketBeingDeleted(t *testing.T) {
+	driver := struct{ fakespec.FakeProvisionerClient }{}
+	driver.FakeDriverCreateBucket = func(context.Context, *cosi.DriverCreateBucketRequest, ...grpc.CallOption) (*cosi.DriverCreateBucketResponse, error) {
+		t.Fatalf("DriverCreateBucket called for a Bucket being deleted")
+		return nil, nil
+	}
+
+	stored := newTestBucket()
+	now := metav1.Now()
+	stored.DeletionTimestamp = &now
+	stored.Finalizers = []string{"other"}
+
+	listener, _ := newTestListener(t, &driver, stored)
+
+	if err := listener.Add(context.TODO(), newTestBucket()); err != nil {
+		t.Fatalf("Add: %v", err)
+	}
+}
