index 1eea65d14..4e59d41f4 100644
--- a/charts/keda/templates/webhooks/ciliumnetworkpolicy.yaml
+++ b/charts/keda/templates/webhooks/ciliumnetworkpolicy.yaml
@@ -1,4 +1,4 @@
-{{- if and .Values.webhooks.enabled .Values.networkPolicy.enabled (eq .Values.networkPolicy.flavor "cilium") }}
+{{- if and .Values.webhooks.enabled .Values.networkPolicy.enabled (eq .Values.networkPolicy.flavor "cilium") (.Capabilities.APIVersions.Has "cilium.io/v2") }}
 apiVersion: "cilium.io/v2"
