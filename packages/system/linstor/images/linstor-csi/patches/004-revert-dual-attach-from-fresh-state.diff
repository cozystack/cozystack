+
+// revertDualAttach undoes what Attach set up for a live migration once at
+// most one node is left Primary, including when none is (the VM stopped
+// halfway through). The external-attacher never calls Detach again after it
+// returns nil, so a revert skipped here is lost for good. That is why the
+// attachment state is read past the client-side resource cache: the cache
+// is shared by every volume, lives for --resource-cache-timeout and is
+// routinely filled while both ends of the migration were still Primary.
+func (s *Linstor) revertDualAttach(ctx context.Context, volId, node string, log *logrus.Entry) error {
+	ress, err := s.currentResources().GetAll(ctx, volId)
+	if err != nil {
+		return nil404(err)
+	}
 
-		// Drop the Protocol=C override only if Attach installed it (gated by
-		// our marker), so an operator-set Protocol property on the
-		// resource-definition is preserved.
-		rd, getErr := s.client.ResourceDefinitions.Get(ctx, volId)
-		if getErr != nil {
