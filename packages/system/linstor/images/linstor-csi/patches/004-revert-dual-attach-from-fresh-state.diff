diff --git a/pkg/client/dual_attach_test.go b/pkg/client/dual_attach_test.go
new file mode 100644
index 0000000..3fb1de0
--- /dev/null
+++ b/pkg/client/dual_attach_test.go
@@ -0,0 +1,353 @@
+package client
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	lapicache "github.com/LINBIT/golinstor/cache"
+	lapi "github.com/LINBIT/golinstor/client"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/piraeusdatastore/linstor-csi/pkg/linstor"
+	lc "github.com/piraeusdatastore/linstor-csi/pkg/linstor/highlevelclient"
+)
+
+const (
+	dualVol  = "pvc-dual"
+	dualRG   = "rg-async"
+	nodeSrc  = "node-a"
+	nodeDst  = "node-b"
+	otherVol = "pvc-other"
+)
+
+// fakeController serves the part of the LINSTOR REST API that Attach,
+// Detach and Clone use, keeping props and the InUse state of each resource
+// so a test can move a volume through a live migration.
+type fakeController struct {
+	t  *testing.T
+	mu sync.Mutex
+
+	rdProps map[string]map[string]string
+	rdGroup map[string]string
+	rgProps map[string]map[string]string
+	inUse   map[string]map[string]bool
+
+	// refusedAdjusts records every definition change DRBD would refuse:
+	// dropping two-primaries while two peers are Primary.
+	refusedAdjusts []string
+	rdWrites       int
+}
+
+func newFakeController(t *testing.T) *fakeController {
+	return &fakeController{
+		t:       t,
+		rdProps: map[string]map[string]string{dualVol: {}, otherVol: {}},
+		rdGroup: map[string]string{dualVol: dualRG, otherVol: dualRG},
+		rgProps: map[string]map[string]string{dualRG: {linstor.PropertyDrbdNetProtocol: "A"}},
+		inUse: map[string]map[string]bool{
+			dualVol:  {nodeSrc: true, nodeDst: false},
+			otherVol: {nodeSrc: false, nodeDst: false},
+		},
+	}
+}
+
+func (f *fakeController) setInUse(rd, node string, inUse bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.inUse[rd][node] = inUse
+}
+
+func (f *fakeController) props(rd string) map[string]string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := map[string]string{}
+	for k, v := range f.rdProps[rd] {
+		out[k] = v
+	}
+	return out
+}
+
+func (f *fakeController) resources(rd string) []lapi.ResourceWithVolumes {
+	var out []lapi.ResourceWithVolumes
+	nodes := make([]string, 0, len(f.inUse[rd]))
+	for n := range f.inUse[rd] {
+		nodes = append(nodes, n)
+	}
+	slices.Sort(nodes)
+	for _, n := range nodes {
+		inUse := f.inUse[rd][n]
+		out = append(out, lapi.ResourceWithVolumes{
+			Resource: lapi.Resource{Name: rd, NodeName: n, State: &lapi.ResourceState{InUse: &inUse}},
+			Volumes:  []lapi.Volume{{VolumeNumber: 0, DevicePath: "/dev/drbd1000", ProviderKind: lapi.LVM_THIN}},
+		})
+	}
+	return out
+}
+
+func (f *fakeController) writeJSON(w http.ResponseWriter, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func (f *fakeController) ok(w http.ResponseWriter) {
+	f.writeJSON(w, []lapi.ApiCallRc{{RetCode: 0, Message: "ok"}})
+}
+
+func (f *fakeController) notFound(w http.ResponseWriter) {
+	w.WriteHeader(http.StatusNotFound)
+	f.writeJSON(w, []lapi.ApiCallRc{{RetCode: -4611686018427387904, Message: "not found"}})
+}
+
+func (f *fakeController) handler() http.Handler {
+	return f.handlerWith(nil)
+}
+
+func (f *fakeController) handlerWith(extra func(*http.ServeMux)) http.Handler {
+	mux := http.NewServeMux()
+	if extra != nil {
+		extra(mux)
+	}
+
+	mux.HandleFunc("GET /v1/view/resources", func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		var out []lapi.ResourceWithVolumes
+		rds := make([]string, 0, len(f.inUse))
+		for rd := range f.inUse {
+			rds = append(rds, rd)
+		}
+		slices.Sort(rds)
+		for _, rd := range rds {
+			out = append(out, f.resources(rd)...)
+		}
+		f.writeJSON(w, out)
+	})
+
+	mux.HandleFunc("GET /v1/resource-definitions/{rd}/resources", func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		var out []lapi.Resource
+		for _, res := range f.resources(r.PathValue("rd")) {
+			out = append(out, res.Resource)
+		}
+		f.writeJSON(w, out)
+	})
+
+	mux.HandleFunc("POST /v1/resource-definitions/{rd}/resources/{node}/make-available", func(w http.ResponseWriter, r *http.Request) {
+		f.ok(w)
+	})
+
+	mux.HandleFunc("GET /v1/resource-definitions/{rd}", func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		rd := r.PathValue("rd")
+		props, ok := f.rdProps[rd]
+		if !ok {
+			f.notFound(w)
+			return
+		}
+		f.writeJSON(w, lapi.ResourceDefinition{Name: rd, ResourceGroupName: f.rdGroup[rd], Props: props})
+	})
+
+	mux.HandleFunc("PUT /v1/resource-definitions/{rd}", func(w http.ResponseWriter, r *http.Request) {
+		var mod lapi.GenericPropsModify
+		if err := json.NewDecoder(r.Body).Decode(&mod); err != nil {
+			f.t.Errorf("decode RD modify: %v", err)
+		}
+
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		rd := r.PathValue("rd")
+		f.rdWrites++
+
+		primaries := 0
+		for _, inUse := range f.inUse[rd] {
+			if inUse {
+				primaries++
+			}
+		}
+		if primaries > 1 && slices.Contains(mod.DeleteProps, linstor.PropertyAllowTwoPrimaries) {
+			f.refusedAdjusts = append(f.refusedAdjusts, rd)
+		}
+
+		for _, k := range mod.DeleteProps {
+			delete(f.rdProps[rd], k)
+		}
+		for k, v := range mod.OverrideProps {
+			f.rdProps[rd][k] = v
+		}
+		f.ok(w)
+	})
+
+	mux.HandleFunc("GET /v1/resource-groups/{rg}", func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		rg := r.PathValue("rg")
+		f.writeJSON(w, lapi.ResourceGroup{Name: rg, Props: f.rgProps[rg]})
+	})
+
+	mux.HandleFunc("PUT /v1/resource-groups/{rg}", func(w http.ResponseWriter, r *http.Request) {
+		f.ok(w)
+	})
+
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		f.t.Errorf("unexpected request: %s %s", r.Method, r.URL)
+		f.notFound(w)
+	})
+
+	return mux
+}
+
+// newDualAttachLinstor builds the client the way main does: the regular
+// provider sits behind the resource cache, FreshResources does not.
+func newDualAttachLinstor(t *testing.T, f *fakeController) *Linstor {
+	return newDualAttachLinstorWith(t, f, nil)
+}
+
+func newDualAttachLinstorWith(t *testing.T, f *fakeController, extra func(*http.ServeMux)) *Linstor {
+	srv := httptest.NewServer(f.handlerWith(extra))
+	t.Cleanup(srv.Close)
+
+	u, err := url.Parse(srv.URL)
+	require.NoError(t, err)
+
+	cached, err := lc.NewHighLevelClient(
+		lapi.BaseURL(u),
+		lapicache.WithCaches(&lapicache.ResourceCache{Timeout: time.Hour}),
+	)
+	require.NoError(t, err)
+
+	fresh, err := lc.NewHighLevelClient(lapi.BaseURL(u))
+	require.NoError(t, err)
+
+	return &Linstor{
+		client:         cached,
+		freshResources: fresh.Resources,
+		log:            logrus.WithField("test", t.Name()),
+	}
+}
+
+func dualAttachOverride() map[string]string {
+	return map[string]string{
+		linstor.PropertyAllowTwoPrimaries:   "yes",
+		linstor.PropertyDrbdNetProtocol:     "C",
+		linstor.PropertyCsiProtocolOverride: "yes",
+	}
+}
+
+// migrate runs the CSI side of a live migration up to the point where both
+// ends are Primary and the shared resource cache holds that state, which is
+// what the attach of an unrelated volume a few seconds later leaves behind.
+func migrate(t *testing.T, f *fakeController, l *Linstor) {
+	ctx := context.Background()
+
+	_, err := l.Attach(ctx, dualVol, nodeDst, true)
+	require.NoError(t, err)
+	require.Equal(t, dualAttachOverride(), f.props(dualVol), "attach installs the dual-attach override")
+
+	f.setInUse(dualVol, nodeDst, true)
+
+	require.NoError(t, l.client.Resources.MakeAvailable(ctx, otherVol, nodeDst, lapi.ResourceMakeAvailable{}))
+	_, err = l.client.Resources.GetAll(ctx, otherVol)
+	require.NoError(t, err)
+}
+
+func TestDetach_RevertsDualAttachPastStaleCache(t *testing.T) {
+	f := newFakeController(t)
+	l := newDualAttachLinstor(t, f)
+	migrate(t, f, l)
+
+	// The source lets go; the cache still says it is Primary.
+	f.setInUse(dualVol, nodeSrc, false)
+
+	cached, err := l.client.Resources.GetAll(context.Background(), dualVol)
+	require.NoError(t, err)
+	for _, res := range cached {
+		require.True(t, *res.State.InUse, "precondition: the cache still shows %s Primary", res.NodeName)
+	}
+
+	require.NoError(t, l.Detach(context.Background(), dualVol, nodeSrc))
+
+	assert.Empty(t, f.props(dualVol), "the definition is back to its pre-migration options")
+	assert.Empty(t, f.refusedAdjusts)
+}
+
+func TestDetach_RetriesWhileSourceStillPrimary(t *testing.T) {
+	f := newFakeController(t)
+	l := newDualAttachLinstor(t, f)
+	migrate(t, f, l)
+
+	err := l.Detach(context.Background(), dualVol, nodeSrc)
+	require.Error(t, err, "a detach that cannot revert yet must fail so the external-attacher retries")
+	assert.Equal(t, dualAttachOverride(), f.props(dualVol))
+	assert.Empty(t, f.refusedAdjusts, "two-primaries is not dropped under two Primaries")
+
+	f.setInUse(dualVol, nodeSrc, false)
+
+	require.NoError(t, l.Detach(context.Background(), dualVol, nodeSrc))
+	assert.Empty(t, f.props(dualVol))
+	assert.Empty(t, f.refusedAdjusts)
+}
+
+func TestDetach_RevertsWhenNoPrimaryIsLeft(t *testing.T) {
+	f := newFakeController(t)
+	l := newDualAttachLinstor(t, f)
+	migrate(t, f, l)
+
+	// The VM stopped halfway through the migration.
+	f.setInUse(dualVol, nodeSrc, false)
+	f.setInUse(dualVol, nodeDst, false)
+
+	require.NoError(t, l.Detach(context.Background(), dualVol, nodeSrc))
+	assert.Empty(t, f.props(dualVol))
+}
+
+func TestDetach_KeepsUnmarkedProtocol(t *testing.T) {
+	f := newFakeController(t)
+	l := newDualAttachLinstor(t, f)
+	f.rdProps[dualVol] = map[string]string{
+		linstor.PropertyAllowTwoPrimaries: "yes",
+		linstor.PropertyDrbdNetProtocol:   "C",
+	}
+
+	require.NoError(t, l.Detach(context.Background(), dualVol, nodeDst))
+	assert.Equal(t, map[string]string{linstor.PropertyDrbdNetProtocol: "C"}, f.props(dualVol),
+		"a protocol without the marker was not set by Attach and stays")
+}
+
+func TestDetach_WritesNothingWithoutDualAttachProps(t *testing.T) {
+	f := newFakeController(t)
+	l := newDualAttachLinstor(t, f)
+
+	require.NoError(t, l.Detach(context.Background(), dualVol, nodeDst))
+	assert.Zero(t, f.rdWrites, "a plain detach does not touch the definition")
+}
+
+func TestDualAttachProps(t *testing.T) {
+	cases := []struct {
+		name  string
+		props map[string]string
+		keep  map[string]string
+		want  []string
+	}{
+		{name: "none"},
+		{name: "override", props: dualAttachOverride(), want: []string{linstor.PropertyAllowTwoPrimaries, linstor.PropertyDrbdNetProtocol, linstor.PropertyCsiProtocolOverride}},
+		{name: "unmarked protocol", props: map[string]string{linstor.PropertyAllowTwoPrimaries: "yes", linstor.PropertyDrbdNetProtocol: "C"}, want: []string{linstor.PropertyAllowTwoPrimaries}},
+		{name: "kept", props: dualAttachOverride(), keep: map[string]string{linstor.PropertyAllowTwoPrimaries: "yes"}, want: []string{linstor.PropertyDrbdNetProtocol, linstor.PropertyCsiProtocolOverride}},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, dualAttachProps(tc.props, tc.keep))
+		})
+	}
+}
