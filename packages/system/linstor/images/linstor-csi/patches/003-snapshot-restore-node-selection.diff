+// selectRestoreNode picks the node a snapshot is restored on, among the available nodes holding it.
+//
+// The restored volume is pinned to that node, so the consumer pod has to run there:
+//   - preferredNodes[0] is the node the scheduler selected for a WaitForFirstConsumer volume. If it holds the
+//     snapshot, restoring there lets the pod start without another scheduling round.
+//   - Otherwise a random node is picked, which spreads restores of the same source across its snapshot nodes.
+//     Cordoned nodes are skipped as long as another node holds the snapshot: a pod can never be scheduled on
+//     them, so a volume restored there stays unusable until the node is uncordoned.
+//
+// Only nodes that are also in preferredNodes are considered, unless none is.
+func selectRestoreNode(available, preferredNodes []string, schedulable func(node string) bool) string {
+	candidates := slices.DeleteFunc(slices.Clone(available), func(node string) bool {
+		return !slices.Contains(preferredNodes, node)
+	})
+	if len(candidates) == 0 {
+		candidates = available
+	}
+
+	if usable := slices.DeleteFunc(slices.Clone(candidates), func(node string) bool { return !schedulable(node) }); len(usable) > 0 {
+		candidates = usable
+	}
+
+	if len(candidates) == 0 {
+		return ""
+	}
+
+	if len(preferredNodes) > 0 && slices.Contains(candidates, preferredNodes[0]) {
+		return preferredNodes[0]
+	}
+
+	return candidates[rand.Intn(len(candidates))]
+}
