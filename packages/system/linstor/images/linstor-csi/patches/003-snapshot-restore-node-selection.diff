+// ConfigureKubernetesIfAvailable lets the client read Kubernetes Node objects, so that a snapshot is
+// not restored on a cordoned node when another node holds it. Outside of Kubernetes it does nothing.
+func ConfigureKubernetesIfAvailable() func(*Linstor) error {
+	return func(l *Linstor) error {
+		cl, _, err := utils.KubernetesClient()
+		if err != nil {
+			// Not running in kubernetes
+			return nil
+		}
+
+		l.nodeSchedulable = func(ctx context.Context, node string) (bool, error) {
+			n, err := cl.CoreV1().Nodes().Get(ctx, node, metav1.GetOptions{})
+			if err != nil {
+				if apierrors.IsNotFound(err) {
+					// A LINSTOR node without a Kubernetes Node: nothing says it is cordoned.
+					return true, nil
+				}
+
+				return true, err
+			}
+
+			return !n.Spec.Unschedulable, nil
+		}
+
+		return nil
+	}
+}
