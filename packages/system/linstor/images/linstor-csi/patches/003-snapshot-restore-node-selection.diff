+func TestLinstor_reconcileSnapshotResourcesSkipsCordonedNodes(t *testing.T) {
+	// A replicated volume has a snapshot on three nodes, one of them cordoned. The scheduler selected a node
+	// without the snapshot. Restoring on the cordoned node pins the new volume to a node no pod can be scheduled
+	// on, so the restore must always go to one of the other two.
+	const (
+		sourceRD = "pvc-source"
+		snapName = "snapshot-1"
+		targetRD = "pvc-target"
+		cordoned = "node-3"
+	)
+
+	snapNodes := []string{"node-1", "node-2", cordoned}
+	preferred := []string{"node-9", "node-1", "node-2", cordoned}
+
+	restoredOn := map[string]int{}
+
+	for range 50 {
+		res := mocks.ResourceProvider{}
+		res.On("GetAll", mock.Anything, targetRD).Return([]lapi.Resource{}, nil)
+		res.On("GetSnapshot", mock.Anything, sourceRD, snapName).Return(lapi.Snapshot{Name: snapName, Nodes: snapNodes}, nil)
+		res.On("RestoreSnapshot", mock.Anything, sourceRD, snapName, mock.Anything).Run(func(args mock.Arguments) {
+			restoredOn[args.Get(3).(lapi.SnapshotRestore).Nodes[0]]++
+		}).Return(nil)
+
+		nodes := mocks.NodeProvider{}
+		for _, n := range snapNodes {
+			nodes.On("Get", mock.Anything, n).Return(lapi.Node{Name: n, ConnectionStatus: "ONLINE"}, nil)
+		}
+
+		cl := Linstor{
+			client: &lc.HighLevelClient{Client: &lapi.Client{Resources: &res, Nodes: &nodes}},
+			log:    logrus.WithField("test", t.Name()),
+			nodeSchedulable: func(_ context.Context, node string) (bool, error) {
+				return node != cordoned, nil
+			},
+		}
+
+		snap := &volume.Snapshot{SnapshotId: volume.SnapshotId{SourceName: sourceRD, SnapshotName: snapName}}
+		assert.NoError(t, cl.reconcileSnapshotResources(context.Background(), snap, targetRD, preferred))
+	}
+
+	assert.Zero(t, restoredOn[cordoned], "restored on the cordoned node: %v", restoredOn)
+	assert.Equal(t, 50, restoredOn["node-1"]+restoredOn["node-2"])
+}
+
+func TestSelectRestoreNode(t *testing.T) {
+	all := func(string) bool { return true }
+	notNode3 := func(n string) bool { return n != "node-3" }
+
+	t.Run("selected node holds the snapshot", func(t *testing.T) {
+		for range 20 {
+			assert.Equal(t, "node-2", selectRestoreNode([]string{"node-1", "node-2", "node-3"}, []string{"node-2", "node-1", "node-3"}, all))
+		}
+	})
+
+	t.Run("selected node is cordoned", func(t *testing.T) {
+		for range 20 {
+			assert.NotEqual(t, "node-3", selectRestoreNode([]string{"node-1", "node-3"}, []string{"node-3", "node-1"}, notNode3))
+		}
+	})
+
+	t.Run("only cordoned nodes hold the snapshot", func(t *testing.T) {
+		assert.Equal(t, "node-3", selectRestoreNode([]string{"node-3"}, []string{"node-1", "node-3"}, notNode3))
+	})
+
+	t.Run("snapshot nodes outside the preferred nodes are a fallback", func(t *testing.T) {
+		assert.Equal(t, "node-2", selectRestoreNode([]string{"node-1", "node-2"}, []string{"node-2"}, all))
+		assert.Equal(t, "node-1", selectRestoreNode([]string{"node-1"}, []string{"node-2"}, all))
+	})
+
+	t.Run("no available node", func(t *testing.T) {
+		assert.Empty(t, selectRestoreNode(nil, []string{"node-1"}, all))
+	})
+
+	t.Run("restores are spread when the selected node lacks the snapshot", func(t *testing.T) {
+		seen := map[string]bool{}
+		for range 200 {
+			seen[selectRestoreNode([]string{"node-1", "node-2"}, []string{"node-9", "node-1", "node-2"}, all)] = true
+		}
+
+		assert.Equal(t, map[string]bool{"node-1": true, "node-2": true}, seen)
+	})
+}
