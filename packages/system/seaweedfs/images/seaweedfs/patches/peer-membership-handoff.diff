@@ -0,0 +1,184 @@
+package filer
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/seaweedfs/seaweedfs/weed/cluster"
+	"github.com/seaweedfs/seaweedfs/weed/cluster/lock_manager"
+	"github.com/seaweedfs/seaweedfs/weed/pb"
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"github.com/seaweedfs/seaweedfs/weed/pb/master_pb"
+	"github.com/seaweedfs/seaweedfs/weed/wdclient"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+type discoveryGapMaster struct {
+	master_pb.UnimplementedSeaweedServer
+	self            pb.ServerAddress
+	peer            pb.ServerAddress
+	announce        chan struct{}
+	snapshotHasPeer bool
+	events          []bool
+	delayInitial    bool
+}
+
+func (s *discoveryGapMaster) KeepConnected(stream master_pb.Seaweed_KeepConnectedServer) error {
+	if _, err := stream.Recv(); err != nil {
+		return err
+	}
+	if err := stream.Send(&master_pb.KeepConnectedResponse{VolumeLocation: &master_pb.VolumeLocation{Leader: string(s.self)}}); err != nil {
+		return err
+	}
+	initial := []pb.ServerAddress{s.self}
+	if s.snapshotHasPeer && !s.delayInitial {
+		initial = append(initial, s.peer)
+	}
+	for _, address := range initial {
+		if err := stream.Send(&master_pb.KeepConnectedResponse{ClusterNodeUpdate: &master_pb.ClusterNodeUpdate{NodeType: cluster.FilerType, Address: string(address), IsAdd: true}}); err != nil {
+			return err
+		}
+	}
+	select {
+	case <-s.announce:
+	case <-stream.Context().Done():
+		return stream.Context().Err()
+	}
+	for _, add := range s.events {
+		if err := stream.Send(&master_pb.KeepConnectedResponse{ClusterNodeUpdate: &master_pb.ClusterNodeUpdate{NodeType: cluster.FilerType, Address: string(s.peer), IsAdd: add}}); err != nil {
+			return err
+		}
+	}
+	if err := stream.Send(&master_pb.KeepConnectedResponse{LockRingUpdate: &master_pb.LockRingUpdate{Version: 1}}); err != nil {
+		return err
+	}
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
+
+func (s *discoveryGapMaster) ListClusterNodes(context.Context, *master_pb.ListClusterNodesRequest) (*master_pb.ListClusterNodesResponse, error) {
+	nodes := []*master_pb.ListClusterNodesResponse_ClusterNode{{Address: string(s.self)}}
+	if s.snapshotHasPeer {
+		nodes = append(nodes, &master_pb.ListClusterNodesResponse_ClusterNode{Address: string(s.peer)})
+	}
+	return &master_pb.ListClusterNodesResponse{ClusterNodes: nodes}, nil
+}
+
+type discoveryGapFiler struct {
+	filer_pb.UnimplementedSeaweedFilerServer
+	subscriptions chan int64
+}
+
+func (*discoveryGapFiler) GetFilerConfiguration(context.Context, *filer_pb.GetFilerConfigurationRequest) (*filer_pb.GetFilerConfigurationResponse, error) {
+	return &filer_pb.GetFilerConfigurationResponse{Signature: 41}, nil
+}
+func (s *discoveryGapFiler) SubscribeLocalMetadata(req *filer_pb.SubscribeMetadataRequest, stream filer_pb.SeaweedFiler_SubscribeLocalMetadataServer) error {
+	s.subscriptions <- req.SinceNs
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
+
+func TestPeerDiscoveryAcrossAggregatorInitialization(t *testing.T) {
+	cases := []struct {
+		name            string
+		before          bool
+		snapshotHasPeer bool
+		events          []bool
+		wantPeer        bool
+		cursor          bool
+	}{
+		{"pre_init_add", true, false, []bool{true}, true, false},
+		{"pre_init_remove", true, true, []bool{false}, false, false},
+		{"pre_init_add_remove", true, false, []bool{true, false}, false, false},
+		{"pre_init_remove_add", true, true, []bool{false, true}, true, false},
+		{"post_init_add", false, false, []bool{true}, true, false},
+		{"post_init_remove", false, true, []bool{false}, false, false},
+		{"delayed_initial_add_replay_cursor", false, true, []bool{true}, true, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, port, err := net.SplitHostPort(listener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			self := pb.ServerAddress("127.0.0.1:0." + port)
+			peer := pb.ServerAddress("localhost:0." + port)
+			master := &discoveryGapMaster{self: self, peer: peer, announce: make(chan struct{}), snapshotHasPeer: tc.snapshotHasPeer, events: tc.events, delayInitial: tc.cursor}
+			server := grpc.NewServer()
+			master_pb.RegisterSeaweedServer(server, master)
+			subscriptions := make(chan int64, 16)
+			filer_pb.RegisterSeaweedFilerServer(server, &discoveryGapFiler{subscriptions: subscriptions})
+			go server.Serve(listener)
+			defer server.Stop()
+			dial := grpc.WithTransportCredentials(insecure.NewCredentials())
+			mc := wdclient.NewMasterClient(dial, "", cluster.FilerType, self, "", "", *pb.NewServiceDiscoveryFromMap(map[string]pb.ServerAddress{"master": self}))
+			go mc.KeepConnectedToMaster(ctx)
+			f := &Filer{MasterClient: mc, GrpcDialOption: dial, Signature: 41, Dlm: lock_manager.NewDistributedLockManager(self)}
+			snapshot := f.ListExistingPeerUpdates(ctx)
+			wantSize := 1
+			if tc.snapshotHasPeer {
+				wantSize++
+			}
+			if len(snapshot) != wantSize {
+				t.Fatalf("snapshot = %v, want %d nodes", snapshot, wantSize)
+			}
+			if mc.OnPeerUpdate != nil {
+				t.Fatal("unexpected peer callback before initialization")
+			}
+			dispatched := make(chan struct{})
+			barrier := func(*master_pb.LockRingUpdate) { close(dispatched) }
+			await := func() {
+				select {
+				case <-dispatched:
+				case <-ctx.Done():
+					t.Fatal("master dispatch barrier not reached")
+				}
+			}
+			if tc.before {
+				mc.SetOnLockRingUpdateFn(barrier)
+				close(master.announce)
+				await()
+				t.Log("membership events passed through real MasterClient dispatch while OnPeerUpdate was nil")
+			}
+			replayFrom := time.Now().Add(-time.Minute)
+			f.AggregateFromPeers(self, snapshot, replayFrom)
+			defer func() {
+				f.MetaAggregator.OnPeerUpdate(&master_pb.ClusterNodeUpdate{Address: string(self)}, time.Now())
+				f.MetaAggregator.OnPeerUpdate(&master_pb.ClusterNodeUpdate{Address: string(peer)}, time.Now())
+				f.MetaAggregator.MetaLogBuffer.ShutdownLogBuffer()
+			}()
+			if mc.OnPeerUpdate == nil {
+				t.Fatal("initialization did not install callback")
+			}
+			if !tc.before {
+				mc.SetOnLockRingUpdateFn(barrier)
+				close(master.announce)
+				await()
+			}
+			if tc.cursor {
+				for range 2 {
+					select {
+					case since := <-subscriptions:
+						if since > replayFrom.UnixNano() {
+							t.Errorf("initial peer replay starts at %d, after bootstrap overlap %d", since, replayFrom.UnixNano())
+						}
+					case <-ctx.Done():
+						t.Fatal("metadata subscription not started")
+					}
+				}
+			}
+			if got := f.MetaAggregator.HasRemotePeers(); got != tc.wantPeer {
+				t.Fatalf("remote peer membership = %t, want %t after events %v", got, tc.wantPeer, tc.events)
+			}
+		})
+	}
+}
