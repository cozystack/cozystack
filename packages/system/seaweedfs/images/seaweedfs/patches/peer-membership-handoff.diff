+func TestPeerUpdateHandoffReconnectDropsPeersAbsentFromNewStream(t *testing.T) {
+	server := &peerReconnectMaster{streams: [][]string{{"peer-a:8888"}, {"peer-b:8888"}}}
+	server.address = startFakeMasterServer(t, server)
+	mc := NewMasterClient(grpc.WithTransportCredentials(insecure.NewCredentials()), "", "filer", "", "", "", pb.ServerDiscovery{})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	mc.tryConnectToMaster(ctx, server.address)
+	if server.connections.Load() != 1 {
+		t.Fatal("first stream did not register")
+	}
+	barrier := make(chan struct{})
+	mc.SetOnLockRingUpdateFn(func(*master_pb.LockRingUpdate) { close(barrier) })
+	done := make(chan struct{})
+	go func() { mc.tryConnectToMaster(ctx, server.address); close(done) }()
+	select {
+	case <-barrier:
+	case <-ctx.Done():
+		t.Fatal("reconnected stream did not deliver its initial ADDs")
+	}
+	var replayed []string
+	mc.SetOnPeerUpdateFn(func(update *master_pb.ClusterNodeUpdate, _ time.Time) { replayed = append(replayed, update.Address) })
+	cancel()
+	<-done
+	if len(replayed) != 1 || replayed[0] != "peer-b:8888" {
+		t.Fatalf("replayed %v, want only the reconnected stream's [peer-b:8888]", replayed)
+	}
+}
