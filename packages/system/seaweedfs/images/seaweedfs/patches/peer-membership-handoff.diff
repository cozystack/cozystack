index 0000000..38730ec
--- /dev/null
+++ b/weed/wdclient/masterclient_peer_handoff_test.go
@@ -0,0 +1,99 @@
+package wdclient
+
+import (
+	"reflect"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/seaweedfs/seaweedfs/weed/pb/master_pb"
+)
+
+func TestPeerUpdateHandoffRetainsActiveState(t *testing.T) {
+	mc := &MasterClient{FilerGroup: "test"}
+	event := func(kind, address, group string, add bool) *master_pb.ClusterNodeUpdate {
+		return &master_pb.ClusterNodeUpdate{NodeType: kind, Address: address, FilerGroup: group, IsAdd: add}
+	}
+	for i := 0; i < 100; i++ {
+		mc.dispatchPeerUpdate(event("filer", "gone:8888", "test", true))
+		mc.dispatchPeerUpdate(event("filer", "gone:8888", "test", false))
+	}
+	mc.dispatchPeerUpdate(event("filer", "keep:8888", "test", true))
+	mc.dispatchPeerUpdate(event("s3", "keep:8888", "test", true))
+	mc.dispatchPeerUpdate(event("filer", "foreign:8888", "other", true))
+	if len(mc.pendingPeerUpdates) != 2 {
+		t.Fatalf("retained entries = %d, want two active peer keys", len(mc.pendingPeerUpdates))
+	}
+	got := make(map[string]bool)
+	mc.SetOnPeerUpdateFn(func(update *master_pb.ClusterNodeUpdate, _ time.Time) {
+		got[update.NodeType+"/"+update.Address] = true
+	})
+	want := map[string]bool{"filer/keep:8888": true, "s3/keep:8888": true}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("handoff = %v, want %v", got, want)
+	}
+	if len(mc.pendingPeerUpdates) != 0 {
+		t.Fatal("handoff retained state after consumer installation")
+	}
+}
+
+func TestPeerUpdateHandoffOrdersConcurrentDispatch(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		mc := &MasterClient{}
+		add := &master_pb.ClusterNodeUpdate{NodeType: "filer", Address: "peer:8888", IsAdd: true}
+		remove := &master_pb.ClusterNodeUpdate{NodeType: "filer", Address: "peer:8888"}
+		mc.dispatchPeerUpdate(add)
+		replayEntered := make(chan struct{})
+		releaseReplay := make(chan struct{})
+		callbackReturned := make(chan struct{})
+		var got []bool
+		var mu sync.Mutex
+		var wg sync.WaitGroup
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			mc.SetOnPeerUpdateFn(func(update *master_pb.ClusterNodeUpdate, _ time.Time) {
+				if update.IsAdd {
+					close(replayEntered)
+					<-releaseReplay
+				}
+				mu.Lock()
+				got = append(got, update.IsAdd)
+				mu.Unlock()
+			})
+		}()
+		<-replayEntered
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			mc.dispatchPeerUpdate(remove)
+			close(callbackReturned)
+		}()
+		synctest.Wait()
+		mu.Lock()
+		early := len(got)
+		mu.Unlock()
+		if early != 0 {
+			t.Errorf("live callback overtook retained-state replay: %d callbacks", early)
+		}
+		close(releaseReplay)
+		wg.Wait()
+		<-callbackReturned
+		if !reflect.DeepEqual(got, []bool{true, false}) {
+			t.Fatalf("callback order = %v, want ADD then REMOVE", got)
+		}
+	})
+}
+
+func TestPeerUpdateHandoffCallbackRunsOutsideStateLock(t *testing.T) {
+	mc := &MasterClient{}
+	mc.dispatchPeerUpdate(&master_pb.ClusterNodeUpdate{NodeType: "filer", Address: "peer:8888", IsAdd: true})
+	mc.SetOnPeerUpdateFn(func(*master_pb.ClusterNodeUpdate, time.Time) {
+		if !mc.OnPeerUpdateLock.TryLock() {
+			t.Fatal("callback invoked with state lock held")
+		}
+		mc.OnPeerUpdateLock.Unlock()
+	})
+	mc.dispatchPeerUpdate(&master_pb.ClusterNodeUpdate{NodeType: "filer", Address: "peer:8888"})
+}
