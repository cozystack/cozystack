+++ b/weed/wdclient/masterclient_peer_reconnect_test.go
@@ -0,0 +1,146 @@
+package wdclient
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/seaweedfs/seaweedfs/weed/pb"
+	"github.com/seaweedfs/seaweedfs/weed/pb/master_pb"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/status"
+)
+
+type peerReconnectMaster struct {
+	master_pb.UnimplementedSeaweedServer
+	address     pb.ServerAddress
+	streams     [][]string
+	connections atomic.Int32
+}
+
+func (s *peerReconnectMaster) KeepConnected(stream master_pb.Seaweed_KeepConnectedServer) error {
+	if _, err := stream.Recv(); err != nil {
+		return err
+	}
+	n := s.connections.Add(1)
+	if err := stream.Send(&master_pb.KeepConnectedResponse{VolumeLocation: &master_pb.VolumeLocation{Leader: string(s.address)}}); err != nil {
+		return err
+	}
+	for _, address := range s.streams[min(int(n), len(s.streams))-1] {
+		if err := stream.Send(&master_pb.KeepConnectedResponse{ClusterNodeUpdate: &master_pb.ClusterNodeUpdate{NodeType: "filer", Address: address, IsAdd: true}}); err != nil {
+			return err
+		}
+	}
+	if n == 1 {
+		return status.Error(codes.Unavailable, "reconnect")
+	}
+	if err := stream.Send(&master_pb.KeepConnectedResponse{LockRingUpdate: &master_pb.LockRingUpdate{Version: 2}}); err != nil {
+		return err
+	}
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
+
+func TestPeerUpdateHandoffReconnectInitialAdds(t *testing.T) {
+	server := &peerReconnectMaster{streams: [][]string{{"peer-a:8888"}, {"peer-a:8888", "peer-b:8888"}}}
+	server.address = startFakeMasterServer(t, server)
+	mc := NewMasterClient(grpc.WithTransportCredentials(insecure.NewCredentials()), "", "filer", "", "", "", pb.ServerDiscovery{})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	mc.tryConnectToMaster(ctx, server.address)
+	if server.connections.Load() != 1 {
+		t.Fatal("first stream did not register")
+	}
+	updates := make(chan string, 3)
+	mc.SetOnPeerUpdateFn(func(update *master_pb.ClusterNodeUpdate, _ time.Time) { updates <- update.Address })
+	barrier := make(chan struct{})
+	mc.SetOnLockRingUpdateFn(func(*master_pb.LockRingUpdate) { close(barrier) })
+	done := make(chan struct{})
+	go func() { mc.tryConnectToMaster(ctx, server.address); close(done) }()
+	select {
+	case <-barrier:
+	case <-ctx.Done():
+		t.Fatal("reconnected stream did not dispatch its initial ADDs")
+	}
+	cancel()
+	<-done
+	for _, want := range []string{"peer-a:8888", "peer-b:8888"} {
+		select {
+		case got := <-updates:
+			if got != want {
+				t.Fatalf("update = %q, want %q", got, want)
+			}
+		default:
+			t.Fatalf("missing update %q", want)
+		}
+	}
+}
