+func TestPeerUpdateHandoffReconnectSkipsPeersOfEndedStream(t *testing.T) {
+	server := &peerReconnectMaster{streams: [][]string{{"peer-a:8888"}, {"peer-b:8888"}}}
+	server.address = startFakeMasterServer(t, server)
+	mc := NewMasterClient(grpc.WithTransportCredentials(insecure.NewCredentials()), "", "filer", "", "", "", pb.ServerDiscovery{})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	mc.tryConnectToMaster(ctx, server.address)
+	if server.connections.Load() != 1 {
+		t.Fatal("first stream did not register")
+	}
+	updates := make(chan string, 3)
+	mc.SetOnPeerUpdateFn(func(update *master_pb.ClusterNodeUpdate, _ time.Time) { updates <- update.Address })
+	select {
+	case got := <-updates:
+		t.Fatalf("replayed %q from a stream that already ended", got)
+	default:
+	}
+	barrier := make(chan struct{})
+	mc.SetOnLockRingUpdateFn(func(*master_pb.LockRingUpdate) { close(barrier) })
+	done := make(chan struct{})
+	go func() { mc.tryConnectToMaster(ctx, server.address); close(done) }()
+	select {
+	case <-barrier:
+	case <-ctx.Done():
+		t.Fatal("reconnected stream did not deliver its initial ADDs")
+	}
+	cancel()
+	<-done
+	close(updates)
+	var got []string
+	for address := range updates {
+		got = append(got, address)
+	}
+	if len(got) != 1 || got[0] != "peer-b:8888" {
+		t.Fatalf("updates %v, want only the reconnected stream's [peer-b:8888]", got)
+	}
