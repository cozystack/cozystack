+	_, hasServer := usages[cmapi.UsageServerAuth]
+	_, hasClient := usages[cmapi.UsageClientAuth]
+	a.True(hasServer, "Certificate must declare server auth usage")
+	a.True(hasClient, "Certificate must declare client auth usage")
+}
