+func hasTLSMount(mounts []corev1.VolumeMount) bool {
+	for _, m := range mounts {
+		if m.Name == "redis-tls" && m.MountPath == "/tls" && m.ReadOnly {
+			return true
+		}
+	}
+	return false
+}
