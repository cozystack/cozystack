diff --git a/operator/redisfailover/service/heal.go b/operator/redisfailover/service/heal.go
index 9947d73..36bbc6a 100644
--- a/operator/redisfailover/service/heal.go
+++ b/operator/redisfailover/service/heal.go
@@ -332,7 +332,25 @@ func (r *RedisFailoverHealer) RestoreSentinel(ip string, rf *redisfailoverv1.Red
 	if err != nil {
 		return err
 	}
-	return r.redisClient.ResetSentinel(ip, tlsConfig)
+	if err := r.redisClient.ResetSentinel(ip, tlsConfig); err != nil {
+		return err
+	}
+
+	// SENTINEL RESET keeps the auth-pass the Sentinel already has, and
+	// NewSentinelMonitor, the only other place that sets it, runs only when
+	// the Sentinel monitors the wrong address. A Sentinel restarted with the
+	// initial config can take the current master address from a peer's hello
+	// message, so it monitors the right address without a password, gets
+	// NOAUTH from the master and keeps reporting it as down: the reset alone
+	// would then repeat on every check without converging.
+	password, err := k8s.GetRedisPassword(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	if password == "" {
+		return nil
+	}
+	return r.redisClient.SetSentinelAuthPass(ip, rf.MasterName(), password, tlsConfig)
 }
 
