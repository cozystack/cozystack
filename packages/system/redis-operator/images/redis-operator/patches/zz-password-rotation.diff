+// trackedHealer runs one untampered reconcile pass, which leaves the
+// RedisFailover with the guard, and returns a fresh redis mock for the
+// guard's own calls.
+func trackedHealer(t *testing.T) (*rfservice.RedisFailoverHealer, *redisfailoverv1.RedisFailover, *mRedisService.Client) {
+	t.Helper()
