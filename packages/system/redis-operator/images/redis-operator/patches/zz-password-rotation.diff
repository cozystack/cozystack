+package service_test
+
+import (
+	"crypto/tls"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	redisfailoverv1 "github.com/freshworks/redis-operator/api/redisfailover/v1"
+	"github.com/freshworks/redis-operator/log"
+	mK8SService "github.com/freshworks/redis-operator/mocks/service/k8s"
+	mRedisService "github.com/freshworks/redis-operator/mocks/service/redis"
+	rfservice "github.com/freshworks/redis-operator/operator/redisfailover/service"
+	"github.com/freshworks/redis-operator/service/redis"
+)
+
+// The tests below run passes against a small model of two servers, two
+// Sentinels, the internal Secret and the redis ConfigMap, and check after
+// every write that nothing the operator set can lock replication or a
+// Sentinel out:
+//
+//   - every server accepts the pod password;
+//   - every server accepts the masterauth of every server, since any of them
+//     may be the master;
+//   - every server accepts the auth-pass of every Sentinel;
+//   - no masterauth carries a new link password while a server still takes
+//     the old client password, whose holders could read it;
+//   - no connection of the default or the exporter user is authenticated
+//     with a password its user no longer takes: either could read the new
+//     client password with CONFIG GET;
+//   - the rotation is not recorded as done while a server keeps a MONITOR,
+//     or a connection of an operator user from an address that is no pod
+//     of the RedisFailover and not loopback.
+
+var (
+	serverIPs   = []string{"10.0.0.1", "10.0.0.2"}
+	sentinelIPs = []string{"10.0.1.1", "10.0.1.2"}
+)
+
+type fakeServer struct {
+	users       []string
+	requirepass string
+	acls        map[string]redis.UserACL
+	masteruser  string
+	masterauth  string
+	sessions    []session
+}
+
+// session is an open connection, the password it authenticated with, the
+// address it comes from, and whether it is in MONITOR mode.
+type session struct {
+	user, password, host string
+	monitor              bool
+}
+
+const tenantHost = "10.0.9.9"
+
+func conn(user, password, host string) session {
+	return session{user: user, password: password, host: host}
+}
+
+// operatorSessions are the connections the operator's own links keep open
+// on every server: a Sentinel and a replica as the internal user, and the
+// liveness probe. The exporter's connection is not among them: a client
+// password change kills it, and the exporter reconnects on its next scrape.
+func operatorSessions() []session {
+	return []session{
+		conn("rf-internal", linkPassword, sentinelIPs[0]),
+		conn("rf-internal", linkPassword, serverIPs[1]),
+		conn("pinger", "pingpass", "127.0.0.1"),
+	}
+}
+
+// stray tells a connection the rotation must not leave behind.
+func stray(c session) bool {
+	if c.monitor {
+		return true
+	}
+	if c.user != "rf-internal" && c.user != "rf-exporter" && c.user != "pinger" {
+		return false
+	}
+	for _, ip := range append(append([]string{"127.0.0.1", "::1"}, serverIPs...), sentinelIPs...) {
+		if c.host == ip {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *fakeServer) kill(user string) {
+	var kept []session
+	for _, c := range s.sessions {
+		if c.user != user {
+			kept = append(kept, c)
+		}
+	}
+	s.sessions = kept
+}
+
+func (s *fakeServer) sessionsOf(user string) []string {
+	var out []string
+	for _, c := range s.sessions {
+		if c.user == user {
+			out = append(out, c.password)
+		}
+	}
+	return out
+}
+
+type world struct {
+	rf         *redisfailoverv1.RedisFailover
+	client     string // the auth Secret's password
+	confClient string // the ConfigMap's requirepass
+	confLink   string // the ConfigMap's masterauth
+	oldLink    string // the link password before the rotation under test
+	secret     map[string][]byte
+	servers    map[string]*fakeServer
+	sentinels  map[string]string
+
+	failAt     int // the write that fails, -1 for none
+	writes     int
+	violations []string
+	changes    []change // every ChangeClientPassword, as called
+}
+
+type change struct {
+	ip, password string
+	reset        []redis.ACLUser
+	deleted      []string
+	killed       []string
+}
+
+// newWorld is a RedisFailover at rest on oldPassword and linkPassword whose
+// auth Secret now says newPassword.
+func newWorld(rf *redisfailoverv1.RedisFailover) *world {
+	w := &world{
+		rf:         rf,
+		client:     newPassword,
+		confClient: oldPassword,
+		confLink:   linkPassword,
+		oldLink:    linkPassword,
+		secret: map[string][]byte{
+			"password":      []byte(internalPassword),
+			"exporter":      []byte(exporterPassword),
+			"link":          []byte(linkPassword),
+			"client-sha256": []byte(sha(oldPassword)),
+		},
+		servers:   map[string]*fakeServer{},
+		sentinels: map[string]string{},
+		failAt:    -1,
+	}
+	for _, ip := range serverIPs {
+		w.servers[ip] = &fakeServer{
+			users:       []string{"default", "pinger", "rf-exporter", "rf-internal"},
+			requirepass: oldPassword,
+			acls: map[string]redis.UserACL{
+				"rf-internal": aclFrom(internalRules),
+				"rf-exporter": aclFrom(exporterRules),
+				"pinger":      aclFrom(pingerRules),
+			},
+			masteruser: "rf-internal",
+			masterauth: linkPassword,
+			// A tenant's client on the old password, the exporter, and the
+			// operator's links.
+			sessions: append([]session{conn("default", oldPassword, tenantHost), conn("rf-exporter", exporterPassword, "127.0.0.1")}, operatorSessions()...),
+		}
+	}
+	for _, ip := range sentinelIPs {
+		w.sentinels[ip] = linkPassword
+	}
+	return w
+}
+
+// aclFrom is what ACL GETUSER reports after ACL SETUSER reset rules...
+func aclFrom(rules []string) redis.UserACL {
+	acl := redis.UserACL{Exists: true}
+	var channels, commands []string
+	for _, r := range rules {
+		switch {
+		case r == "on":
+			acl.On = true
+		case strings.HasPrefix(r, "#"):
+			acl.Hashes = append(acl.Hashes, r[1:])
+		case strings.HasPrefix(r, "&"):
+			channels = append(channels, r)
+		case strings.HasPrefix(r, "~"):
+			acl.Keys = r
+		case r == "-@all" || strings.HasPrefix(r, "+"):
+			commands = append(commands, r)
+		}
+	}
+	acl.Channels = strings.Join(channels, " ")
+	acl.Commands = strings.Join(commands, " ")
+	return acl
+}
+
+func (w *world) write(what string) error {
+	n := w.writes
+	w.writes++
+	if n == w.failAt {
+		return fmt.Errorf("injected failure at write %d (%s)", n, what)
+	}
+	return nil
+}
+
+func (w *world) accepts(ip, password string) bool {
+	return w.userAccepts(ip, "rf-internal", password)
+}
+
+func (w *world) userAccepts(ip, user, password string) bool {
+	if user == "default" {
+		return w.servers[ip].requirepass == password
+	}
+	for _, h := range w.servers[ip].acls[user].Hashes {
+		if h == sha(password) {
+			return true
+		}
+	}
+	return false
+}
+
+func (w *world) check(after string) {
+	for _, ip := range serverIPs {
+		if !w.accepts(ip, internalPassword) {
+			w.violations = append(w.violations, fmt.Sprintf("after %s: %s refuses the pod password", after, ip))
+		}
+		for _, other := range serverIPs {
+			if !w.accepts(ip, w.servers[other].masterauth) {
+				w.violations = append(w.violations, fmt.Sprintf("after %s: %s refuses the masterauth of %s", after, ip, other))
+			}
+		}
+		for sip, pass := range w.sentinels {
+			if !w.accepts(ip, pass) {
+				w.violations = append(w.violations, fmt.Sprintf("after %s: %s refuses the auth-pass of Sentinel %s", after, ip, sip))
+			}
+		}
+		for _, c := range w.servers[ip].sessions {
+			if (c.user == "default" || c.user == "rf-exporter") && !w.userAccepts(ip, c.user, c.password) {
+				w.violations = append(w.violations, fmt.Sprintf("after %s: %s keeps a %s connection on the password %q it no longer takes", after, ip, c.user, c.password))
+			}
+		}
+	}
+}
+
+func (w *world) auth(ip, password string) error {
+	if w.servers[ip].requirepass != password {
+		return wrongPass
+	}
+	return nil
+}
+
+// fakeRedis serves the model; any other method panics through the mock.
+type fakeRedis struct {
+	*mRedisService.Client
+	w *world
+}
+
+func (f fakeRedis) GetDefaultUserPasswords(ip, _, password string, _ *tls.Config) (redis.DefaultUserPasswords, error) {
+	return redis.DefaultUserPasswords{}, f.w.auth(ip, password)
+}
+
+func (f fakeRedis) SetCustomRedisConfig(ip, _ string, configs []string, password string, _ *tls.Config) error {
+	if err := f.w.auth(ip, password); err != nil {
+		return err
+	}
+	if err := f.w.write("requirepass " + ip); err != nil {
+		return err
+	}
+	for _, c := range configs {
+		if v, ok := strings.CutPrefix(c, "requirepass "); ok {
+			f.w.servers[ip].requirepass = v
+		}
+	}
+	f.w.check("requirepass " + ip)
+	return nil
+}
+
+func (f fakeRedis) GetUserACL(ip, _, auth, user string, _ *tls.Config) (redis.UserACL, error) {
+	if err := f.w.auth(ip, auth); err != nil {
+		return redis.UserACL{}, err
+	}
+	acl := f.w.servers[ip].acls[user]
+	acl.Hashes = append([]string(nil), acl.Hashes...)
+	return acl, nil
+}
+
+func (s *fakeServer) setUser(user string, rules []string) {
+	s.acls[user] = aclFrom(rules)
+	for _, u := range s.users {
+		if u == user {
+			return
+		}
+	}
+	s.users = append(s.users, user)
+	sort.Strings(s.users)
+}
+
+func (s *fakeServer) deleteUsers(users []string) {
+	gone := map[string]bool{}
+	for _, u := range users {
+		gone[u] = true
+		delete(s.acls, u)
+		s.kill(u)
+	}
+	var kept []string
+	for _, u := range s.users {
+		if !gone[u] {
+			kept = append(kept, u)
+		}
+	}
+	s.users = kept
+}
+
+func (f fakeRedis) SetUserACL(ip, _, auth, user string, rules []string, _ *tls.Config) error {
+	if err := f.w.auth(ip, auth); err != nil {
+		return err
+	}
+	if err := f.w.write("acl " + ip); err != nil {
+		return err
+	}
+	f.w.servers[ip].setUser(user, rules)
+	f.w.check("acl " + ip)
+	return nil
+}
+
+// ChangeClientPassword applies the whole transaction as one write, as EXEC
+// does.
+func (f fakeRedis) ChangeClientPassword(ip, _, auth, password string, reset []redis.ACLUser, deleteUsers, killUsers []string, _ *tls.Config) error {
+	if err := f.w.auth(ip, auth); err != nil {
+		return err
+	}
+	f.w.changes = append(f.w.changes, change{ip: ip, password: password, reset: reset, deleted: deleteUsers, killed: killUsers})
+	if err := f.w.write("change " + ip); err != nil {
+		return err
+	}
+	s := f.w.servers[ip]
+	for _, u := range reset {
+		s.setUser(u.Name, u.Rules)
+	}
+	s.deleteUsers(deleteUsers)
+	s.requirepass = password
+	for _, u := range killUsers {
+		s.kill(u)
+	}
+	f.w.check("change " + ip)
+	return nil
+}
+
+func (f fakeRedis) ListUsers(ip, _, auth string, _ *tls.Config) ([]string, error) {
+	if err := f.w.auth(ip, auth); err != nil {
+		return nil, err
+	}
+	return append([]string(nil), f.w.servers[ip].users...), nil
+}
+
+func (f fakeRedis) DeleteUsers(ip, _, auth string, users []string, _ *tls.Config) error {
+	if err := f.w.auth(ip, auth); err != nil {
+		return err
+	}
+	if err := f.w.write("deluser " + ip); err != nil {
+		return err
+	}
+	f.w.servers[ip].deleteUsers(users)
+	return nil
+}
+
+func (f fakeRedis) GetMasterAuth(ip, _, auth string, _ *tls.Config) (string, string, error) {
+	if err := f.w.auth(ip, auth); err != nil {
+		return "", "", err
+	}
+	return f.w.servers[ip].masteruser, f.w.servers[ip].masterauth, nil
+}
+
+func (f fakeRedis) SetMasterAuth(ip, _, auth, user, password string, _ *tls.Config) error {
+	if err := f.w.auth(ip, auth); err != nil {
+		return err
+	}
+	if err := f.w.write("masterauth " + ip); err != nil {
+		return err
+	}
+	if password != f.w.oldLink {
+		for other, s := range f.w.servers {
+			if s.requirepass != f.w.client {
+				f.w.violations = append(f.w.violations, fmt.Sprintf("the new link password went into masterauth on %s while %s still takes the old client password", ip, other))
+			}
+		}
+	}
+	f.w.servers[ip].masteruser, f.w.servers[ip].masterauth = user, password
+	f.w.check("masterauth " + ip)
+	return nil
+}
+
+func (f fakeRedis) GetClientUsers(ip, _, auth string, _ *tls.Config) (map[string][]string, error) {
+	if err := f.w.auth(ip, auth); err != nil {
+		return nil, err
+	}
+	out := map[string][]string{}
+	for _, sip := range sentinelIPs {
+		out[sip] = []string{"rf-internal"}
+	}
+	return out, nil
+}
+
+func (f fakeRedis) SetSentinelAuth(ip, _, _, password string, _ *tls.Config) error {
+	if err := f.w.write("sentinel " + ip); err != nil {
+		return err
+	}
+	f.w.sentinels[ip] = password
+	f.w.check("sentinel " + ip)
+	return nil
+}
+
+func (f fakeRedis) ListClients(ip, _, auth string, _ *tls.Config) ([]redis.ClientInfo, error) {
+	if err := f.w.auth(ip, auth); err != nil {
+		return nil, err
+	}
+	var out []redis.ClientInfo
+	for i, c := range f.w.servers[ip].sessions {
+		flags := "N"
+		if c.monitor {
+			flags = "O"
+		}
+		out = append(out, redis.ClientInfo{ID: strconv.Itoa(i), Host: c.host, User: c.user, Flags: flags})
+	}
+	return out, nil
+}
+
+// KillClients takes the ids ListClients gave; nothing in the model connects
+// in between.
+func (f fakeRedis) KillClients(ip, _, auth string, ids []string, _ *tls.Config) error {
+	if err := f.w.auth(ip, auth); err != nil {
+		return err
+	}
+	if err := f.w.write("killclients " + ip); err != nil {
+		return err
+	}
+	gone := map[string]bool{}
+	for _, id := range ids {
+		gone[id] = true
+	}
+	s := f.w.servers[ip]
+	var kept []session
+	for i, c := range s.sessions {
+		if !gone[strconv.Itoa(i)] {
+			kept = append(kept, c)
+		}
+	}
+	s.sessions = kept
+	f.w.check("killclients " + ip)
+	return nil
+}
+
+// fakeK8s serves the Secrets and the ConfigMap from the model.
+type fakeK8s struct {
+	*mK8SService.Services
+	w *world
+}
+
+func (f fakeK8s) GetSecret(_, name string) (*corev1.Secret, error) {
+	if name == internalSecret {
+		data := map[string][]byte{}
+		for k, v := range f.w.secret {
+			data[k] = append([]byte(nil), v...)
+		}
+		return &corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: name}, Data: data}, nil
+	}
+	return &corev1.Secret{Data: map[string][]byte{"password": []byte(f.w.client)}}, nil
+}
+
+func (f fakeK8s) UpdateSecret(_ string, s *corev1.Secret) error {
+	if err := f.w.write("secret"); err != nil {
+		return err
+	}
+	_, was := f.w.secret["link-previous"]
+	_, is := s.Data["link-previous"]
+	if was && !is {
+		for ip, srv := range f.w.servers {
+			for _, c := range srv.sessions {
+				if stray(c) {
+					f.w.violations = append(f.w.violations, fmt.Sprintf("the rotation was recorded as done while %s keeps %+v", ip, c))
+				}
+			}
+		}
+	}
+	f.w.secret = s.Data
+	return nil
+}
+
+func (f fakeK8s) GetConfigMap(_, _ string) (*corev1.ConfigMap, error) {
+	return rfservice.GenerateRedisConfigMapForTest(f.w.rf, nil, nil, f.w.confClient, internalPassword, f.w.confLink, exporterPassword), nil
+}
+
+func (w *world) services() fakeK8s {
+	ms := &mK8SService.Services{}
+	pods := &corev1.PodList{}
+	for i, ip := range serverIPs {
+		pods.Items = append(pods.Items, runningPod(fmt.Sprintf("rfr-%d", i), ip))
+	}
+	sentinels := &corev1.PodList{}
+	for i, ip := range sentinelIPs {
+		sentinels.Items = append(sentinels.Items, runningPod(fmt.Sprintf("rfs-%d", i), ip))
+	}
+	ms.On("GetStatefulSetPods", namespace, rfservice.GetRedisName(w.rf)).Return(pods, nil)
+	ms.On("GetDeploymentPods", namespace, rfservice.GetSentinelName(w.rf)).Return(sentinels, nil)
+	return fakeK8s{Services: ms, w: w}
+}
+
+// pass runs one reconcile pass on a fresh healer, as after a restart of the
+// operator, and on success writes the ConfigMap as Ensure would.
+func (w *world) pass() (*rfservice.RedisFailoverHealer, error) {
+	healer := rfservice.NewRedisFailoverHealer(w.services(), fakeRedis{Client: &mRedisService.Client{}, w: w}, log.Dummy)
+	err := healer.ReconcileRedisAuth(w.rf, nil, nil)
+	if err == nil {
+		w.confClient, w.confLink = w.client, string(w.secret["link"])
+	}
+	return healer, err
+}
+
+func sorted(s []string) []string {
+	s = append([]string(nil), s...)
+	sort.Strings(s)
+	return s
+}
+
+// assertRotated checks the end state: everything on newLink, the old link
+// password refused by every server, and the Secret recording the rotation
+// as done for the current client password.
+func (w *world) assertRotated(t *testing.T, newLink string) {
+	t.Helper()
+	assert.NotEqual(t, w.oldLink, newLink)
+	assert.Equal(t, newLink, string(w.secret["link"]))
+	assert.NotContains(t, w.secret, "link-previous")
+	assert.Equal(t, sha(w.client), string(w.secret["client-sha256"]))
+	assert.Equal(t, internalPassword, string(w.secret["password"]), "the pod password never changes")
+	want := sorted([]string{sha(internalPassword), sha(newLink)})
+	for ip, s := range w.servers {
+		assert.Equal(t, w.client, s.requirepass, ip)
+		assert.Equal(t, want, sorted(s.acls["rf-internal"].Hashes), ip)
+		assert.False(t, w.accepts(ip, w.oldLink), "%s still takes the old link password", ip)
+		assert.Equal(t, "rf-internal", s.masteruser, ip)
+		assert.Equal(t, newLink, s.masterauth, ip)
+		assert.Equal(t, internalCommandRules, s.acls["rf-internal"].Commands, ip)
+		assert.Equal(t, aclFrom(exporterRules), s.acls["rf-exporter"], ip)
+		assert.Equal(t, aclFrom(pingerRules), s.acls["pinger"], ip)
+		// No tenant connection outlives the change, and the operator's own
+		// links are untouched.
+		for _, p := range s.sessionsOf("default") {
+			assert.Equal(t, w.client, p, "%s keeps a default connection on an old client password", ip)
+		}
+		assert.Subset(t, s.sessions, operatorSessions(), ip)
+	}
+	for ip, pass := range w.sentinels {
+		assert.Equal(t, newLink, pass, ip)
+	}
+	assert.Empty(t, w.violations)
+}
+
+func TestReconcileRedisAuthRotatesTheLinkPasswordWithTheClientPassword(t *testing.T) {
+	w := newWorld(authRF())
+	_, err := w.pass()
+	require.NoError(t, err)
+	w.assertRotated(t, string(w.secret["link"]))
+	// The client password change on each server, the Secret, both ACLs,
+	// both masterauths, both Sentinels, both ACLs again, the Secret again.
+	assert.Equal(t, 12, w.writes)
+	assert.Equal(t, newPassword, w.confClient, "the ConfigMap moves on only once the rotation is done")
+
+	// The next pass finds nothing to do.
+	w.writes = 0
+	_, err = w.pass()
+	require.NoError(t, err)
+	assert.Zero(t, w.writes)
+}
+
+// A failed write stands for a crash right before it: the next pass, on a
+// fresh operator, must finish the same rotation, never start a second one,
+// and keep every invariant on the way.
+func TestReconcileRedisAuthResumesARotationInterruptedAtAnyStep(t *testing.T) {
+	const writes = 12
+	for failAt := 0; failAt < writes; failAt++ {
+		t.Run(fmt.Sprintf("write %d", failAt), func(t *testing.T) {
+			w := newWorld(authRF())
+			w.failAt = failAt
+			_, err := w.pass()
+			require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+			assert.Equal(t, oldPassword, w.confClient, "an unfinished rotation keeps the ConfigMap")
+			generated := ""
+			if _, ok := w.secret["link-previous"]; ok {
+				generated = string(w.secret["link"])
+			}
+
+			w.failAt = -1
+			_, err = w.pass()
+			require.NoError(t, err)
+			if generated != "" {
+				assert.Equal(t, generated, string(w.secret["link"]), "the interrupted rotation is finished, not restarted")
+			}
+			w.assertRotated(t, string(w.secret["link"]))
+		})
+	}
+}
+
+// A server that cannot be reached holds the old client password, so its
+// holders could still read masterauth there: the rotation does not start.
+func TestReconcileRedisAuthDoesNotRotateBeforeEveryServerRefusesTheOldClientPassword(t *testing.T) {
+	w := newWorld(authRF())
+	w.failAt = 1 // the second client password change
+	_, err := w.pass()
+	require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+	assert.Equal(t, linkPassword, string(w.secret["link"]))
+	assert.NotContains(t, w.secret, "link-previous")
+	assert.Equal(t, 2, w.writes, "nothing past the failed client password change")
+	assert.Empty(t, w.violations)
+}
+
+// A client password changed again after the new link password reached
+// masterauth: holders of the one in between may have read it, so the same
+// pass finishes that rotation and runs a second one.
+func TestReconcileRedisAuthRotatesAgainForAClientPasswordChangedMidway(t *testing.T) {
+	w := newWorld(authRF())
+	w.failAt = 9 // the first ACL of step 5, after the Sentinels moved
+	_, err := w.pass()
+	require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+	first := string(w.secret["link"])
+
+	// The tenant mints once more. The model skips how the servers reach the
+	// third password: a server on neither the ConfigMap's nor the current
+	// one is restarted, which TestReconcileRedisAuthRestartsAServerOnAnUnknownPassword covers.
+	w.client = "third-password"
+	for _, s := range w.servers {
+		s.requirepass = w.client
+	}
+	w.failAt = -1
+	_, err = w.pass()
+	require.NoError(t, err)
+	second := string(w.secret["link"])
+	assert.NotEqual(t, first, second)
+	w.assertRotated(t, second)
+	for ip := range w.servers {
+		assert.False(t, w.accepts(ip, first), ip)
+	}
+}
+
+// The guard between passes, with a rotation stopped halfway: it treats both
+// link passwords as the operator's, repairs a tampered server to both, and
+// re-sends the Sentinels only a password every server accepts.
+func TestGuardKeepsTheTransitionState(t *testing.T) {
+	cases := map[string]struct {
+		failAt       int
+		wantSentinel bool
+	}{
+		// Step 2 done, masterauth not started: the new password is valid
+		// everywhere, so the Sentinels can be re-sent it.
+		"after step 2": {failAt: 5, wantSentinel: true},
+		// Step 2 half done: whether the new one is valid on every server is
+		// not known, so the Sentinels are left alone.
+		"inside step 2": {failAt: 4, wantSentinel: false},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			w := newWorld(authRF())
+			w.failAt = c.failAt
+			healer, err := w.pass()
+			require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+			w.failAt = -1
+			next := string(w.secret["link"])
+			require.NotEqual(t, w.oldLink, next)
+
+			// The guard runs on the healer whose pass stopped.
+			w.servers["10.0.0.1"].acls["rf-internal"] = redis.UserACL{} // a tenant's ACL DELUSER
+			before := map[string]string{}
+			for ip, p := range w.sentinels {
+				before[ip] = p
+			}
+			healer.GuardInternalUsersOnce()
+
+			both := sorted([]string{sha(internalPassword), sha(w.oldLink), sha(next)})
+			for ip, s := range w.servers {
+				assert.Equal(t, both, sorted(s.acls["rf-internal"].Hashes), ip)
+			}
+			for ip, p := range w.sentinels {
+				if c.wantSentinel {
+					assert.Equal(t, next, p, ip)
+				} else {
+					assert.Equal(t, before[ip], p, ip)
+				}
+			}
+			assert.Empty(t, w.violations)
+
+			// The next pass still finishes the rotation.
+			_, err = w.pass()
+			require.NoError(t, err)
+			w.assertRotated(t, next)
+		})
+	}
+}
+
+// A revoke leaves no ACL user a tenant created while it held the old client
+// password, even when deleting it fails once.
+func TestReconcileRedisAuthDeletesForeignACLUsersOnRotation(t *testing.T) {
+	w := newWorld(authRF())
+	w.servers["10.0.0.2"].users = append(w.servers["10.0.0.2"].users, "backdoor")
+	w.failAt = 11 // the ACL DELUSER on 10.0.0.2, after both ACLs of step 5
+	_, err := w.pass()
+	require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+	assert.Contains(t, w.secret, "link-previous", "the rotation is not recorded as done")
+
+	w.failAt = -1
+	_, err = w.pass()
+	require.NoError(t, err)
+	for ip, s := range w.servers {
+		assert.Equal(t, []string{"default", "pinger", "rf-exporter", "rf-internal"}, s.users, ip)
+	}
+	w.assertRotated(t, string(w.secret["link"]))
+}
+
+func TestOperatorUserRuleStringsAreExact(t *testing.T) {
+	conf := rfservice.GenerateRedisConfigMapForTest(authRF(), nil, nil, newPassword, "p", "l", "e").Data["redis.conf"]
+	internal := "user rf-internal on #" + sha("p") + " #" + sha("l") + " resetkeys resetchannels &__sentinel__:hello -@all +ping +info +psync +sync +replconf +client|setname +client|kill +subscribe +publish +multi +exec +slaveof +config|rewrite +script|kill +save"
+	exporter := "user rf-exporter on #" + sha("e") + " resetkeys resetchannels -@all +client|setname +config|get +info +latency|latest +latency|histogram +slowlog|len +slowlog|get"
+	lines := strings.Split(conf, "\n")
+	assert.Equal(t, internal, lines[len(lines)-2])
+	assert.Equal(t, exporter, lines[len(lines)-1])
+	assert.NotContains(t, conf, "+@all")
+	assert.NotContains(t, conf, "~*")
+	assert.NotContains(t, conf, "&*")
+	// The template's pinger line, which pingerRules restates.
+	assert.Contains(t, conf, "\nuser pinger -@all +ping on >pingpass\n")
+	assert.Equal(t, "on #"+sha("pingpass")+" resetkeys resetchannels -@all +ping", strings.Join(pingerRules, " "))
+}
+
+// A mint and then a revoke, each a new client password: each change kills
+// every tenant connection on every server, replicas included, in the same
+// transaction that sets requirepass, and leaves the operator's links up.
+func TestClientPasswordChangeDisconnectsTheTenantOnMintAndRevoke(t *testing.T) {
+	w := newWorld(authRF())
+	_, err := w.pass()
+	require.NoError(t, err)
+	w.assertRotated(t, string(w.secret["link"]))
+	require.Len(t, w.changes, 2)
+	for i, ip := range serverIPs {
+		c := w.changes[i]
+		assert.Equal(t, ip, c.ip)
+		assert.Equal(t, newPassword, c.password)
+		assert.Equal(t, []string{"default", "rf-exporter"}, c.killed)
+		assert.Empty(t, c.deleted)
+		assert.Equal(t, []redis.ACLUser{
+			{Name: "rf-internal", Rules: internalRules},
+			{Name: "rf-exporter", Rules: exporterRules},
+			{Name: "pinger", Rules: pingerRules},
+		}, c.reset)
+	}
+
+	// The tenant connects with the minted password, then revokes it: the
+	// Secret gets a password nobody holds.
+	for _, s := range w.servers {
+		s.sessions = append(s.sessions, conn("default", newPassword, tenantHost))
+	}
+	w.client, w.oldLink, w.changes = "revoked-unknown", string(w.secret["link"]), nil
+	_, err = w.pass()
+	require.NoError(t, err)
+	w.assertRotated(t, string(w.secret["link"]))
+	require.Len(t, w.changes, 2)
+	for ip, s := range w.servers {
+		assert.Empty(t, s.sessionsOf("default"), "%s keeps a connection made with the revoked password", ip)
+	}
+}
+
+// What a holder of the old password could set before the change to stay in
+// after it: a password of their own on the exporter user, which may run
+// CONFIG GET, with a connection open on it; the pinger, whose password is
+// public, widened to every command; a user of their own. The change takes all
+// of it away at once.
+func TestClientPasswordChangeUndoesWhatTheOldPasswordSet(t *testing.T) {
+	w := newWorld(authRF())
+	s := w.servers["10.0.0.2"]
+	tampered := s.acls["rf-exporter"]
+	tampered.Hashes = append(tampered.Hashes, sha("tenant-added"))
+	s.acls["rf-exporter"] = tampered
+	s.sessions = append(s.sessions, conn("rf-exporter", "tenant-added", tenantHost), conn("backdoor", "x", tenantHost))
+	s.acls["pinger"] = aclFrom(strings.Fields("on #" + sha("pingpass") + " -@all +@all"))
+	s.users = append(s.users, "backdoor")
+
+	_, err := w.pass()
+	require.NoError(t, err)
+	w.assertRotated(t, string(w.secret["link"]))
+	assert.Empty(t, s.sessionsOf("backdoor"))
+	assert.NotContains(t, s.sessionsOf("rf-exporter"), "tenant-added")
+	assert.Equal(t, []string{"backdoor"}, w.changes[1].deleted)
+}
+
+// An interrupted change resumes without a second kill on a server it already
+// moved: that server is on the new password, so the next pass leaves it.
+func TestClientPasswordChangeResumesOnTheServersLeft(t *testing.T) {
+	w := newWorld(authRF())
+	w.failAt = 1 // the change on the second server
+	_, err := w.pass()
+	require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+	assert.Equal(t, newPassword, w.servers["10.0.0.1"].requirepass)
+	assert.Empty(t, w.servers["10.0.0.1"].sessionsOf("default"))
+	assert.Equal(t, oldPassword, w.servers["10.0.0.2"].requirepass)
+	assert.Equal(t, []string{oldPassword}, w.servers["10.0.0.2"].sessionsOf("default"), "a failed change changes nothing")
+
+	// A tenant client reconnects to the moved server with the new password.
+	w.servers["10.0.0.1"].sessions = append(w.servers["10.0.0.1"].sessions, conn("default", newPassword, tenantHost))
+	w.failAt, w.changes = -1, nil
+	_, err = w.pass()
+	require.NoError(t, err)
+	w.assertRotated(t, string(w.secret["link"]))
+	require.Len(t, w.changes, 1)
+	assert.Equal(t, "10.0.0.2", w.changes[0].ip)
+	assert.Equal(t, []string{newPassword}, w.servers["10.0.0.1"].sessionsOf("default"))
+}
+
+// What a holder of the old password could leave open to outlive a revoke
+// without reading the new one: a replication stream as the internal user
+// with the link password it read from masterauth, and a MONITOR opened as
+// the pinger while it was widened. The rotation closes both before it is
+// recorded as done, and keeps every link of the operator's own.
+func TestRotationDisconnectsStrayOperatorConnectionsAndMonitors(t *testing.T) {
+	for name, failAt := range map[string]int{"in one pass": -1, "resumed after the kill failed": 11} {
+		t.Run(name, func(t *testing.T) {
+			w := newWorld(authRF())
+			s := w.servers["10.0.0.1"]
+			sync := conn("rf-internal", linkPassword, tenantHost)
+			monitor := conn("pinger", "pingpass", tenantHost)
+			monitor.monitor = true
+			// A MONITOR from inside the pod goes too: no operator link uses one.
+			local := conn("pinger", "pingpass", "127.0.0.1")
+			local.monitor = true
+			s.sessions = append(s.sessions, sync, monitor, local)
+			w.failAt = failAt
+
+			_, err := w.pass()
+			if failAt >= 0 {
+				require.ErrorIs(t, err, rfservice.ErrPasswordRotationPending)
+				assert.Contains(t, w.secret, "link-previous", "not recorded as done before the kill")
+				w.failAt = -1
+				_, err = w.pass()
+			}
+			require.NoError(t, err)
+			w.assertRotated(t, string(w.secret["link"]))
+			for ip, srv := range w.servers {
+				for _, c := range srv.sessions {
+					assert.False(t, stray(c), "%s keeps %+v", ip, c)
+				}
+			}
+			if failAt < 0 {
+				assert.Equal(t, 13, w.writes, "the 12 writes of a rotation and one kill on the one server with strays")
+			}
+
+			// Nothing left to kill: the next pass writes nothing.
+			w.writes = 0
+			_, err = w.pass()
+			require.NoError(t, err)
+			assert.Zero(t, w.writes)
+		})
+	}
+}
