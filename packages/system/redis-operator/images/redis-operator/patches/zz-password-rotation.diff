+}
+
+// DeleteUsers authenticates as the default user with auth and deletes users
+// with ACL DELUSER, which also disconnects every client authenticated as
+// one of them.
+func (c *client) DeleteUsers(ip, port, auth string, users []string, tlsConfig *tls.Config) error {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	args := []interface{}{"ACL", "DELUSER"}
+	for _, u := range users {
+		args = append(args, u)
+	}
+	if err := rClient.Do(context.TODO(), args...).Err(); err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return err
+	}
+	c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.SUCCESS, metrics.NOT_APPLICABLE)
+	return nil
+}
+
+// ACLUser is a user and the rules ACL SETUSER gives it after a reset.
+type ACLUser struct {
+	Name  string
+	Rules []string
+}
+
+// ChangeClientPassword authenticates as the default user with auth and, in
+// one MULTI/EXEC transaction, resets every user in reset to its rules,
+// deletes deleteUsers, sets requirepass to password, and kills every
+// connection authenticated as one of killUsers but its own. No other client
+// runs a command in between, so none that authenticated with auth outlives
+// the change where the kill names its user. CLIENT KILL skips the caller by
+// default (SKIPME yes), and requirepass resets the passwords of the default
+// user (ACLUpdateDefaultUserPassword), so a password a tenant added to it
+// goes too.
+func (c *client) ChangeClientPassword(ip, port, auth, password string, reset []ACLUser, deleteUsers, killUsers []string, tlsConfig *tls.Config) error {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	ctx := context.TODO()
+	_, err := rClient.TxPipelined(ctx, func(pipe rediscli.Pipeliner) error {
+		for _, args := range clientPasswordChange(password, reset, deleteUsers, killUsers) {
+			pipe.Do(ctx, args...)
+		}
+		return nil
+	})
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return err
+	}
+	c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.SUCCESS, metrics.NOT_APPLICABLE)
+	return nil
+}
+
+// clientPasswordChange is the body of ChangeClientPassword's transaction.
+func clientPasswordChange(password string, reset []ACLUser, deleteUsers, killUsers []string) [][]interface{} {
+	var cmds [][]interface{}
+	for _, u := range reset {
+		args := []interface{}{"ACL", "SETUSER", u.Name, "reset"}
+		for _, rule := range u.Rules {
+			args = append(args, rule)
+		}
+		cmds = append(cmds, args)
+	}
+	if len(deleteUsers) > 0 {
+		args := []interface{}{"ACL", "DELUSER"}
+		for _, u := range deleteUsers {
+			args = append(args, u)
+		}
+		cmds = append(cmds, args)
+	}
+	cmds = append(cmds, []interface{}{"CONFIG", "SET", "requirepass", password})
+	for _, u := range killUsers {
+		cmds = append(cmds, []interface{}{"CLIENT", "KILL", "USER", u})
+	}
+	return cmds
+}
+
+// SetMasterAuth sets the user and password the server replicates as, in one
+// CONFIG SET (Redis 7 and Valkey take several parameters at once), so a
+// replica never reconnects with one changed and not the other.
+func (c *client) SetMasterAuth(ip, port, auth, user, password string, tlsConfig *tls.Config) error {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
