+func TestReconcileRedisAuthOnANewRedisFailoverCreatesTheInternalSecretOnly(t *testing.T) {
+	assert := assert.New(t)
+	rf := authRF()
+	ms := authServices(rf, newPassword, "", "")
+	owner := []metav1.OwnerReference{{Name: "test"}}
+	var created *corev1.Secret
+	ms.On("CreateSecret", namespace, mock.Anything).Once().Run(func(args mock.Arguments) {
+		created = args.Get(1).(*corev1.Secret)
+	}).Return(nil)
+
+	mr := &mRedisService.Client{}
+	healer := rfservice.NewRedisFailoverHealer(ms, mr, log.Dummy)
+	assert.NoError(healer.ReconcileRedisAuth(rf, map[string]string{"app": "x"}, owner))
+	if assert.NotNil(created) {
+		assert.Equal(internalSecret, created.Name)
+		assert.Len(string(created.Data["password"]), 32)
+		assert.Len(string(created.Data["link"]), 32)
+		assert.Len(string(created.Data["exporter"]), 32)
+		assert.NotEqual(string(created.Data["password"]), string(created.Data["link"]))
+		assert.NotEqual(string(created.Data["password"]), string(created.Data["exporter"]))
+		assert.Equal(sha(newPassword), string(created.Data["client-sha256"]))
+		assert.NotContains(created.Data, "link-previous")
+		assert.Equal(owner, created.OwnerReferences)
+	}
+	assert.Empty(mr.Calls, "a new RedisFailover has no server to touch")
+}
