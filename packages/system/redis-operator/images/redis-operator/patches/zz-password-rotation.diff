+	assert.Equal(t, UserACL{Exists: true, On: true, Hashes: []string{"aa"}, Keys: "~*", Channels: "&*", Commands: "+@all"}, got)
+
+	// Redis 6: keys and channels as lists; an extra selector is counted.
+	got, err = parseUserACL([]interface{}{
+		"flags", []interface{}{"off", "nopass"},
+		"passwords", []interface{}{},
+		"commands", "-@all +ping",
