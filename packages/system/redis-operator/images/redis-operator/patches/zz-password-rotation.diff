+
+// The whole change is one transaction, users first, the kill last, and the
+// kill keeps the default SKIPME yes so the transaction's own connection
+// survives it.
+func TestClientPasswordChangeCommands(t *testing.T) {
+	got := clientPasswordChange("new",
+		[]ACLUser{{Name: "rf-internal", Rules: []string{"on", "#aa"}}, {Name: "rf-exporter", Rules: []string{"on", "#bb"}}},
+		[]string{"backdoor", "spare"},
+		[]string{"default", "rf-exporter"})
+	assert.Equal(t, [][]interface{}{
+		{"ACL", "SETUSER", "rf-internal", "reset", "on", "#aa"},
+		{"ACL", "SETUSER", "rf-exporter", "reset", "on", "#bb"},
+		{"ACL", "DELUSER", "backdoor", "spare"},
+		{"CONFIG", "SET", "requirepass", "new"},
+		{"CLIENT", "KILL", "USER", "default"},
+		{"CLIENT", "KILL", "USER", "rf-exporter"},
+	}, got)
+
+	// No foreign user, no ACL DELUSER: it takes at least one name.
+	got = clientPasswordChange("new", nil, nil, []string{"default"})
+	assert.Equal(t, [][]interface{}{
+		{"CONFIG", "SET", "requirepass", "new"},
+		{"CLIENT", "KILL", "USER", "default"},
+	}, got)
+}
+
+func TestParseClients(t *testing.T) {
+	list := "id=3 addr=10.0.1.1:41000 laddr=10.0.0.1:6379 fd=8 name=sentinel-1-cmd age=9 flags=N db=0 cmd=ping user=rf-internal\n" +
+		"id=4 addr=10.0.0.2:50000 laddr=10.0.0.1:6379 fd=9 name= age=9 flags=S db=0 cmd=replconf user=rf-internal\n" +
+		"id=5 addr=[fd00::7]:5000 laddr=[fd00::1]:6379 fd=10 flags=O db=0 cmd=monitor user=pinger\n" +
+		"id=6 addr=/tmp/redis.sock:0 laddr=/tmp/redis.sock:0 fd=11 flags=N db=0 cmd=info user=rf-internal\n" +
+		"\n"
+	assert.Equal(t, []ClientInfo{
+		{ID: "3", Host: "10.0.1.1", User: "rf-internal", Flags: "N"},
+		{ID: "4", Host: "10.0.0.2", User: "rf-internal", Flags: "S"},
+		{ID: "5", Host: "fd00::7", User: "pinger", Flags: "O"},
+		{ID: "6", Host: "/tmp/redis.sock", User: "rf-internal", Flags: "N"},
+	}, parseClients(list))
+}
