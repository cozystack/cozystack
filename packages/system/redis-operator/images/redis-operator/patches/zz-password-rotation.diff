+			client := rfservice.NewRedisFailoverKubeClient(ms, log.Dummy, metrics.Dummy, "cluster.local")
+			assert.NoError(t, client.EnsureRedisStatefulset(rf, nil, []metav1.OwnerReference{}, ""))
+			if !assert.NotNil(t, ss) {
+				return
+			}
+			// The redis container and the exporter both.
+			assert.Len(t, ss.Spec.Template.Spec.Containers, 2)
+			for _, c := range ss.Spec.Template.Spec.Containers {
+				var user, secret string
+				for _, env := range c.Env {
