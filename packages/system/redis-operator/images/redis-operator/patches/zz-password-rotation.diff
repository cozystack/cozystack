+		mr.On("SetUserACL", "10.0.0.2", "0", newPassword, "rf-exporter", exporterRules, mock.Anything).Return(errors.New("i/o timeout"))
+		healer := rfservice.NewRedisFailoverHealer(ms, mr, log.Dummy)
+		assert.ErrorIs(t, healer.ReconcileRedisAuth(rf, nil, nil), rfservice.ErrPasswordRotationPending)
+	})
+}
+
+// An internal Secret from before the exporter user gets an exporter
+// password, and keeps everything it had.
+func TestReconcileRedisAuthAddsTheExporterPasswordToAnOlderSecret(t *testing.T) {
+	rf := authRF()
+	ms := &mK8SService.Services{}
+	ms.On("GetSecret", namespace, authSecret).Return(&corev1.Secret{Data: map[string][]byte{"password": []byte(newPassword)}}, nil)
+	ms.On("GetSecret", namespace, internalSecret).Return(&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: internalSecret}, Data: map[string][]byte{
+		"password":      []byte(internalPassword),
+		"link":          []byte(linkPassword),
+		"client-sha256": []byte(sha(newPassword)),
+	}}, nil)
+	ms.On("GetConfigMap", namespace, rfservice.GetRedisName(rf)).Return(nil, apierrors.NewNotFound(schema.GroupResource{}, ""))
+	var updated *corev1.Secret
+	ms.On("UpdateSecret", namespace, mock.Anything).Once().Run(func(args mock.Arguments) {
+		updated = args.Get(1).(*corev1.Secret)
+	}).Return(nil)
+
+	healer := rfservice.NewRedisFailoverHealer(ms, &mRedisService.Client{}, log.Dummy)
+	assert.NoError(t, healer.ReconcileRedisAuth(rf, nil, nil))
+	if assert.NotNil(t, updated) {
+		assert.Len(t, string(updated.Data["exporter"]), 32)
+		assert.Equal(t, internalPassword, string(updated.Data["password"]))
+		assert.Equal(t, linkPassword, string(updated.Data["link"]))
+		assert.Equal(t, sha(newPassword), string(updated.Data["client-sha256"]))
+	}
+}
+
+// The exporter user may read requirepass, so a password the tenant adds to
+// it, or a command, is taken away on the next pass.
+func TestReconcileRedisAuthRepairsATamperedExporterUser(t *testing.T) {
+	rf := authRF()
+	ms := authServices(rf, newPassword, internalPassword, redisConf(rf, newPassword, internalPassword))
+	mr := &mRedisService.Client{}
+	mr.On("GetDefaultUserPasswords", mock.Anything, "0", newPassword, mock.Anything).Return(redis.DefaultUserPasswords{}, nil)
+	tampered := intactExporterACL
+	tampered.Hashes = []string{sha(exporterPassword), sha("tenant-added")}
+	mr.On("GetUserACL", "10.0.0.1", "0", newPassword, "rf-exporter", mock.Anything).Return(tampered, nil)
+	mr.On("SetUserACL", "10.0.0.1", "0", newPassword, "rf-exporter", exporterRules, mock.Anything).Once().Return(nil)
+	for _, ip := range []string{"10.0.0.1", "10.0.0.2"} {
+		intactServer(mr, ip, newPassword)
+	}
+	healer := rfservice.NewRedisFailoverHealer(ms, mr, log.Dummy)
+	assert.NoError(t, healer.ReconcileRedisAuth(rf, nil, nil))
+	mr.AssertExpectations(t)
+	mr.AssertNumberOfCalls(t, "SetUserACL", 1)
+}
