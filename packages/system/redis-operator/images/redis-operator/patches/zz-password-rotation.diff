+			rf := authRF()
+			rf.Spec.Redis.Exporter.Enabled = true
+			internal := ""
+			if test.internal {
+				internal = internalPassword
+			}
+			ms := authServices(rf, newPassword, internalPassword, redisConf(rf, newPassword, internal))
+			ms.On("GetStatefulSet", namespace, mock.Anything).Return(nil, apierrors.NewNotFound(schema.GroupResource{}, ""))
+			ms.On("CreateOrUpdatePodDisruptionBudget", namespace, mock.Anything).Return(nil)
+			var ss *appsv1.StatefulSet
+			ms.On("CreateOrUpdateStatefulSet", namespace, mock.Anything).Run(func(args mock.Arguments) {
+				ss = args.Get(1).(*appsv1.StatefulSet)
+			}).Return(nil)
