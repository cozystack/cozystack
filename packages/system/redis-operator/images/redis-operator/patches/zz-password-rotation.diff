+// Every way the internal user can differ from what the operator set is a
+// repair, and an untouched one is left alone.
+func TestReconcileRedisAuthRepairsEachKindOfInternalUserDrift(t *testing.T) {
+	cases := map[string]func(*redis.UserACL){
+		"intact":             nil,
+		"deleted":            func(a *redis.UserACL) { *a = redis.UserACL{} },
+		"disabled":           func(a *redis.UserACL) { a.On = false },
+		"nopass":             func(a *redis.UserACL) { a.NoPass = true; a.Hashes = nil },
+		"another password":   func(a *redis.UserACL) { a.Hashes = []string{sha("tenant")} },
+		"link password gone": func(a *redis.UserACL) { a.Hashes = []string{sha(internalPassword)} },
+		"pod password gone":  func(a *redis.UserACL) { a.Hashes = []string{sha(linkPassword)} },
+		"commands widened":   func(a *redis.UserACL) { a.Commands = "+@all" },
+		"commands narrowed":  func(a *redis.UserACL) { a.Commands = "-@all +ping" },
+		"keys added":         func(a *redis.UserACL) { a.Keys = "~*" },
+		"channels widened":   func(a *redis.UserACL) { a.Channels = "&*" },
+		"channels removed":   func(a *redis.UserACL) { a.Channels = "" },
+		"selector added":     func(a *redis.UserACL) { a.Selectors = 1 },
+	}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
+			rf := authRF()
+			ms := authServices(rf, newPassword, internalPassword, redisConf(rf, newPassword, internalPassword))
+			mr := &mRedisService.Client{}
+			mr.On("GetDefaultUserPasswords", mock.Anything, "0", newPassword, mock.Anything).Return(redis.DefaultUserPasswords{}, nil)
+			acl := intactACL
+			acl.Hashes = append([]string(nil), intactACL.Hashes...)
+			if change != nil {
+				change(&acl)
+			}
+			mr.On("GetUserACL", mock.Anything, "0", newPassword, "rf-internal", mock.Anything).Return(acl, nil)
+			mr.On("GetUserACL", mock.Anything, "0", newPassword, "rf-exporter", mock.Anything).Return(intactExporterACL, nil)
+			mr.On("GetMasterAuth", mock.Anything, "0", newPassword, mock.Anything).Return("rf-internal", linkPassword, nil)
+			mr.On("GetClientUsers", mock.Anything, "0", newPassword, mock.Anything).Return(sentinelClients, nil)
+			mr.On("SetUserACL", mock.Anything, "0", newPassword, "rf-internal", internalRules, mock.Anything).Return(nil)
+
+			healer := rfservice.NewRedisFailoverHealer(ms, mr, log.Dummy)
+			assert.NoError(t, healer.ReconcileRedisAuth(rf, nil, nil))
+			want := 2
+			if change == nil {
+				want = 0
+			}
+			mr.AssertNumberOfCalls(t, "SetUserACL", want)
+		})
+	}
+}
