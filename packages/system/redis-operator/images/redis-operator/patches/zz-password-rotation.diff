+)
+
+// The password of the auth Secret belongs to the clients: whoever holds the
+// Secret may change it at any time, and a change must reach the servers
+// without restarting anything. So nothing the operator runs authenticates
+// with it except the operator's own checks. Replication, the Sentinels, the
+// probes and the shutdown hook authenticate as internalUser, and the
+// exporter as exporterUser.
+//
+// The internal user has two passwords, kept in its own Secret:
+//
+//   - the pod password (key "password"), which the probes and the shutdown
+//     hook read from their environment at start. It is never rotated, since
+//     that would restart them, and no server ever holds it in clear: it is in
+//     the ACL as a hash only.
+//   - the link password (key "link"), which the servers replicate with
+//     (masterauth) and the Sentinels authenticate with (auth-pass). Anyone
+//     holding the client password can read it with CONFIG GET masterauth,
+//     so it is rotated whenever the client password changes, in stages that
+//     keep the old one valid until nothing uses it any more (see
+//     rotateLinkPassword).
+//
+// The exporter's password (key "exporter") is fixed like the pod password and
+// held by the servers as a hash only. It is the one password that can run
+// CONFIG GET, which reads requirepass and masterauth, so no client password
+// holder can learn it from a server.
+const (
+	internalUser = "rf-internal"
+	exporterUser = "rf-exporter"
+
+	podPasswordKey      = "password"
+	exporterPasswordKey = "exporter"
+	linkPasswordKey     = "link"
+	// linkPreviousKey holds the link password being retired while a rotation
+	// is in flight; it is absent otherwise.
+	linkPreviousKey = "link-previous"
+	// linkIssuedForKey is the hash of the client password in force when the
+	// current link password was generated: holders of that client password,
+	// and of no older one, may have read it.
+	linkIssuedForKey = "client-sha256"
+
+	sentinelHelloChannel = "__sentinel__:hello"
+
+	// pingerUser is the liveness probe's user, from the redis.conf template,
+	// and pingerPassword its password, which the template makes public.
+	pingerUser     = "pinger"
+	pingerPassword = "pingpass"
+)
+
+// operatorUsers are the only ACL users a server keeps. A tenant's default
+// user can create others, and one created before a revoke would keep the
+// tenant in after it. They never survived a restart anyway (no aclfile is
+// configured, so the servers load users from redis.conf alone), so the
+// operator deletes them on every client password change, on every rotation
+// and in the guard. ACL DELUSER also disconnects every client authenticated
+// as the user it deletes.
+var operatorUsers = map[string]bool{"default": true, internalUser: true, exporterUser: true, pingerUser: true}
+
+// internalCommands is every command the internal user may run, and nothing
+// else: it reads no key, no configuration parameter, and uses no channel but
+// the Sentinels' hello channel. AUTH and HELLO need no rule, ACL does not
+// check them. Checked against Redis 7.2.7 and 8.0.2 and Valkey 8.0.2:
+//
+//   - a replica on its master: PING, REPLCONF, PSYNC and SYNC
+//     (replication.c, syncWithMaster and the rdb channel of Redis 8 and
+//     Valkey 8);
+//   - a Sentinel on every server: CLIENT SETNAME, SUBSCRIBE and PUBLISH on
+//     the hello channel, PING, INFO, SCRIPT KILL, and the failover
+//     transaction MULTI, SLAVEOF, CONFIG REWRITE, CLIENT KILL, EXEC
+//     (sentinel.c). A command ACL denies inside MULTI aborts the EXEC, so the
+//     transaction needs every one of them. No Sentinel sends CONFIG GET;
+//   - the readiness probe INFO and the shutdown hook SAVE (generator.go).
+//
+// The operator itself authenticates as the default user, the liveness probe
+// as pinger and the exporter as exporterUser.
+var internalCommands = []string{
+	"ping", "info",
+	"psync", "sync", "replconf",
+	"client|setname", "client|kill", "subscribe", "publish",
+	"multi", "exec", "slaveof", "config|rewrite", "script|kill",
+	"save",
+}
+
+// exporterCommands is every command redis_exporter v1.55.0 sends to a server
+// with the flags the operator starts it with: CLIENT SETNAME
+// (exporter.go:581, set-client-name is on by default), CONFIG GET
+// (exporter.go:587), INFO (exporter.go:597 and 600), LATENCY LATEST and
+// HISTOGRAM (latency.go:27 and 54), SLOWLOG LEN and GET (slowlog.go:9 and
+// 13). PING (ping-on-connect), CLIENT LIST (export-client-list), and the key,
+// stream, count, key-group and Lua checks are off by default and not set,
+// CLUSTER INFO runs on a cluster only and SENTINEL on a Sentinel only. AUTH
+// is not checked, and with no database in REDIS_ADDR there is no SELECT.
+var exporterCommands = []string{
+	"client|setname", "config|get", "info",
+	"latency|latest", "latency|histogram", "slowlog|len", "slowlog|get",
+}
+
+// commandRules is commands as ACL GETUSER reports them back: the server keeps
+// the command rules in the order given, lowercased, after the -@all that
+// starts them.
+func commandRules(commands []string) string {
+	rules := []string{"-@all"}
+	for _, c := range commands {
+		rules = append(rules, "+"+c)
+	}
+	return strings.Join(rules, " ")
+}
+
+func internalCommandRules() string { return commandRules(internalCommands) }
+
+// ErrPasswordRotationPending reports that the running servers and Sentinels
+// could not all be brought onto the internal user, or onto a changed client
+// password and the link password rotated with it. The redis ConfigMap, and
+// with it the pod template, stays as it was until they are, and the checks
+// do not run, so nothing starts relying on credentials a server lacks.
+var ErrPasswordRotationPending = errors.New("redis auth rotation pending")
+
+// ErrMasterMoved reports that the pod roll moved the master role this pass.
+// Whatever the pass read as the master before is stale, so it must end
+// instead of healing towards it.
+var ErrMasterMoved = errors.New("the master role moved")
+
+// GetRedisInternalAuthName is the Secret holding the internal user's
+// passwords.
+func GetRedisInternalAuthName(rf *redisfailoverv1.RedisFailover) string {
+	return GetRedisName(rf) + "-internal"
+}
+
+// internalAuthEnabled tells whether the RedisFailover uses the internal
+// user. A bootstrapping RedisFailover replicates from a master outside it,
+// which knows nothing of that user, so it keeps the upstream behaviour.
+func internalAuthEnabled(rf *redisfailoverv1.RedisFailover) bool {
+	return rf.Spec.Auth.SecretPath != "" && !rf.Bootstrapping()
+}
+
+// appliedConfig is what the redis ConfigMap says every running server has:
+// the ConfigMap moves on only once they do.
+type appliedConfig struct {
+	password string
+	internal bool
+	exporter bool
+}
+
+func appliedRedisConfig(s k8s.Services, rf *redisfailoverv1.RedisFailover) (cfg appliedConfig, found bool, err error) {
+	cm, err := s.GetConfigMap(rf.Namespace, GetRedisName(rf))
+	if apierrors.IsNotFound(err) {
+		return appliedConfig{}, false, nil
+	}
+	if err != nil {
+		return appliedConfig{}, false, err
+	}
+	return parseRedisConfig(cm.Data[redisConfigFileName]), true, nil
+}
+
+// parseRedisConfig reads a redis.conf as generateRedisConfigMap writes it.
+func parseRedisConfig(conf string) appliedConfig {
+	var cfg appliedConfig
+	for _, line := range strings.Split(conf, "\n") {
+		if v, ok := strings.CutPrefix(line, "requirepass "); ok {
+			cfg.password = v
+		}
+		if strings.HasPrefix(line, "user "+internalUser+" ") {
+			cfg.internal = true
+		}
+		if strings.HasPrefix(line, "user "+exporterUser+" ") {
+			cfg.exporter = true
+		}
+	}
+	return cfg
+}
+
+// internalCreds is what the internal Secret holds.
+type internalCreds struct {
+	pod       string
+	exporter  string
+	link      string
+	previous  string
+	issuedFor string
+}
+
+// links is every link password the servers must accept now: the current one
+// and, during a rotation, the one being retired.
+func (c internalCreds) links() []string {
+	if c.previous == "" {
+		return []string{c.link}
+	}
+	return []string{c.previous, c.link}
+}
+
+// readInternalCreds returns the internal Secret and what it holds, or a nil
+// Secret when it does not exist yet.
+func readInternalCreds(s k8s.Services, rf *redisfailoverv1.RedisFailover) (*corev1.Secret, internalCreds, error) {
+	sec, err := s.GetSecret(rf.Namespace, GetRedisInternalAuthName(rf))
+	if apierrors.IsNotFound(err) {
+		return nil, internalCreds{}, nil
+	}
+	if err != nil {
+		return nil, internalCreds{}, err
+	}
+	creds := internalCreds{
+		pod:       string(sec.Data[podPasswordKey]),
+		exporter:  string(sec.Data[exporterPasswordKey]),
+		link:      string(sec.Data[linkPasswordKey]),
+		previous:  string(sec.Data[linkPreviousKey]),
+		issuedFor: string(sec.Data[linkIssuedForKey]),
+	}
+	if creds.pod == "" {
+		return nil, internalCreds{}, fmt.Errorf("secret %q has no %s", sec.Name, podPasswordKey)
+	}
+	return sec, creds, nil
+}
+
+// ensureInternalSecret creates the internal Secret once and returns what it
+// holds. issuedFor is the hash of the client password whose holders can
+// read the link password from the servers once it is in use. The pod and
+// exporter passwords are never rewritten: everything that reads them at
+// start would need a restart.
+func ensureInternalSecret(s k8s.Services, rf *redisfailoverv1.RedisFailover, labels map[string]string, ownerRefs []metav1.OwnerReference, issuedFor string) (internalCreds, error) {
+	sec, creds, err := readInternalCreds(s, rf)
+	if err != nil {
+		return internalCreds{}, err
+	}
+	if sec != nil && creds.link != "" && creds.exporter != "" {
+		return creds, nil
+	}
+	if sec != nil {
+		// A Secret written by an operator version that had no link password,
+		// when the servers replicated with the pod password, or no exporter
+		// user, when the exporter ran as the internal user: add what is
+		// missing. The per-pass checks then move masterauth and the Sentinels
+		// onto the link password, and introduce the exporter user.
+		sec = sec.DeepCopy()
+		if creds.link == "" {
+			if creds.link, err = randomPassword(32); err != nil {
+				return internalCreds{}, err
+			}
+			creds.issuedFor = issuedFor
+			sec.Data[linkPasswordKey] = []byte(creds.link)
+			sec.Data[linkIssuedForKey] = []byte(issuedFor)
+		}
+		if creds.exporter == "" {
+			if creds.exporter, err = randomPassword(32); err != nil {
+				return internalCreds{}, err
+			}
+			sec.Data[exporterPasswordKey] = []byte(creds.exporter)
+		}
+		if err := s.UpdateSecret(rf.Namespace, sec); err != nil {
+			return internalCreds{}, err
+		}
+		return creds, nil
+	}
+	creds = internalCreds{issuedFor: issuedFor}
+	for _, p := range []*string{&creds.pod, &creds.exporter, &creds.link} {
+		if *p, err = randomPassword(32); err != nil {
+			return internalCreds{}, err
+		}
+	}
+	sec = &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:            GetRedisInternalAuthName(rf),
+			Namespace:       rf.Namespace,
+			Labels:          util.MergeLabels(labels, generateSelectorLabels(redisRoleName, rf.Name)),
+			OwnerReferences: ownerRefs,
+		},
+		Type: corev1.SecretTypeOpaque,
+		Data: map[string][]byte{
+			podPasswordKey:      []byte(creds.pod),
+			exporterPasswordKey: []byte(creds.exporter),
+			linkPasswordKey:     []byte(creds.link),
+			linkIssuedForKey:    []byte(issuedFor),
+		},
+	}
+	if err := s.CreateSecret(rf.Namespace, sec); err != nil {
+		return internalCreds{}, err
+	}
+	return creds, nil
+}
+
+// updateInternalSecret re-reads the internal Secret, applies change to a
+// copy and writes it back, so a write lost to a conflict changes nothing.
+func updateInternalSecret(s k8s.Services, rf *redisfailoverv1.RedisFailover, change func(map[string][]byte)) error {
+	sec, _, err := readInternalCreds(s, rf)
+	if err != nil {
+		return err
+	}
+	if sec == nil {
+		return fmt.Errorf("secret %q does not exist", GetRedisInternalAuthName(rf))
+	}
+	sec = sec.DeepCopy()
+	change(sec.Data)
+	return s.UpdateSecret(rf.Namespace, sec)
+}
+
+func randomPassword(n int) (string, error) {
+	const alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
+	out := make([]byte, n)
+	for i := range out {
+		k, err := rand.Int(rand.Reader, big.NewInt(int64(len(alphabet))))
+		if err != nil {
+			return "", err
+		}
+		out[i] = alphabet[k.Int64()]
+	}
+	return string(out), nil
+}
+
+// passwordHash is the form ACL rules and ACL GETUSER use for a password.
+func passwordHash(password string) string {
+	sum := sha256.Sum256([]byte(password))
+	return hex.EncodeToString(sum[:])
+}
+
+// internalUserRules is the ACL rule list of the internal user, for ACL
+// SETUSER after a reset and for the redis.conf user line: on, the pod
+// password and every link password given, no key, the Sentinels' hello
+// channel alone, and internalCommands.
+func internalUserRules(pod string, links ...string) []string {
+	rules := []string{"on", "#" + passwordHash(pod)}
+	for _, l := range links {
+		rules = append(rules, "#"+passwordHash(l))
+	}
+	rules = append(rules, "resetkeys", "resetchannels", "&"+sentinelHelloChannel)
+	return append(rules, strings.Fields(internalCommandRules())...)
+}
+
+// exporterUserRules is the ACL rule list of the exporter user: on, its one
+// password, no key, no channel, and exporterCommands.
+func exporterUserRules(password string) []string {
+	rules := []string{"on", "#" + passwordHash(password), "resetkeys", "resetchannels"}
+	return append(rules, strings.Fields(commandRules(exporterCommands))...)
+}
+
+// pingerUserRules is the pinger line of the redis.conf template as a rule
+// list: on, its public password, PING alone.
+func pingerUserRules() []string {
+	return []string{"on", "#" + passwordHash(pingerPassword), "resetkeys", "resetchannels", "-@all", "+ping"}
+}
+
+// userMatches tells whether acl is exactly a user that is on, with exactly
+// the given passwords, no key, the given channels and commands, and no extra
+// selector.
+func userMatches(acl redis.UserACL, channels, commands string, passwords ...string) bool {
+	if !acl.Exists || !acl.On || acl.NoPass || acl.Selectors != 0 ||
+		acl.Keys != "" || acl.Channels != channels || acl.Commands != commands {
+		return false
+	}
+	want := make([]string, 0, len(passwords))
+	for _, p := range passwords {
+		want = append(want, passwordHash(p))
+	}
+	got := append([]string(nil), acl.Hashes...)
+	sort.Strings(want)
+	sort.Strings(got)
+	return strings.Join(want, ",") == strings.Join(got, ",")
+}
+
+// internalUserMatches tells whether the internal user is exactly what
+// internalUserRules(pod, links...) sets.
+func internalUserMatches(acl redis.UserACL, pod string, links ...string) bool {
+	return userMatches(acl, "&"+sentinelHelloChannel, internalCommandRules(), append([]string{pod}, links...)...)
+}
+
+// exporterUserMatches tells whether the exporter user is exactly what
+// exporterUserRules(password) sets.
+func exporterUserMatches(acl redis.UserACL, password string) bool {
+	return userMatches(acl, "", commandRules(exporterCommands), password)
+}
+
+// ReconcileRedisAuth brings the running servers and Sentinels onto what the
+// redis ConfigMap is about to say, before it says it. It runs in Ensure
+// before the ConfigMap is written.
+//
+// While the ConfigMap has no internal user (a RedisFailover created before
+// this operator version), every running server gets the user and uses it as
+// masteruser/masterauth, and every running Sentinel uses it as
+// auth-user/auth-pass; any failure returns ErrPasswordRotationPending, so
+// the ConfigMap and the pod template, whose probes and exporter switch to
+// the user, wait until every server has it. The exporter user is introduced
+// the same way while the ConfigMap has none (a RedisFailover whose exporter
+// ran as the internal user), so the exporter switches to it only once every
+// server has it.
+//
+// A client password that differs from the ConfigMap's is applied on every
+// running server, authenticating with the new password or, until it is
+// applied, the old one, by changeClientPassword: CONFIG SET requirepass
+// leaves every connection that authenticated with the old password open,
+// and the default user may run CONFIG GET requirepass, so the change
+// disconnects every client but the operator's own links in the same
+// transaction. Holders of the old one may have read the link password, so
+// once every server is on the new one the link password is rotated
+// (rotateLinkPassword). Until both are
+// done the pass returns ErrPasswordRotationPending, so the ConfigMap keeps
+// the old client password and a server restarted meanwhile comes back on
+// credentials the next pass knows. A server that accepts neither client
+// password is deleted (one per pass) to start again from the ConfigMap.
+//
+// Otherwise every pass re-asserts the internal and exporter users
+// (reassertInternalUser):
+// the tenant's default user can run ACL, CONFIG and SENTINEL SET. Nothing a
+// tenant changes outlives a restart either: the servers read redis.conf
+// straight from the ConfigMap volume, which is read-only, so CONFIG REWRITE
+// fails, and no aclfile is configured (ACL SAVE fails, and aclfile cannot be
+// set at runtime).
+//
+// Every step is idempotent and the internal Secret and the ConfigMap record
+// progress, so a pass interrupted at any point is resumed by the next one.
+// The guard does not check a RedisFailover while a pass runs on it.
+func (r *RedisFailoverHealer) ReconcileRedisAuth(rf *redisfailoverv1.RedisFailover, labels map[string]string, ownerRefs []metav1.OwnerReference) error {
+	if !internalAuthEnabled(rf) {
+		r.guard.forget(rf)
+		return nil
+	}
+	defer r.guard.lock(guardKey(rf))()
+
+	desired, err := k8s.GetRedisPassword(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	applied, found, err := appliedRedisConfig(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	// A new link password can be read by whoever holds the client password
+	// the servers run on: the ConfigMap's, or for a new RedisFailover the
+	// one its pods start with.
+	holder := desired
+	if found {
+		holder = applied.password
+	}
+	creds, err := ensureInternalSecret(r.k8sService, rf, labels, ownerRefs, passwordHash(holder))
+	if err != nil {
+		return err
+	}
+	if !found {
+		// A new RedisFailover: its pods start from a ConfigMap that has it all.
+		return nil
+	}
+	tlsConfig, err := tlsConfigFor(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	serverList, err := r.k8sService.GetStatefulSetPods(rf.Namespace, GetRedisName(rf))
+	if err != nil {
+		return err
+	}
+	pods, _ := runningPods(serverList, nil)
+	// known is every address the operator's own links may come from: any
+	// pod of the RedisFailover holding an IP, running or not, so a replica
+	// or Sentinel that is starting or stopping is not taken for a stranger.
+	known := podAddresses(serverList)
+	var sentinels []corev1.Pod
+	if rf.SentinelsAllowed() {
+		sentinelList, err := r.k8sService.GetDeploymentPods(rf.Namespace, GetSentinelName(rf))
+		if err != nil {
+			return err
+		}
+		sentinels, _ = runningPods(sentinelList, nil)
+		for ip := range podAddresses(sentinelList) {
+			known[ip] = true
+		}
+	}
+	port := getRedisPort(rf.Spec.Redis.Port)
+	logger := r.logger.WithField("redisfailover", rf.ObjectMeta.Name).WithField("namespace", rf.ObjectMeta.Namespace)
+
+	if !applied.internal {
+		logger.Infof("Introducing the internal redis user on %d running servers", len(pods))
+		if err := r.introduceInternalUser(pods, sentinels, rf.MasterName(), port, desired, applied.password, creds, tlsConfig); err != nil {
+			return fmt.Errorf("%w: %v", ErrPasswordRotationPending, err)
+		}
+	}
+	if !applied.exporter {
+		logger.Infof("Introducing the exporter's redis user on %d running servers", len(pods))
+		if err := r.introduceExporterUser(pods, port, desired, applied.password, creds, tlsConfig); err != nil {
+			return fmt.Errorf("%w: %v", ErrPasswordRotationPending, err)
+		}
+	}
+
+	rotating := creds.previous != "" || creds.issuedFor != passwordHash(desired)
+	// Outside a rotation, every pass checks that the tenant's default user
+	// moved nothing; a rotation sets all of it anyway.
+	steady := applied.internal && !rotating
+	drifted := map[string]bool{}
+	stale := ""
+	onDesired := true
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		auth, err := r.authenticate(ip, port, desired, applied.password, tlsConfig)
+		if err != nil {
+			onDesired = false
+			if redis.IsAuthError(err) && stale == "" {
+				stale = pod.Name
+			} else if !redis.IsAuthError(err) {
+				logger.Warningf("Could not reach redis %s to check its password: %v", ip, err)
+			}
+			continue
+		}
+		if steady {
+			r.reassertInternalUser(ip, port, auth, creds, sentinels, drifted, tlsConfig, logger)
+		}
+		if auth == desired {
+			continue
+		}
+		if err := r.changeClientPassword(ip, port, auth, desired, creds, tlsConfig, logger); err != nil {
+			onDesired = false
+			logger.Warningf("Could not apply the client password on %s: %v", ip, err)
+		}
+	}
+	for _, sentinel := range sentinels {
+		sip := sentinel.Status.PodIP
+		if !drifted[sip] {
+			continue
+		}
+		logger.Warningf("Sentinel %s does not authenticate as the internal user, setting its auth-user and auth-pass again", sip)
+		if err := r.redisClient.SetSentinelAuth(sip, rf.MasterName(), internalUser, creds.link, tlsConfig); err != nil {
+			logger.Warningf("Could not set the auth of Sentinel %s: %v", sip, err)
+		}
+	}
+
+	target := guardTarget{
+		master:    rf.MasterName(),
+		port:      port,
+		auth:      desired,
+		pod:       creds.pod,
+		links:     creds.links(),
+		servers:   podIPs(pods),
+		sentinels: podIPs(sentinels),
+		tlsConfig: tlsConfig,
+	}
+	if creds.previous == "" {
+		target.sentinelLink = creds.link
+	}
+	var result error
+	switch {
+	case !rotating:
+	case !onDesired:
+		// Until every server refuses the old client password, its holders
+		// could read the new link password: do not put it in masterauth yet.
+		result = fmt.Errorf("%w: not every running server is on the new client password yet", ErrPasswordRotationPending)
+	default:
+		// A rotation resumed after the client password changed again was
+		// issued under the one before: holders of that one may have read it,
+		// so a second rotation follows at once.
+		for i := 0; i < 2 && (creds.previous != "" || creds.issuedFor != passwordHash(desired)); i++ {
+			if err := r.rotateLinkPassword(rf, pods, sentinels, known, port, desired, &creds, &target, tlsConfig, logger); err != nil {
+				result = fmt.Errorf("%w: rotating the link password: %v", ErrPasswordRotationPending, err)
+				break
+			}
+		}
+	}
+	r.guard.track(rf, target)
+
+	if stale != "" {
+		logger.Warningf("Redis pod %s accepts neither the current nor the previous client password, restarting it to read the current config", stale)
+		if err := r.k8sService.DeletePod(rf.Namespace, stale); err != nil {
+			logger.Warningf("Could not delete redis pod %s: %v", stale, err)
+		}
+	}
+	return result
+}
+
+// changeClientPassword moves one server from the client password auth onto
+// desired, and leaves no connection open that authenticated with auth or
+// with anything a holder of auth could have set. In one MULTI/EXEC, so no
+// other client runs a command between its steps:
+//
+//   - the internal, exporter and pinger users are reset to what the operator
+//     sets, which drops any password or command a holder of auth added to
+//     them;
+//   - every ACL user but operatorUsers is deleted, which disconnects whoever
+//     is authenticated as it;
+//   - requirepass becomes desired;
+//   - every connection authenticated as the default user is killed, the
+//     transaction's own aside (CLIENT KILL skips the caller unless told
+//     otherwise), and so is every connection of the exporter user, the one
+//     operator user that may read requirepass.
+//
+// The internal user's replication and Sentinel links and the liveness
+// probe's pinger stay up: neither user may read a configuration parameter,
+// so a connection a holder of auth opened as them learns nothing of
+// desired. Done only for a server still on auth, the step cannot happen
+// twice; one that fails changes nothing and is retried by the next pass.
+func (r *RedisFailoverHealer) changeClientPassword(ip, port, auth, desired string, creds internalCreds, tlsConfig *tls.Config, logger log.Logger) error {
+	users, err := r.redisClient.ListUsers(ip, port, auth, tlsConfig)
+	if err != nil {
+		return fmt.Errorf("list the ACL users on %s: %w", ip, err)
+	}
+	var foreign []string
+	for _, u := range users {
+		if !operatorUsers[u] {
+			foreign = append(foreign, u)
+		}
+	}
+	reset := []redis.ACLUser{
+		{Name: internalUser, Rules: internalUserRules(creds.pod, creds.links()...)},
+		{Name: exporterUser, Rules: exporterUserRules(creds.exporter)},
+		{Name: pingerUser, Rules: pingerUserRules()},
+	}
+	if err := r.redisClient.ChangeClientPassword(ip, port, auth, desired, reset, foreign, []string{"default", exporterUser}, tlsConfig); err != nil {
+		return fmt.Errorf("change the client password: %w", err)
+	}
+	logger.Infof("Applied the client password on %s and disconnected its clients", ip)
+	// A user created between ACL USERS and EXEC: its creator was disconnected
+	// by the transaction, the user goes now.
+	return r.purgeForeignUsers(ip, port, desired, tlsConfig, logger)
+}
+
+// rotateLinkPassword replaces the link password, with no restart and no
+// moment where a server, replica or Sentinel holds a password another server
+// refuses. Each step runs on every running server or Sentinel and must
+// succeed on all of them before the next one starts; a failure ends the pass
+// and the next pass starts again from the first step not recorded in the
+// internal Secret:
+//
+//  1. Generate the new password into the Secret, keeping the old one as
+//     link-previous, and record which client password it is issued under.
+//  2. Every server accepts both: ACL SETUSER with the pod password and both
+//     link passwords.
+//  3. Every server replicates with the new one (masteruser/masterauth).
+//  4. Every Sentinel authenticates with the new one (SENTINEL SET).
+//  5. Every server drops the old one from the ACL, and every ACL user but
+//     operatorUsers (purgeForeignUsers).
+//  6. Every server disconnects the strangers among the operator users'
+//     connections and every MONITOR (killStrayClients).
+//  7. The Secret drops link-previous.
+//
+// Steps 2 to 6 read before they write, so a step done in an earlier pass is
+// only checked again. The caller runs it only once every running server
+// refuses the old client password, so whoever can read the new link
+// password from masterauth holds the current client password.
+func (r *RedisFailoverHealer) rotateLinkPassword(rf *redisfailoverv1.RedisFailover, pods, sentinels []corev1.Pod, known map[string]bool, port, desired string, creds *internalCreds, target *guardTarget, tlsConfig *tls.Config, logger log.Logger) error {
+	if creds.previous == "" {
+		next, err := randomPassword(32)
+		if err != nil {
+			return err
+		}
+		issuedFor := passwordHash(desired)
+		if err := updateInternalSecret(r.k8sService, rf, func(d map[string][]byte) {
+			d[linkPreviousKey] = []byte(creds.link)
+			d[linkPasswordKey] = []byte(next)
+			d[linkIssuedForKey] = []byte(issuedFor)
+		}); err != nil {
+			return fmt.Errorf("record the new link password: %w", err)
+		}
+		creds.previous, creds.link, creds.issuedFor = creds.link, next, issuedFor
+		logger.Infof("Rotating the link password of the internal user on %d servers and %d Sentinels", len(pods), len(sentinels))
+	}
+	// The guard keeps both until the old one is dropped below.
+	target.links = creds.links()
+	target.sentinelLink = ""
+
+	for _, pod := range pods {
+		if err := r.ensureInternalUser(pod.Status.PodIP, port, desired, creds.pod, creds.links(), tlsConfig); err != nil {
+			return err
+		}
+	}
+	// The new password is valid everywhere from here to the end.
+	target.sentinelLink = creds.link
+
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		user, password, err := r.redisClient.GetMasterAuth(ip, port, desired, tlsConfig)
+		if err != nil {
+			return fmt.Errorf("read masteruser on %s: %w", ip, err)
+		}
+		if user == internalUser && password == creds.link {
+			continue
+		}
+		if err := r.redisClient.SetMasterAuth(ip, port, desired, internalUser, creds.link, tlsConfig); err != nil {
+			return fmt.Errorf("replicate with the new link password on %s: %w", ip, err)
+		}
+	}
+
+	// SENTINEL SET offers no way to read auth-pass back, so this is redone
+	// until the rotation is recorded as finished.
+	for _, sentinel := range sentinels {
+		sip := sentinel.Status.PodIP
+		if err := r.redisClient.SetSentinelAuth(sip, rf.MasterName(), internalUser, creds.link, tlsConfig); err != nil {
+			return fmt.Errorf("point the Sentinel %s at the new link password: %w", sip, err)
+		}
+	}
+
+	target.links = []string{creds.link}
+	for _, pod := range pods {
+		if err := r.ensureInternalUser(pod.Status.PodIP, port, desired, creds.pod, []string{creds.link}, tlsConfig); err != nil {
+			return err
+		}
+	}
+
+	for _, pod := range pods {
+		if err := r.purgeForeignUsers(pod.Status.PodIP, port, desired, tlsConfig, logger); err != nil {
+			return err
+		}
+	}
+
+	for _, pod := range pods {
+		if err := r.killStrayClients(pod.Status.PodIP, port, desired, known, tlsConfig, logger); err != nil {
+			return err
+		}
+	}
+
+	if err := updateInternalSecret(r.k8sService, rf, func(d map[string][]byte) {
+		delete(d, linkPreviousKey)
+	}); err != nil {
+		return fmt.Errorf("record the end of the rotation: %w", err)
+	}
+	creds.previous = ""
+	logger.Infof("Rotated the link password of the internal user")
+	return nil
+}
+
+// killStrayClients disconnects, on one server, every connection a holder of
+// an old password could have kept through the change: one authenticated as
+// an operator user from an address that is no pod of the RedisFailover and
+// not the pod itself (a SYNC or PSYNC started with a link password read from
+// masterauth streams every write after a revoke, and the link rotation does
+// not close it), and every connection in MONITOR mode, flag O in CLIENT LIST
+// (catClientInfoString in networking.c of Redis 7.2.7 and 8.0.2 and Valkey
+// 8.0.2), whatever its user: MONITOR is checked by ACL once, when it starts,
+// so one opened as a user that was widened then outlives the reset. Run
+// after the old link password is gone, nobody can open such a connection
+// again without the current client password; run again, it finds nothing.
+func (r *RedisFailoverHealer) killStrayClients(ip, port, auth string, known map[string]bool, tlsConfig *tls.Config, logger log.Logger) error {
+	clients, err := r.redisClient.ListClients(ip, port, auth, tlsConfig)
+	if err != nil {
+		return fmt.Errorf("list the clients of %s: %w", ip, err)
+	}
+	var stray []string
+	for _, c := range clients {
+		monitor := strings.Contains(c.Flags, "O")
+		stranger := operatorUsers[c.User] && c.User != "default" && !known[c.Host] && !isLocalAddress(c.Host)
+		if monitor || stranger {
+			stray = append(stray, c.ID)
+			logger.Warningf("Disconnecting client %s of %s: user %s from %s, flags %s", c.ID, ip, c.User, c.Host, c.Flags)
+		}
+	}
+	if len(stray) == 0 {
+		return nil
+	}
+	if err := r.redisClient.KillClients(ip, port, auth, stray, tlsConfig); err != nil {
+		return fmt.Errorf("disconnect clients %v of %s: %w", stray, ip, err)
+	}
+	return nil
+}
+
+// isLocalAddress tells a connection from inside the pod, as the probes, the
+// shutdown hook and the exporter make, over loopback or a unix socket.
+func isLocalAddress(host string) bool {
+	if strings.HasPrefix(host, "/") {
+		return true
+	}
+	parsed := net.ParseIP(host)
+	return parsed != nil && parsed.IsLoopback()
+}
+
+// podAddresses is the IP of every pod in list that has one.
+func podAddresses(list *corev1.PodList) map[string]bool {
+	out := map[string]bool{}
+	for _, pod := range list.Items {
+		for _, ip := range pod.Status.PodIPs {
+			out[ip.IP] = true
+		}
+		if pod.Status.PodIP != "" {
+			out[pod.Status.PodIP] = true
+		}
+	}
+	return out
+}
+
+// purgeForeignUsers deletes every ACL user on one server but operatorUsers.
+func (r *RedisFailoverHealer) purgeForeignUsers(ip, port, auth string, tlsConfig *tls.Config, logger log.Logger) error {
+	users, err := r.redisClient.ListUsers(ip, port, auth, tlsConfig)
+	if err != nil {
+		return fmt.Errorf("list the ACL users on %s: %w", ip, err)
+	}
+	var foreign []string
+	for _, u := range users {
+		if !operatorUsers[u] {
+			foreign = append(foreign, u)
+		}
+	}
+	if len(foreign) == 0 {
+		return nil
+	}
+	logger.Warningf("Deleting ACL users the operator did not create on %s: %v", ip, foreign)
+	if err := r.redisClient.DeleteUsers(ip, port, auth, foreign, tlsConfig); err != nil {
+		return fmt.Errorf("delete the ACL users %v on %s: %w", foreign, ip, err)
+	}
+	return nil
+}
+
+// ensureInternalUser sets the internal user on one server unless it already
+// is exactly internalUserRules(pod, links...).
+func (r *RedisFailoverHealer) ensureInternalUser(ip, port, auth, pod string, links []string, tlsConfig *tls.Config) error {
+	acl, err := r.redisClient.GetUserACL(ip, port, auth, internalUser, tlsConfig)
+	if err != nil {
+		return fmt.Errorf("read the internal user on %s: %w", ip, err)
+	}
+	if internalUserMatches(acl, pod, links...) {
+		return nil
+	}
+	if err := r.redisClient.SetUserACL(ip, port, auth, internalUser, internalUserRules(pod, links...), tlsConfig); err != nil {
+		return fmt.Errorf("set the internal user on %s: %w", ip, err)
+	}
+	return nil
+}
+
+// reassertInternalUser checks one server against what the operator set and
+// repairs what differs: the exporter user, the internal user (missing, disabled, with another
+// password or a password added next to it, with other rules), and the user
+// and password the server replicates as. It also marks, in drifted, every
+// running Sentinel with a connection to the server authenticated as any
+// other user: the Sentinel's auth-user or auth-pass was changed, and SENTINEL
+// SET offers no way to read them back. Failures are logged and left to the
+// next pass.
+func (r *RedisFailoverHealer) reassertInternalUser(ip, port, auth string, creds internalCreds, sentinels []corev1.Pod, drifted map[string]bool, tlsConfig *tls.Config, logger log.Logger) {
+	if acl, err := r.redisClient.GetUserACL(ip, port, auth, exporterUser, tlsConfig); err != nil {
+		logger.Warningf("Could not read the exporter user on %s: %v", ip, err)
+	} else if !exporterUserMatches(acl, creds.exporter) {
+		logger.Warningf("The exporter user on %s was changed, setting it again", ip)
+		if err := r.redisClient.SetUserACL(ip, port, auth, exporterUser, exporterUserRules(creds.exporter), tlsConfig); err != nil {
+			logger.Warningf("Could not set the exporter user on %s: %v", ip, err)
+		}
+	}
+
+	acl, err := r.redisClient.GetUserACL(ip, port, auth, internalUser, tlsConfig)
+	if err != nil {
+		logger.Warningf("Could not read the internal user on %s: %v", ip, err)
+	} else if !internalUserMatches(acl, creds.pod, creds.link) {
+		logger.Warningf("The internal user on %s was changed, setting it again", ip)
+		// SetUserACL resets the user first, so a password added next to the
+		// operator's does not stay valid.
+		if err := r.redisClient.SetUserACL(ip, port, auth, internalUser, internalUserRules(creds.pod, creds.link), tlsConfig); err != nil {
+			logger.Warningf("Could not set the internal user on %s: %v", ip, err)
+		}
+	}
+
+	user, password, err := r.redisClient.GetMasterAuth(ip, port, auth, tlsConfig)
+	if err != nil {
+		logger.Warningf("Could not read masteruser on %s: %v", ip, err)
+	} else if user != internalUser || password != creds.link {
+		logger.Warningf("Redis %s does not replicate as the internal user, setting masteruser and masterauth again", ip)
+		if err := r.redisClient.SetMasterAuth(ip, port, auth, internalUser, creds.link, tlsConfig); err != nil {
+			logger.Warningf("Could not set masteruser on %s: %v", ip, err)
+		}
+	}
+
+	if len(sentinels) == 0 {
+		return
+	}
+	clients, err := r.redisClient.GetClientUsers(ip, port, auth, tlsConfig)
+	if err != nil {
+		logger.Warningf("Could not list the clients of %s: %v", ip, err)
+		return
+	}
+	for _, sentinel := range sentinels {
+		for _, u := range clients[sentinel.Status.PodIP] {
+			if u != internalUser {
+				drifted[sentinel.Status.PodIP] = true
+			}
+		}
+	}
+}
+
+// introduceInternalUser creates the internal user on every running server
+// before any of them replicates as it, and points the Sentinels at it only
+// once every server has it. Mid-rotation (a pass that introduced the user
+// and then failed to rotate), the servers and Sentinels take the link
+// password being retired, which the rotation then moves them off.
+func (r *RedisFailoverHealer) introduceInternalUser(pods, sentinels []corev1.Pod, master, port, desired, applied string, creds internalCreds, tlsConfig *tls.Config) error {
+	link := creds.link
+	if creds.previous != "" {
+		link = creds.previous
+	}
+	auths := make([]string, len(pods))
+	for i, pod := range pods {
+		ip := pod.Status.PodIP
+		auth, err := r.authenticate(ip, port, desired, applied, tlsConfig)
+		if err != nil {
+			return fmt.Errorf("authenticate to %s: %w", ip, err)
+		}
+		auths[i] = auth
+		if err := r.redisClient.SetUserACL(ip, port, auth, internalUser, internalUserRules(creds.pod, creds.links()...), tlsConfig); err != nil {
+			return fmt.Errorf("create the internal user on %s: %w", ip, err)
+		}
+	}
+	for i, pod := range pods {
+		ip := pod.Status.PodIP
+		if err := r.redisClient.SetMasterAuth(ip, port, auths[i], internalUser, link, tlsConfig); err != nil {
+			return fmt.Errorf("replicate as the internal user on %s: %w", ip, err)
+		}
+	}
+	for _, pod := range sentinels {
+		ip := pod.Status.PodIP
+		if err := r.redisClient.SetSentinelAuth(ip, master, internalUser, link, tlsConfig); err != nil {
+			return fmt.Errorf("point the Sentinel %s at the internal user: %w", ip, err)
+		}
+	}
+	return nil
+}
+
+// introduceExporterUser creates the exporter user on every running server,
+// so the exporter, which runs as the internal user until the ConfigMap has
+// the exporter user, finds it on whichever server it starts next to.
+func (r *RedisFailoverHealer) introduceExporterUser(pods []corev1.Pod, port, desired, applied string, creds internalCreds, tlsConfig *tls.Config) error {
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		auth, err := r.authenticate(ip, port, desired, applied, tlsConfig)
+		if err != nil {
+			return fmt.Errorf("authenticate to %s: %w", ip, err)
+		}
+		if err := r.redisClient.SetUserACL(ip, port, auth, exporterUser, exporterUserRules(creds.exporter), tlsConfig); err != nil {
+			return fmt.Errorf("create the exporter user on %s: %w", ip, err)
+		}
+	}
+	return nil
+}
+
+// authenticate returns which of the client passwords the server accepts,
+// the new one first. An error for which redis.IsAuthError holds means it
+// accepts neither.
+func (r *RedisFailoverHealer) authenticate(ip, port, desired, applied string, tlsConfig *tls.Config) (string, error) {
+	_, err := r.redisClient.GetDefaultUserPasswords(ip, port, desired, tlsConfig)
+	if err == nil || !redis.IsAuthError(err) || applied == "" || applied == desired {
+		return desired, err
+	}
+	if _, err := r.redisClient.GetDefaultUserPasswords(ip, port, applied, tlsConfig); err != nil {
+		return "", err
+	}
+	return applied, nil
+}
+
+// sentinelAuth is what the Sentinels authenticate to the servers with: the
+// internal user and its link password once the ConfigMap says every server
+// has it, the client password before that and on a bootstrapping
+// RedisFailover.
+func sentinelAuth(s k8s.Services, rf *redisfailoverv1.RedisFailover) (user, password string, err error) {
+	if internalAuthEnabled(rf) {
+		applied, _, err := appliedRedisConfig(s, rf)
+		if err != nil {
+			return "", "", err
+		}
+		if applied.internal {
+			_, creds, err := readInternalCreds(s, rf)
+			if err != nil {
+				return "", "", err
+			}
+			if creds.link != "" {
+				return internalUser, creds.link, nil
+			}
+		}
+	}
+	password, err = k8s.GetRedisPassword(s, rf)
+	return "", password, err
+}
+
+// useInternalAuth points the REDIS_USER and REDIS_PASSWORD of every
+// container at the internal user, and those of the exporter at the exporter
+// user once exporter says every server has it, so the probes, the shutdown
+// hook and the exporter keep working whatever the client password becomes.
+func useInternalAuth(spec *corev1.PodSpec, rf *redisfailoverv1.RedisFailover, exporter bool) {
+	fix := func(cs []corev1.Container) {
+		for i := range cs {
+			user, key := internalUser, podPasswordKey
+			if exporter && cs[i].Name == exporterContainerName {
+				user, key = exporterUser, exporterPasswordKey
+			}
+			for j := range cs[i].Env {
+				env := &cs[i].Env[j]
+				switch env.Name {
+				case "REDIS_USER":
+					env.Value = user
+				case "REDIS_PASSWORD":
+					env.ValueFrom = &corev1.EnvVarSource{SecretKeyRef: &corev1.SecretKeySelector{
+						LocalObjectReference: corev1.LocalObjectReference{Name: GetRedisInternalAuthName(rf)},
+						Key:                  key,
+					}}
+				}
+			}
+		}
+	}
+	fix(spec.Containers)
+	fix(spec.InitContainers)
+}
+
+// FailoverMaster moves the master role off the current master with SENTINEL
+// FAILOVER, waits for the Sentinels to name another one, and relabels the
+// pods, so the master Service follows at once rather than at the next check.
+// The pod roll calls it instead of deleting a stale master: the old master
+// is then a replica, and is rolled as one on a later pass, so writes pause
+// only for the switch instead of for failure detection.
+func (r *RedisFailoverHealer) FailoverMaster(rf *redisfailoverv1.RedisFailover) error {
+	tlsConfig, err := tlsConfigFor(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	sentinels, err := runningPods(r.k8sService.GetDeploymentPods(rf.Namespace, GetSentinelName(rf)))
+	if err != nil {
+		return err
+	}
+	if len(sentinels) == 0 {
+		return errors.New("no running Sentinel to fail the master over")
+	}
+	sip := sentinels[0].Status.PodIP
+	old, _, err := r.redisClient.GetSentinelMonitor(sip, rf.MasterName(), tlsConfig)
+	if err != nil {
+		return err
+	}
+	r.logger.WithField("redisfailover", rf.ObjectMeta.Name).WithField("namespace", rf.ObjectMeta.Namespace).Infof("Moving the master role off %s before rolling it", old)
+	if err := r.redisClient.SentinelFailover(sip, rf.MasterName(), tlsConfig); err != nil && !strings.Contains(err.Error(), "INPROG") {
+		return err
+	}
+	current := old
+	for deadline := time.Now().Add(failoverTimeout); current == old; {
+		if time.Now().After(deadline) {
+			return fmt.Errorf("the Sentinels still name %s as master %s after the failover", old, failoverTimeout)
+		}
+		time.Sleep(failoverPoll)
+		if current, _, err = r.redisClient.GetSentinelMonitor(sip, rf.MasterName(), tlsConfig); err != nil {
+			return err
+		}
+	}
+	pods, err := runningPods(r.k8sService.GetStatefulSetPods(rf.Namespace, GetRedisName(rf)))
+	if err != nil {
+		return err
+	}
+	// The master label first, so the master Service never selects nothing.
+	for _, pod := range pods {
+		if pod.Status.PodIP == current {
+			if err := r.setMasterLabelIfNecessary(rf.Namespace, pod); err != nil {
+				return err
+			}
+		}
+	}
+	for _, pod := range pods {
+		if pod.Status.PodIP != current {
+			if err := r.setSlaveLabelIfNecessary(rf.Namespace, pod); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// Variables so the tests need not wait.
+var (
+	failoverTimeout = 30 * time.Second
+	failoverPoll    = 500 * time.Millisecond
+)
+
+// runningPods keeps the pods that are running, not being deleted, and have
+// an IP, the ones a server or Sentinel can be reached on.
+func runningPods(list *corev1.PodList, err error) ([]corev1.Pod, error) {
+	if err != nil {
+		return nil, err
+	}
+	var pods []corev1.Pod
+	for _, pod := range list.Items {
+		if pod.Status.Phase == corev1.PodRunning && pod.DeletionTimestamp == nil && pod.Status.PodIP != "" {
+			pods = append(pods, pod)
+		}
+	}
+	return pods, nil
+}
+
+func podIPs(pods []corev1.Pod) []string {
+	ips := make([]string, 0, len(pods))
+	for _, pod := range pods {
+		ips = append(ips, pod.Status.PodIP)
+	}
+	return ips
+}
+
+// ResolveMultipleMasters settles two or more masters on the one a quorum of
+// the running Sentinels names, by making every other server its replica.
+// That master is where the Sentinels send clients, so the writes the others
+// took since the split are the ones lost, as they would be by hand. With no
+// quorum, or a quorum on a server that is not a master, it changes nothing
+// and returns an error.
+func (r *RedisFailoverHealer) ResolveMultipleMasters(rf *redisfailoverv1.RedisFailover) error {
+	tlsConfig, err := tlsConfigFor(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	sentinels, err := runningPods(r.k8sService.GetDeploymentPods(rf.Namespace, GetSentinelName(rf)))
+	if err != nil {
+		return err
+	}
+	votes := map[string]int{}
+	for _, sentinel := range sentinels {
+		ip, _, err := r.redisClient.GetSentinelMonitor(sentinel.Status.PodIP, rf.MasterName(), tlsConfig)
+		if err != nil {
+			continue
+		}
+		votes[ip]++
+	}
+	quorum := int(getQuorum(rf))
+	chosen := ""
+	for ip, n := range votes {
+		if n >= quorum {
+			chosen = ip
+		}
+	}
+	if chosen == "" {
+		return fmt.Errorf("no master is named by a quorum of %d Sentinels (votes %v)", quorum, votes)
+	}
+	pods, err := runningPods(r.k8sService.GetStatefulSetPods(rf.Namespace, GetRedisName(rf)))
+	if err != nil {
+		return err
+	}
+	password, err := k8s.GetRedisPassword(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	port := getRedisPort(rf.Spec.Redis.Port)
+	known := false
+	for _, pod := range pods {
+		if pod.Status.PodIP == chosen {
+			known = true
+		}
+	}
+	if !known {
+		return fmt.Errorf("the Sentinels name %s, which is no running redis pod", chosen)
+	}
+	if isMaster, err := r.redisClient.IsMaster(chosen, port, password, tlsConfig); err != nil || !isMaster {
+		return fmt.Errorf("the Sentinels name %s, which is not a master (%v)", chosen, err)
+	}
+	r.logger.WithField("redisfailover", rf.ObjectMeta.Name).WithField("namespace", rf.ObjectMeta.Namespace).Warningf("More than one master; a quorum of Sentinels names %s, making the others its replicas", chosen)
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		if ip == chosen {
+			continue
+		}
+		isMaster, err := r.redisClient.IsMaster(ip, port, password, tlsConfig)
+		if err != nil {
+			return err
+		}
+		if !isMaster {
+			continue
+		}
+		if err := r.redisClient.MakeSlaveOfWithPort(ip, port, chosen, port, password, tlsConfig); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// internalUserGuard re-asserts the internal user between reconcile passes.
+// A tenant's ACL DELUSER rf-internal on the master makes the Sentinels fail
+// it over once their links have gone without a valid reply for
+// down-after-milliseconds (5 s by default); the reconcile pass comes every
+// 30 s. The guard checks every server every guardInterval with only what
+// the last pass left in memory, so it costs no API call, and puts the user
+// back early enough for the Sentinels' reconnect to authenticate.
+type internalUserGuard struct {
+	mu      sync.Mutex
+	targets map[string]guardTarget
+	// locks holds, per RedisFailover, the lock a reconcile pass and the
+	// guard both take, so the guard never acts on what a rotation is
+	// changing under it.
+	locks map[string]*sync.Mutex
+}
+
+func guardKey(rf *redisfailoverv1.RedisFailover) string {
+	return rf.Namespace + "/" + rf.Name
+}
+
+// lock takes the lock of one RedisFailover and returns its unlock.
+func (g *internalUserGuard) lock(key string) func() {
+	g.mu.Lock()
+	m, ok := g.locks[key]
+	if !ok {
+		m = &sync.Mutex{}
+		g.locks[key] = m
+	}
+	g.mu.Unlock()
+	m.Lock()
+	return m.Unlock
+}
+
+// guardTarget is what the last pass left: the internal user must have the
+// pod password and exactly the link passwords in links (two during a
+// rotation). sentinelLink is the link password valid on every server, to
+// re-send to the Sentinels after a repair, or empty when a rotation stopped
+// before that is known.
+type guardTarget struct {
+	master       string
+	port         string
+	auth         string
+	pod          string
+	links        []string
+	sentinelLink string
+	servers      []string
+	sentinels    []string
+	tlsConfig    *tls.Config
+	seen         time.Time
+}
+
+var (
+	guardInterval = 2 * time.Second
+	// guardTTL drops a RedisFailover no pass has refreshed for this long, as
+	// after it was deleted or this operator lost the leadership.
+	guardTTL = 5 * time.Minute
+	guardNow = time.Now
+)
+
+func newInternalUserGuard() *internalUserGuard {
+	return &internalUserGuard{targets: map[string]guardTarget{}, locks: map[string]*sync.Mutex{}}
+}
+
+func (g *internalUserGuard) track(rf *redisfailoverv1.RedisFailover, t guardTarget) {
+	t.seen = guardNow()
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.targets[guardKey(rf)] = t
+}
+
+func (g *internalUserGuard) forget(rf *redisfailoverv1.RedisFailover) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	delete(g.targets, guardKey(rf))
+}
+
+func (g *internalUserGuard) snapshot() map[string]guardTarget {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	out := make(map[string]guardTarget, len(g.targets))
+	for k, t := range g.targets {
+		if guardNow().Sub(t.seen) > guardTTL {
+			delete(g.targets, k)
+			continue
+		}
+		out[k] = t
+	}
+	return out
+}
+
+// RunInternalUserGuard calls GuardInternalUsersOnce every guardInterval
+// until stop is closed.
+func (r *RedisFailoverHealer) RunInternalUserGuard(stop <-chan struct{}) {
+	ticker := time.NewTicker(guardInterval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			r.GuardInternalUsersOnce()
+		}
+	}
+}
+
+// GuardInternalUsersOnce deletes every ACL user but operatorUsers and checks
+// the internal user on every server of every tracked RedisFailover, and
+// resets it where it differs. When it reset one,
+// it also sets the auth of every Sentinel again: that drops the Sentinel's
+// links, which may sit unauthenticated since the user went away, so they
+// reconnect and authenticate now instead of after down-after-milliseconds/2.
+// During a rotation the user it restores carries both link passwords, and
+// the Sentinels get only a link password every server accepts. A server it
+// cannot reach, or that no longer takes the password the last pass saw (a
+// mint in between), is left to the next pass.
+func (r *RedisFailoverHealer) GuardInternalUsersOnce() {
+	for key := range r.guard.snapshot() {
+		r.guardOne(key)
+	}
+}
+
+// guardOne checks one RedisFailover under its lock, with what the last pass
+// left once that pass is over.
+func (r *RedisFailoverHealer) guardOne(key string) {
+	defer r.guard.lock(key)()
+	t, ok := r.guard.snapshot()[key]
+	if !ok {
+		return
+	}
+	repaired := false
+	for _, ip := range t.servers {
+		if err := r.purgeForeignUsers(ip, t.port, t.auth, t.tlsConfig, r.logger); err != nil {
+			r.logger.Warningf("Could not delete foreign ACL users of %s: %v", key, err)
+		}
+		acl, err := r.redisClient.GetUserACL(ip, t.port, t.auth, internalUser, t.tlsConfig)
+		if err != nil || internalUserMatches(acl, t.pod, t.links...) {
+			continue
+		}
+		r.logger.Warningf("The internal user on %s of %s was changed, setting it again", ip, key)
+		if err := r.redisClient.SetUserACL(ip, t.port, t.auth, internalUser, internalUserRules(t.pod, t.links...), t.tlsConfig); err != nil {
+			r.logger.Warningf("Could not set the internal user on %s of %s: %v", ip, key, err)
+			continue
+		}
+		repaired = true
+	}
+	if !repaired || t.sentinelLink == "" {
+		return
+	}
+	for _, sip := range t.sentinels {
+		if err := r.redisClient.SetSentinelAuth(sip, t.master, internalUser, t.sentinelLink, t.tlsConfig); err != nil {
+			r.logger.Warningf("Could not set the auth of Sentinel %s of %s: %v", sip, key, err)
+		}
+	}
+}
