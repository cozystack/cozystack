+package service
+
+import "time"
+
+// SetFailoverTiming shortens FailoverMaster's wait for the tests and returns
+// a function restoring it.
+func SetFailoverTiming(timeout, poll time.Duration) func() {
+	oldTimeout, oldPoll := failoverTimeout, failoverPoll
+	failoverTimeout, failoverPoll = timeout, poll
+	return func() { failoverTimeout, failoverPoll = oldTimeout, oldPoll }
+}
+
+// GenerateRedisConfigMapForTest exposes generateRedisConfigMap.
+var GenerateRedisConfigMapForTest = generateRedisConfigMap
+
+// SetGuardNow replaces the guard's clock and returns a function restoring it.
+func SetGuardNow(now func() time.Time) func() {
+	old := guardNow
+	guardNow = now
+	return func() { guardNow = old }
+}
