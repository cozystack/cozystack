+// threeSentinels adds a third running Sentinel, so a quorum of two can
+// outvote one.
+func threeSentinels(ms *mK8SService.Services, rf *redisfailoverv1.RedisFailover) {
+	ms.ExpectedCalls = removeCall(ms.ExpectedCalls, "GetDeploymentPods")
+	ms.On("GetDeploymentPods", namespace, rfservice.GetSentinelName(rf)).Return(&corev1.PodList{Items: []corev1.Pod{
+		runningPod("rfs-0", "10.0.1.1"),
+		runningPod("rfs-1", "10.0.1.2"),
+		runningPod("rfs-2", "10.0.1.3"),
+	}}, nil)
+}
+
+func removeCall(calls []*mock.Call, method string) []*mock.Call {
+	out := calls[:0]
+	for _, c := range calls {
+		if c.Method != method {
+			out = append(out, c)
+		}
+	}
+	return out
+}
