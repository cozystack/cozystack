+func runningPod(name, ip string) corev1.Pod {
+	return corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: name},
+		Status:     corev1.PodStatus{Phase: corev1.PodRunning, PodIP: ip},
+	}
+}
+
+// redisConf is the redis.conf the ConfigMap holds: the client password and,
+// with internal set, the internal user with internal as its pod password and
+// linkPassword as its link password, and the exporter user with
+// exporterPassword.
+func redisConf(rf *redisfailoverv1.RedisFailover, client, internal string) string {
+	link, exporter := "", ""
+	if internal != "" {
+		link, exporter = linkPassword, exporterPassword
+	}
+	return rfservice.GenerateRedisConfigMapForTest(rf, nil, nil, client, internal, link, exporter).Data["redis.conf"]
+}
+
+// redisConfWithoutExporter is the redis.conf of an operator version whose
+// exporter ran as the internal user.
+func redisConfWithoutExporter(rf *redisfailoverv1.RedisFailover, client string) string {
+	return rfservice.GenerateRedisConfigMapForTest(rf, nil, nil, client, internalPassword, linkPassword, "").Data["redis.conf"]
+}
+
+// authServices serves the client Secret, the internal Secret (unless
+// internal is empty) with linkPassword issued under the client password, the
+// redis ConfigMap (unless conf is empty), two running redis pods next to a
+// pending one, and two running Sentinels.
+func authServices(rf *redisfailoverv1.RedisFailover, client, internal, conf string) *mK8SService.Services {
+	ms := &mK8SService.Services{}
+	ms.On("GetSecret", namespace, authSecret).Return(&corev1.Secret{Data: map[string][]byte{"password": []byte(client)}}, nil)
+	if internal != "" {
+		ms.On("GetSecret", namespace, internalSecret).Return(&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: internalSecret}, Data: map[string][]byte{
+			"password":      []byte(internal),
+			"exporter":      []byte(exporterPassword),
+			"link":          []byte(linkPassword),
+			"client-sha256": []byte(sha(client)),
+		}}, nil)
+	} else {
+		ms.On("GetSecret", namespace, internalSecret).Return(nil, apierrors.NewNotFound(schema.GroupResource{}, ""))
+	}
+	if conf != "" {
+		ms.On("GetConfigMap", namespace, rfservice.GetRedisName(rf)).Return(&corev1.ConfigMap{Data: map[string]string{"redis.conf": conf}}, nil)
+	} else {
+		ms.On("GetConfigMap", namespace, rfservice.GetRedisName(rf)).Return(nil, apierrors.NewNotFound(schema.GroupResource{}, ""))
+	}
+	ms.On("GetStatefulSetPods", namespace, rfservice.GetRedisName(rf)).Return(&corev1.PodList{Items: []corev1.Pod{
+		runningPod("rfr-0", "10.0.0.1"),
+		runningPod("rfr-1", "10.0.0.2"),
+		{ObjectMeta: metav1.ObjectMeta{Name: "rfr-2"}, Status: corev1.PodStatus{Phase: corev1.PodPending}},
+	}}, nil)
+	ms.On("GetDeploymentPods", namespace, rfservice.GetSentinelName(rf)).Return(&corev1.PodList{Items: []corev1.Pod{
+		runningPod("rfs-0", "10.0.1.1"),
+		runningPod("rfs-1", "10.0.1.2"),
+	}}, nil)
+	return ms
+}
+
+// recorder keeps the order of the calls that change a server or Sentinel.
+type recorder []string
+
+func (r *recorder) add(format string, args ...interface{}) func(mock.Arguments) {
+	return func(mock.Arguments) { *r = append(*r, fmt.Sprintf(format, args...)) }
+}
+
+// internalCommandRules is spelled out rather than derived, so a change to
+// what the internal user may run shows up here.
+// It reads no configuration parameter: CONFIG GET is the exporter's alone.
+const internalCommandRules = "-@all +ping +info +psync +sync +replconf +client|setname +client|kill +subscribe +publish +multi +exec +slaveof +config|rewrite +script|kill +save"
+
+// exporterCommandRules is spelled out for the same reason.
+const exporterCommandRules = "-@all +client|setname +config|get +info +latency|latest +latency|histogram +slowlog|len +slowlog|get"
+
+var exporterRules = strings.Fields("on #" + sha(exporterPassword) + " resetkeys resetchannels " + exporterCommandRules)
+
+var pingerRules = strings.Fields("on #" + sha("pingpass") + " resetkeys resetchannels -@all +ping")
+
+// intactExporterACL is what ACL GETUSER reports for an untouched exporter
+// user.
+var intactExporterACL = redis.UserACL{Exists: true, On: true, Hashes: []string{sha(exporterPassword)}, Commands: exporterCommandRules}
+
+var internalRules = strings.Fields("on #" + sha(internalPassword) + " #" + sha(linkPassword) + " resetkeys resetchannels &__sentinel__:hello " + internalCommandRules)
+
+// intactACL is what ACL GETUSER reports for an untouched internal user.
+var intactACL = redis.UserACL{Exists: true, On: true, Hashes: []string{sha(internalPassword), sha(linkPassword)}, Keys: "", Channels: "&__sentinel__:hello", Commands: internalCommandRules}
+
+// sentinelClients is a server's CLIENT LIST as both running Sentinels leave
+// it when they authenticate as the internal user.
+var sentinelClients = map[string][]string{"10.0.1.1": {"rf-internal", "rf-internal"}, "10.0.1.2": {"rf-internal", "rf-internal"}}
+
+// intactServer answers the per-pass checks of a server nothing tampered with.
+func intactServer(mr *mRedisService.Client, ip, auth string) {
+	mr.On("GetUserACL", ip, "0", auth, "rf-exporter", mock.Anything).Return(intactExporterACL, nil)
+	mr.On("GetUserACL", ip, "0", auth, "rf-internal", mock.Anything).Return(intactACL, nil)
+	mr.On("GetMasterAuth", ip, "0", auth, mock.Anything).Return("rf-internal", linkPassword, nil)
+	mr.On("GetClientUsers", ip, "0", auth, mock.Anything).Return(sentinelClients, nil)
+}
