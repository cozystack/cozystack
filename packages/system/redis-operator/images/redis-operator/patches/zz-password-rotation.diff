+// DefaultUserPasswords is what ACL GETUSER reports about the passwords of
+// the default user: the SHA-256 hex of each password it accepts, and whether
+// it accepts any password at all (nopass).
+type DefaultUserPasswords struct {
+	Hashes []string
+	NoPass bool
+}
+
+// IsAuthError tells a server that refused the password, and so runs on
+// another one, from one that could not be reached or failed otherwise.
+func IsAuthError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := err.Error()
+	return strings.Contains(msg, "WRONGPASS") || strings.Contains(msg, "NOAUTH") || strings.Contains(msg, "invalid password")
+}
+
+// GetDefaultUserPasswords authenticates with password and reads the
+// passwords of the default user. An error for which IsAuthError holds means
+// the server does not accept password.
+func (c *client) GetDefaultUserPasswords(ip, port, password string, tlsConfig *tls.Config) (DefaultUserPasswords, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  password,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	res, err := rClient.Do(context.TODO(), "ACL", "GETUSER", "default").Result()
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return DefaultUserPasswords{}, err
+	}
+	return parseDefaultUser(res)
+}
+
+// parseDefaultUser reads the RESP2 reply of ACL GETUSER: a flat list of
+// field names, each followed by its value.
+func parseDefaultUser(res interface{}) (DefaultUserPasswords, error) {
+	fields, ok := res.([]interface{})
+	if !ok {
+		return DefaultUserPasswords{}, fmt.Errorf("unexpected ACL GETUSER reply %T", res)
+	}
+	var out DefaultUserPasswords
+	for i := 0; i+1 < len(fields); i += 2 {
+		name, _ := fields[i].(string)
+		values, _ := fields[i+1].([]interface{})
+		switch name {
+		case "flags":
+			for _, v := range values {
+				if f, _ := v.(string); f == "nopass" {
+					out.NoPass = true
+				}
+			}
+		case "passwords":
+			for _, v := range values {
+				if h, ok := v.(string); ok {
+					out.Hashes = append(out.Hashes, h)
+				}
+			}
+		}
+	}
+	return out, nil
+}
+
+// UserACL is what ACL GETUSER reports about a user. Keys, Channels and
+// Commands are the root rules as one space-separated string each, whichever
+// shape (a string in Redis 7 and Valkey, a list in Redis 6) the server uses.
+type UserACL struct {
+	Exists    bool
+	On        bool
+	NoPass    bool
+	Hashes    []string
+	Keys      string
+	Channels  string
+	Commands  string
+	Selectors int
+}
+
+func aclString(v interface{}) string {
+	switch t := v.(type) {
+	case string:
+		return t
+	case []interface{}:
+		parts := make([]string, 0, len(t))
+		for _, p := range t {
+			if s, ok := p.(string); ok {
+				parts = append(parts, s)
+			}
+		}
+		return strings.Join(parts, " ")
+	}
+	return ""
+}
+
+// parseUserACL reads the RESP2 reply of ACL GETUSER; nil means no such user.
+func parseUserACL(res interface{}) (UserACL, error) {
+	if res == nil {
+		return UserACL{}, nil
+	}
+	fields, ok := res.([]interface{})
+	if !ok {
+		return UserACL{}, fmt.Errorf("unexpected ACL GETUSER reply %T", res)
+	}
+	out := UserACL{Exists: true}
+	for i := 0; i+1 < len(fields); i += 2 {
+		name, _ := fields[i].(string)
+		switch name {
+		case "flags":
+			values, _ := fields[i+1].([]interface{})
+			for _, v := range values {
+				switch f, _ := v.(string); f {
+				case "on":
+					out.On = true
+				case "nopass":
+					out.NoPass = true
+				}
+			}
+		case "passwords":
+			values, _ := fields[i+1].([]interface{})
+			for _, v := range values {
+				if h, ok := v.(string); ok {
+					out.Hashes = append(out.Hashes, h)
+				}
+			}
+		case "keys":
+			out.Keys = aclString(fields[i+1])
+		case "channels":
+			out.Channels = aclString(fields[i+1])
+		case "commands":
+			out.Commands = aclString(fields[i+1])
+		case "selectors":
+			values, _ := fields[i+1].([]interface{})
+			out.Selectors = len(values)
+		}
+	}
+	return out, nil
+}
+
+// GetUserACL authenticates as the default user with auth and reads the ACL
+// of user.
+func (c *client) GetUserACL(ip, port, auth, user string, tlsConfig *tls.Config) (UserACL, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	res, err := rClient.Do(context.TODO(), "ACL", "GETUSER", user).Result()
+	if err == rediscli.Nil {
+		return UserACL{}, nil
+	}
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return UserACL{}, err
+	}
+	return parseUserACL(res)
+}
+
+// GetMasterAuth reads the user and password the server replicates as.
+func (c *client) GetMasterAuth(ip, port, auth string, tlsConfig *tls.Config) (string, string, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	res, err := rClient.ConfigGet(context.TODO(), "master*").Result()
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return "", "", err
+	}
+	values := map[string]string{}
+	for i := 0; i+1 < len(res); i += 2 {
+		k, _ := res[i].(string)
+		v, _ := res[i+1].(string)
+		values[k] = v
+	}
+	return values["masteruser"], values["masterauth"], nil
+}
+
+// GetClientUsers maps the IP of every client connected to the server to the
+// users its connections are authenticated as, from CLIENT LIST.
+func (c *client) GetClientUsers(ip, port, auth string, tlsConfig *tls.Config) (map[string][]string, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	list, err := rClient.ClientList(context.TODO()).Result()
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return nil, err
+	}
+	return parseClientUsers(list), nil
+}
+
+// ClientInfo is one line of CLIENT LIST: the connection's id, the host it
+// comes from, the user it is authenticated as, and its flags.
+type ClientInfo struct {
+	ID, Host, User, Flags string
+}
+
+// ListClients authenticates as the default user with auth and returns every
+// connection of the server, from CLIENT LIST.
+func (c *client) ListClients(ip, port, auth string, tlsConfig *tls.Config) ([]ClientInfo, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	list, err := rClient.ClientList(context.TODO()).Result()
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return nil, err
+	}
+	return parseClients(list), nil
+}
+
+func parseClients(list string) []ClientInfo {
+	var out []ClientInfo
+	for _, line := range strings.Split(list, "\n") {
+		var info ClientInfo
+		var addr string
+		for _, field := range strings.Fields(line) {
+			k, v, ok := strings.Cut(field, "=")
+			if !ok {
+				continue
+			}
+			switch k {
+			case "id":
+				info.ID = v
+			case "addr":
+				addr = v
+			case "user":
+				info.User = v
+			case "flags":
+				info.Flags = v
+			}
+		}
+		if info.ID == "" || addr == "" {
+			continue
+		}
+		// A unix socket connection shows the socket path, with :0 appended.
+		if host, _, err := net.SplitHostPort(addr); err == nil {
+			info.Host = host
+		} else {
+			info.Host = strings.TrimSuffix(addr, ":0")
+		}
+		out = append(out, info)
+	}
+	return out
+}
+
+// KillClients authenticates as the default user with auth and disconnects
+// the connections with the given ids. CLIENT KILL with a filter answers with
+// the number killed, so one already gone is no error.
+func (c *client) KillClients(ip, port, auth string, ids []string, tlsConfig *tls.Config) error {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	ctx := context.TODO()
+	_, err := rClient.Pipelined(ctx, func(pipe rediscli.Pipeliner) error {
+		for _, id := range ids {
+			pipe.Do(ctx, "CLIENT", "KILL", "ID", id)
+		}
+		return nil
+	})
+	if err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return err
+	}
+	c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.SUCCESS, metrics.NOT_APPLICABLE)
+	return nil
+}
+
+func parseClientUsers(list string) map[string][]string {
+	out := map[string][]string{}
+	for _, line := range strings.Split(list, "\n") {
+		var addr, user string
+		for _, field := range strings.Fields(line) {
+			if v, ok := strings.CutPrefix(field, "addr="); ok {
+				addr = v
+			} else if v, ok := strings.CutPrefix(field, "user="); ok {
+				user = v
+			}
+		}
+		if addr == "" {
+			continue
+		}
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil {
+			continue
+		}
+		out[host] = append(out[host], user)
+	}
+	return out
+}
+
+// SetUserACL authenticates as the default user with auth and replaces the
+// rules of user with rules, creating it if needed. reset comes first in the
+// same command, so the result does not depend on what the user had.
+func (c *client) SetUserACL(ip, port, auth, user string, rules []string, tlsConfig *tls.Config) error {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
+		DB:        0,
+		TLSConfig: tlsConfig,
+	}
+	rClient := rediscli.NewClient(options)
+	defer func() { _ = rClient.Close() }()
+	args := []interface{}{"ACL", "SETUSER", user, "reset"}
+	for _, rule := range rules {
+		args = append(args, rule)
+	}
+	if err := rClient.Do(context.TODO(), args...).Err(); err != nil {
+		c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.FAIL, getRedisError(err))
+		return err
+	}
+	c.metricsRecorder.RecordRedisOperation(metrics.KIND_REDIS, ip, metrics.APPLY_REDIS_CONFIG, metrics.SUCCESS, metrics.NOT_APPLICABLE)
+	return nil
+}
+
+// ListUsers authenticates as the default user with auth and returns the
+// names of every ACL user (ACL USERS).
+func (c *client) ListUsers(ip, port, auth string, tlsConfig *tls.Config) ([]string, error) {
+	options := &rediscli.Options{
+		Addr:      net.JoinHostPort(ip, port),
+		Password:  auth,
