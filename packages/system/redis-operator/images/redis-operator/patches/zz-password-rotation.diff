+			if !assert.NotNil(t, ss) {
+				return
+			}
+			assert.Len(t, ss.Spec.Template.Spec.Containers, 2)
+			for _, c := range ss.Spec.Template.Spec.Containers {
+				var got auth
+				for _, env := range c.Env {
+					switch env.Name {
+					case "REDIS_USER":
+						got.user = env.Value
+					case "REDIS_PASSWORD":
+						got.secret, got.key = env.ValueFrom.SecretKeyRef.Name, env.ValueFrom.SecretKeyRef.Key
