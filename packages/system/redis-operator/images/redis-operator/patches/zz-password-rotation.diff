diff --git a/operator/redisfailover/service/password.go b/operator/redisfailover/service/password.go
new file mode 100644
index 0000000..c294163
--- /dev/null
+++ b/operator/redisfailover/service/password.go
@@ -0,0 +1,233 @@
+package service
+
+import (
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+
+	redisfailoverv1 "github.com/freshworks/redis-operator/api/redisfailover/v1"
+	"github.com/freshworks/redis-operator/service/k8s"
+	"github.com/freshworks/redis-operator/service/redis"
+)
+
+// ErrPasswordRotationPending reports that the auth Secret holds a password
+// the running servers do not all accept yet. The redis ConfigMap keeps the
+// password they do accept until they all accept the new one, and nothing
+// that authenticates with the new password may run before that.
+var ErrPasswordRotationPending = errors.New("redis password rotation pending")
+
+// passwordHashAnnotation pins the redis pod template to the password the
+// redis ConfigMap holds, so that the pods, whose containers read
+// REDIS_PASSWORD from the auth Secret only at start, are rolled once every
+// server accepts a new password.
+const passwordHashAnnotation = "redis-failover.freshworks.com/password-hash"
+
+// appliedRedisPassword returns the password of the redis ConfigMap: the
+// one every running server accepts. found is false when the ConfigMap does
+// not exist yet, as on a new RedisFailover.
+func appliedRedisPassword(s k8s.Services, rf *redisfailoverv1.RedisFailover) (password string, found bool, err error) {
+	cm, err := s.GetConfigMap(rf.Namespace, GetRedisName(rf))
+	if apierrors.IsNotFound(err) {
+		return "", false, nil
+	}
+	if err != nil {
+		return "", false, err
+	}
+	return parseRequirePass(cm.Data[redisConfigFileName]), true, nil
+}
+
+// parseRequirePass returns the value of the last requirepass line of a
+// redis.conf as generateRedisConfigMap writes it, or "" when there is none.
+func parseRequirePass(conf string) string {
+	password := ""
+	for _, line := range strings.Split(conf, "\n") {
+		if v, ok := strings.CutPrefix(line, "requirepass "); ok {
+			password = v
+		}
+	}
+	return password
+}
+
+// passwordHash is the value of passwordHashAnnotation for a password: a
+// truncated SHA-256, enough to tell two passwords apart.
+func passwordHash(password string) string {
+	if password == "" {
+		return ""
+	}
+	sum := sha256.Sum256([]byte(password))
+	return hex.EncodeToString(sum[:8])
+}
+
+// RotateRedisPassword brings the running servers and Sentinels onto the
+// password of the auth Secret before the redis ConfigMap and the pod
+// template take it. The servers only read requirepass and masterauth from
+// redis.conf at start, so without this a changed password reaches the
+// ConfigMap, the operator and the Sentinels while every running server still
+// requires the old one.
+//
+// The steps keep every pair of servers and Sentinels able to authenticate to
+// each other at every point:
+//
+//  1. every server accepts the new password next to the old one (ACL SETUSER
+//     default >new), so clients, replicas and Sentinels on either work;
+//  2. every server uses the new password as masterauth, so a replica that
+//     reconnects authenticates with the new password, which its master now
+//     accepts;
+//  3. every Sentinel uses the new password as auth-pass.
+//
+// It then returns nil, the ConfigMap takes the new password and the pods
+// roll onto it. The old password is dropped (step 4, CONFIG SET requirepass)
+// on a later pass, once the ConfigMap records that every server accepts the
+// new one, by settleRedisPassword. Every step is idempotent and the
+// ConfigMap only moves on once steps 1-3 succeeded on every server, so a
+// pass interrupted at any point is redone from the start by the next one.
+//
+// An error wrapping ErrPasswordRotationPending means a server or Sentinel
+// could not be brought over; the caller keeps the ConfigMap on the old
+// password and skips the checks, which authenticate with the new one. Any
+// other error, such as a missing Secret, is returned as it is.
+func (r *RedisFailoverHealer) RotateRedisPassword(rf *redisfailoverv1.RedisFailover) error {
+	// A bootstrapping RedisFailover replicates from a master outside it,
+	// whose password this operator does not manage.
+	if rf.Bootstrapping() {
+		return nil
+	}
+	desired, err := k8s.GetRedisPassword(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	// Turning authentication off is applied by the pod roll alone, as before.
+	if desired == "" {
+		return nil
+	}
+	applied, found, err := appliedRedisPassword(r.k8sService, rf)
+	if err != nil || !found {
+		return err
+	}
+	tlsConfig, err := tlsConfigFor(r.k8sService, rf)
+	if err != nil {
+		return err
+	}
+	pods, err := r.runningPods(r.k8sService.GetStatefulSetPods(rf.Namespace, GetRedisName(rf)))
+	if err != nil {
+		return err
+	}
+	port := getRedisPort(rf.Spec.Redis.Port)
+	if applied == desired {
+		r.settleRedisPassword(rf, pods, port, desired, tlsConfig)
+		return nil
+	}
+
+	r.logger.WithField("redisfailover", rf.ObjectMeta.Name).WithField("namespace", rf.ObjectMeta.Namespace).Infof("Rotating the redis password on %d running servers", len(pods))
+	pending := func(step string, ip string, err error) error {
+		return fmt.Errorf("%w: %s on %s: %v", ErrPasswordRotationPending, step, ip, err)
+	}
+
+	// Step 1. A server without a password (authentication being turned on)
+	// accepts any password already, and adding one would lock its clients
+	// out before step 4.
+	if applied != "" {
+		for _, pod := range pods {
+			ip := pod.Status.PodIP
+			_, err := r.redisClient.GetDefaultUserPasswords(ip, port, desired, tlsConfig)
+			if err == nil {
+				continue // accepts the new password already
+			}
+			if !redis.IsAuthError(err) {
+				return pending("check the password", ip, err)
+			}
+			if err := r.redisClient.AddDefaultUserPassword(ip, port, applied, desired, tlsConfig); err != nil {
+				return pending("add the new password", ip, err)
+			}
+		}
+	}
+
+	// Step 2.
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		if err := r.redisClient.SetCustomRedisConfig(ip, port, []string{"masterauth " + desired}, desired, tlsConfig); err != nil {
+			return pending("set masterauth", ip, err)
+		}
+	}
+
+	// Step 3. A Sentinel that is not running gets the auth-pass from the
+	// checks once it is, as any restarted Sentinel does.
+	if rf.SentinelsAllowed() {
+		sentinels, err := r.runningPods(r.k8sService.GetDeploymentPods(rf.Namespace, GetSentinelName(rf)))
+		if err != nil {
+			return err
+		}
+		for _, pod := range sentinels {
+			ip := pod.Status.PodIP
+			if err := r.redisClient.SetSentinelAuthPass(ip, rf.MasterName(), desired, tlsConfig); err != nil {
+				return pending("set the Sentinel auth-pass", ip, err)
+			}
+		}
+	}
+	return nil
+}
+
+// settleRedisPassword runs once the redis ConfigMap holds the password of
+// the auth Secret, and leaves every running server accepting that password
+// alone. A server that accepts others besides it, the old one left by
+// RotateRedisPassword or none required at all, gets requirepass, which
+// resets the default user to that one password (step 4). A server that does
+// not accept it started from the ConfigMap while a rotation was being
+// applied and before the ConfigMap moved on, so it runs on the old one and
+// nothing else can authenticate to it; it is deleted, one per pass, to start
+// again from the current ConfigMap. Failures are logged and left to the next
+// pass: they must not hold up the checks, which work with this password.
+func (r *RedisFailoverHealer) settleRedisPassword(rf *redisfailoverv1.RedisFailover, pods []corev1.Pod, port, password string, tlsConfig *tls.Config) {
+	logger := r.logger.WithField("redisfailover", rf.ObjectMeta.Name).WithField("namespace", rf.ObjectMeta.Namespace)
+	want := fullPasswordHash(password)
+	stale := ""
+	for _, pod := range pods {
+		ip := pod.Status.PodIP
+		users, err := r.redisClient.GetDefaultUserPasswords(ip, port, password, tlsConfig)
+		if err != nil {
+			if redis.IsAuthError(err) && stale == "" {
+				stale = pod.Name
+			}
+			continue
+		}
+		if !users.NoPass && len(users.Hashes) == 1 && users.Hashes[0] == want {
+			continue
+		}
+		if err := r.redisClient.SetCustomRedisConfig(ip, port, []string{"requirepass " + password}, password, tlsConfig); err != nil {
+			logger.Warningf("Could not drop the passwords other than the current one on %s: %v", ip, err)
+		}
+	}
+	if stale != "" {
+		logger.Warningf("Redis pod %s does not accept the current password, restarting it to read the current config", stale)
+		if err := r.k8sService.DeletePod(rf.Namespace, stale); err != nil {
+			logger.Warningf("Could not delete redis pod %s: %v", stale, err)
+		}
+	}
+}
+
+// fullPasswordHash is the form ACL GETUSER lists a password in.
+func fullPasswordHash(password string) string {
+	sum := sha256.Sum256([]byte(password))
+	return hex.EncodeToString(sum[:])
+}
+
+// runningPods keeps the pods that are running, not being deleted, and have
+// an IP, the ones a server or Sentinel can be reached on.
+func (r *RedisFailoverHealer) runningPods(list *corev1.PodList, err error) ([]corev1.Pod, error) {
+	if err != nil {
+		return nil, err
+	}
+	var pods []corev1.Pod
+	for _, pod := range list.Items {
+		if pod.Status.Phase == corev1.PodRunning && pod.DeletionTimestamp == nil && pod.Status.PodIP != "" {
+			pods = append(pods, pod)
+		}
+	}
+	return pods, nil
+}
