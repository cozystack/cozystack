+			conf:     func(rf *redisfailoverv1.RedisFailover) string { return redisConfWithoutExporter(rf, newPassword) },
+			redis:    auth{"rf-internal", internalSecret, "password"},
+			exporter: auth{"rf-internal", internalSecret, "password"},
+		},
+		"config with both users": {
+			conf:     func(rf *redisfailoverv1.RedisFailover) string { return redisConf(rf, newPassword, internalPassword) },
+			redis:    auth{"rf-internal", internalSecret, "password"},
+			exporter: auth{"rf-exporter", internalSecret, "exporter"},
+		},
+	}
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			rf := authRF()
