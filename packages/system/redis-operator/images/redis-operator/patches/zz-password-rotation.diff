+package redis
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestParseDefaultUser(t *testing.T) {
+	reply := []interface{}{
+		"flags", []interface{}{"on", "sanitize-payload"},
+		"passwords", []interface{}{"aa", "bb"},
+		"commands", "+@all",
+	}
+	got, err := parseDefaultUser(reply)
+	assert.NoError(t, err)
+	assert.Equal(t, DefaultUserPasswords{Hashes: []string{"aa", "bb"}}, got)
+
+	got, err = parseDefaultUser([]interface{}{"flags", []interface{}{"on", "nopass"}, "passwords", []interface{}{}})
+	assert.NoError(t, err)
+	assert.Equal(t, DefaultUserPasswords{NoPass: true}, got)
+
+	_, err = parseDefaultUser("OK")
+	assert.Error(t, err)
+}
+
+func TestIsAuthError(t *testing.T) {
+	assert.True(t, IsAuthError(errors.New("WRONGPASS invalid username-password pair or user is disabled.")))
+	assert.True(t, IsAuthError(errors.New("NOAUTH Authentication required.")))
+	assert.False(t, IsAuthError(errors.New("dial tcp 10.0.0.1:6379: connect: connection refused")))
+	assert.False(t, IsAuthError(nil))
+}
