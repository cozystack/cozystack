+	mK8SService "github.com/freshworks/redis-operator/mocks/service/k8s"
+	rfOperator "github.com/freshworks/redis-operator/operator/redisfailover"
+)
+
+// The sequence from the stand: the roll moved the master off 10.244.0.128,
+// and the same pass then "fixed" the Sentinels back to 10.244.0.128, the
+// master it had read at its start, leaving 10.244.0.122 and 10.244.0.128
+// both masters. The pass must end at the failover.
+func TestCheckAndHealEndsThePassWhenTheRollMovesTheMaster(t *testing.T) {
+	assert := assert.New(t)
+	const oldMaster, replica = "10.244.0.128", "10.244.0.122"
+	rf := generateRF(false, false, false)
+	rf.Spec.Redis.Replicas = 2
+
+	mrfc := &mRFService.RedisFailoverCheck{}
+	mrfh := &mRFService.RedisFailoverHeal{}
+	mrfc.On("IsRedisRunning", rf).Return(true)
+	mrfc.On("IsSentinelRunning", rf).Return(true)
+	mrfc.On("GetNumberMasters", rf).Return(1, nil)
+	mrfc.On("GetMasterIP", rf).Return(oldMaster, nil)
+	mrfc.On("CheckAllSlavesFromMaster", oldMaster, rf).Return(nil)
+	mrfc.On("GetRedisesIPs", rf).Return([]string{oldMaster, replica}, nil)
+	mrfh.On("SetRedisCustomConfig", mock.Anything, rf).Return(nil)
+	// The roll: the replica is already on the new revision, the master is not.
+	mrfc.On("CheckRedisSlavesReady", replica, rf).Return(true, nil)
+	mrfc.On("GetStatefulSetUpdateRevision", rf).Return("new", nil)
+	mrfc.On("GetRedisesSlavesPods", rf).Return([]string{"rfr-1"}, nil)
+	mrfc.On("GetRedisRevisionHash", "rfr-1", rf).Return("new", nil)
+	mrfc.On("GetRedisesMasterPod", rf).Return("rfr-0", nil)
+	mrfc.On("GetRedisRevisionHash", "rfr-0", rf).Return("old", nil)
+	mrfh.On("FailoverMaster", rf).Once().Return(nil)
+
+	handler := rfOperator.NewRedisFailoverHandler(generateConfig(), &mRFService.RedisFailoverClient{}, mrfc, mrfh, &mK8SService.Services{}, metrics.Dummy, log.Dummy)
+	assert.NoError(handler.CheckAndHeal(rf))
+
+	mrfh.AssertCalled(t, "FailoverMaster", rf)
+	mrfh.AssertNotCalled(t, "DeletePod", mock.Anything, mock.Anything)
+	// Nothing after the failover may act on the stale master.
+	mrfc.AssertNotCalled(t, "GetSentinelsIPs", mock.Anything)
+	mrfc.AssertNotCalled(t, "CheckSentinelMonitor", mock.Anything, mock.Anything, mock.Anything, mock.Anything)
+	mrfh.AssertNotCalled(t, "NewSentinelMonitor", mock.Anything, mock.Anything, mock.Anything)
+}
+
+// Two masters: the healer settles them on the one the Sentinel quorum
+// names, instead of asking for a manual fix; without a quorum it still
+// reports the manual fix.
+func TestCheckAndHealSettlesTwoMastersOnTheSentinelQuorum(t *testing.T) {
+	for name, resolveErr := range map[string]error{"quorum": nil, "no quorum": errors.New("no quorum")} {
+		t.Run(name, func(t *testing.T) {
+			rf := generateRF(false, false, false)
+			mrfc := &mRFService.RedisFailoverCheck{}
+			mrfh := &mRFService.RedisFailoverHeal{}
+			mrfc.On("IsRedisRunning", rf).Return(true)
+			mrfc.On("IsSentinelRunning", rf).Return(true)
+			mrfc.On("GetNumberMasters", rf).Return(2, nil)
+			mrfh.On("ResolveMultipleMasters", rf).Once().Return(resolveErr)
+
+			handler := rfOperator.NewRedisFailoverHandler(generateConfig(), &mRFService.RedisFailoverClient{}, mrfc, mrfh, &mK8SService.Services{}, metrics.Dummy, log.Dummy)
+			err := handler.CheckAndHeal(rf)
+			if resolveErr == nil {
+				assert.NoError(t, err)
+			} else {
+				assert.ErrorContains(t, err, "fix manually")
+			}
+			mrfh.AssertExpectations(t)
+		})
+	}
+}
