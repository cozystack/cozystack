+		"id=4 addr=10.0.1.1:41002 laddr=10.0.0.1:6379 fd=9 name= age=9 user=default\n" +
+		"id=5 addr=[fd00::7]:5000 laddr=[fd00::1]:6379 fd=10 user=rf-internal\n"
