apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://teleport.aenix.io:443
    tls-server-name: kube-teleport-proxy-alpn.teleport.aenix.io
  name: teleport.aenix.io
contexts:
- context:
    cluster: teleport.aenix.io
    extensions:
    - extension: hidora-test
      name: teleport.kube.name
    user: teleport.aenix.io-hidora-test
  name: teleport.aenix.io-hidora-test
current-context: teleport.aenix.io-hidora-test
kind: Config
preferences: {}
users:
- name: teleport.aenix.io-hidora-test
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - kube
      - credentials
      - --kube-cluster=hidora-test
      - --teleport-cluster=teleport.aenix.io
      - --proxy=teleport.aenix.io:443
      command: /usr/local/bin/tsh
      env: null
      provideClusterInfo: false
