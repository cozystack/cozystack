+// A request to a cluster's HTTP API has no bound of its own: a fresh
+// http.Transport carries no dial, handshake or response-header timeout, the
+// client is built without an http.Client, and the Timeout field on a request
+// type is the server-side query parameter, which only helps once something
+// answers. The operator runs one worker per controller, so a single call that
+// never returns stops every OpenSearchCluster from being reconciled, and the
+// finalizer on the next deletion waits out its own termination timeout with
+// nothing in the log to say why.
+//
+// requestTimeout is applied at two levels, because one of them alone leaves a
+// gap. boundedTransport puts it on every request that goes out, which is the
+// only level that reaches the requests opensearch-go builds for itself. That
+// bounds an attempt, and opensearch-go retries a request up to three times on
+// 502, 503 and 504, so the calls below carry it a second time for the series:
+// through requestContext where the call decodes the answer before it returns,
+// and through performRequest where the still-open body goes back to the caller.
+//
+// These are variables rather than constants so the tests can shorten them.
+var (
+	// requestTimeout bounds one exchange with a cluster, from the dial to the
+	// last byte of the body. Every call answers in well under a second on a
+	// healthy cluster, and the controllers requeue on the order of tens of
+	// seconds, so a call still running at this point is not going to produce an
+	// answer worth waiting for.
+	requestTimeout = 30 * time.Second
+
+	// connectTimeout bounds getting a connection up: the dial and the TLS
+	// handshake, each separately. Both sit inside requestTimeout, which would
+	// end the attempt anyway; what this buys is an unreachable node failing in
+	// a third of the budget, with an error that names what went wrong.
+	connectTimeout = 10 * time.Second
+)
+
+// requestContext bounds a single call. The caller must cancel it only once it
+// is done with the response body, which for the calls that use it is when the
+// body has been decoded: cancelling earlier fails the read.
+//
+// It hangs off context.Background() rather than the caller's context, which the
+// methods below do not take: threading one through would change every signature
+// and every call site of a patch meant to be dropped. The cost is that an
+// operator shutting down waits out a call it could have abandoned.
+func requestContext() (context.Context, context.CancelFunc) {
+	return context.WithTimeout(context.Background(), requestTimeout)
+}
+
+// clusterDialer is the dialer the transport below dials with. It is built here
+// rather than inline so the bound on it can be read back: DialContext is a
+// function on the transport, and a timeout closed over inside one is not
+// something a test can assert.
+func clusterDialer() *net.Dialer {
+	return &net.Dialer{Timeout: connectTimeout}
+}
+
+// clusterTransport is the transport used when the caller supplies none.
+func clusterTransport() *http.Transport {
+	return &http.Transport{
+		TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
+		// These options are needed as otherwise connections would be kept and leak memory
+		// Connection reuse is not really possible due to each reconcile run being independent
+		DisableKeepAlives:   true,
+		MaxIdleConns:        1,
+		DialContext:         clusterDialer().DialContext,
+		TLSHandshakeTimeout: connectTimeout,
+	}
+}
+
+// boundedTransport puts requestTimeout on every request that goes through it.
+// It is the only level that reaches the requests opensearch-go makes for
+// itself: before a client's first request the library runs a product check,
+// which builds its own request with a context.Background() and decodes the body
+// of the answer, so a cluster that flushes the headers and then stops holds the
+// check, and with it the reconcile, for as long as the process lives. Each
+// reconcile builds its own client, so each one runs that check.
+//
+// The deadline outlives RoundTrip, because the body goes back to the caller
+// still open and cancelling here would fail their read. It rides on the body
+// and is released by Close, the same way http.Client applies its own Timeout.
+type boundedTransport struct {
+	http.RoundTripper
+}
+
+func (t boundedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	ctx, cancel := context.WithTimeout(req.Context(), requestTimeout)
+
+	res, err := t.RoundTripper.RoundTrip(req.WithContext(ctx))
+	if err != nil || res.Body == nil {
+		cancel()
+		return res, err
+	}
+
+	res.Body = &deadlineBody{ReadCloser: res.Body, cancel: cancel}
+	return res, nil
+}
