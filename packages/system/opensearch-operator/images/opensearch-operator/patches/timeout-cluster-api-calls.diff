+// performRequest sends req and bounds the whole exchange, the body read
+// included, with requestTimeout.
+//
+// The deadline has to outlive this function, because the response body goes
+// back to the caller still open and cancelling here would fail their read. It
+// therefore rides on the body and is released when the body is closed, which is
+// how http.Client applies its own Timeout. A caller that never closes the body
+// holds the timer until the deadline passes, and the deadline then closes the
+// connection on its behalf.
+//
+// Bounding it here rather than at each call site is what covers the read of a
+// body that has started arriving and then stops: the transport's
+// ResponseHeaderTimeout stops counting once the headers are in, so it is no
+// bound at all on a body that stalls halfway.
+func performRequest(ctx context.Context, client *opensearch.Client, req *http.Request) (*opensearchapi.Response, error) {
+	if ctx == nil {
+		ctx = context.Background()
 	}
+	ctx, cancel := context.WithTimeout(ctx, requestTimeout)
 
-	res, err := client.Perform(req)
+	res, err := client.Perform(req.WithContext(ctx))
 	if err != nil {
+		cancel()
 		return nil, err
 	}
 
-	return &opensearchapi.Response{StatusCode: res.StatusCode, Body: res.Body, Header: res.Header}, nil
+	return &opensearchapi.Response{
+		StatusCode: res.StatusCode,
+		Body:       &deadlineBody{ReadCloser: res.Body, cancel: cancel},
+		Header:     res.Header,
+	}, nil
+}
+
+// deadlineBody releases its request's deadline when the body is closed.
+type deadlineBody struct {
+	io.ReadCloser
+	cancel context.CancelFunc
+}
+
+func (b *deadlineBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.cancel()
+	return err
 }
