diff --git a/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go b/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go
new file mode 100644
index 0000000..4a8ce1f
--- /dev/null
+++ b/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go
@@ -0,0 +1,336 @@
+package services
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/opensearch-project/opensearch-go"
+)
+
+// blockedTransport is a cluster that has stopped answering: the request goes
+// out and nothing comes back until whoever sent it gives up.
+//
+// It answers the root path, and only the root path, because opensearch-go
+// checks the product it is talking to on a client's first request and gives
+// that check a context.Background() of its own, inside the library, where a
+// deadline set at the call site cannot reach it. This transport is handed
+// straight to opensearch.NewClient rather than going through
+// NewOsClusterClient, so boundedTransport is not in the way here and the
+// deadline under test is the one the call carries.
+type blockedTransport struct{}
+
+func (blockedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Path == "/" {
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(`{"version":{"number":"2.0.0","distribution":"opensearch"}}`)),
+			Request:    req,
+		}, nil
+	}
+	<-req.Context().Done()
+	return nil, req.Context().Err()
+}
+
+// callIsAnsweredOrAbandoned runs call in the background and fails the test if it
+// is still running after grace. Waiting in the test rather than in the call is
+// what turns an unbounded call into a failure instead of a test run that hangs
+// until the CI job is killed.
+func callIsAnsweredOrAbandoned(t *testing.T, grace time.Duration, what string, call func() error) {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- call() }()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatalf("%s: expected the call to fail once its deadline passed", what)
+		}
+	case <-time.After(grace):
+		t.Fatalf("%s: still running after %s, so the call is unbounded", what, grace)
+	}
+}
+
+// silentListener accepts connections and answers nothing on them. The accepted
+// connections are returned rather than dropped because an unreachable net.Conn
+// is closed by the garbage collector: net.netFD carries a finalizer that closes
+// the descriptor, so a dropped connection turns this into a server that resets
+// the connection, and a request against it then fails for a reason that has
+// nothing to do with the timeout under test.
+func silentListener(t *testing.T) (net.Listener, *[]net.Conn) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ln.Close() })
+
+	var mu sync.Mutex
+	accepted := &[]net.Conn{}
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			*accepted = append(*accepted, conn)
+			mu.Unlock()
+		}
+	}()
+
+	// Collect throughout, so that a connection this listener stops holding is
+	// closed while the test is still waiting rather than after it.
+	stop := make(chan struct{})
+	t.Cleanup(func() { close(stop) })
+	go func() {
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+				runtime.GC()
+				time.Sleep(10 * time.Millisecond)
+			}
+		}
+	}()
+
+	return ln, accepted
+}
+
+// keepReachable is the deferred hold that keeps the accepted connections alive
+// to the end of the test, and the reason silentListener forces a collection on
+// every accept: with the connections dropped instead, that collection closes
+// them and the test passes with the bound it exists to pin removed. It holds
+// the slice without reading it, because the accept goroutine writes the header
+// under a lock this side has no access to, and reading it here is a data race.
+func keepReachable(conns *[]net.Conn) {
+	runtime.KeepAlive(conns)
+}
+
+func TestCallToAClusterThatNeverAnswersGivesUp(t *testing.T) {
+	old := requestTimeout
+	requestTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = old })
+
+	raw, err := opensearch.NewClient(opensearch.Config{
+		Addresses: []string{"http://os.test:9200"},
+		Transport: blockedTransport{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := &OsClusterClient{client: raw}
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "GetHealth", func() error {
+		_, err := client.GetHealth()
+		return err
+	})
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "CatNodes", func() error {
+		_, err := client.CatNodes()
+		return err
+	})
+}
+
+func TestTransportGivesUpOnAServerThatAcceptsAndSaysNothing(t *testing.T) {
+	old := requestTimeout
+	requestTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = old })
+
+	ln, accepted := silentListener(t)
+	defer keepReachable(accepted)
+
+	req, err := http.NewRequest(http.MethodGet, "http://"+ln.Addr().String()+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner := clusterTransport()
+	t.Cleanup(inner.CloseIdleConnections)
+	transport := boundedTransport{inner}
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "GET through the operator's transport", func() error {
+		res, err := transport.RoundTrip(req)
+		if res != nil {
+			_ = res.Body.Close()
+		}
+		return err
+	})
+}
+
+// TestTransportCarriesConnectionTimeouts pins the bounds the test above cannot
+// reach. A dial that hangs needs an address that neither answers nor refuses,
+// and a TLS handshake that hangs needs a server that stops mid-handshake:
+// neither is something a test can arrange on loopback. Both are therefore
+// asserted by value, the dial through the dialer the transport is built from,
+// since a dialer reaches the transport as a function and a timeout closed over
+// inside one cannot be read back.
+func TestTransportCarriesConnectionTimeouts(t *testing.T) {
+	transport := clusterTransport()
+
+	if transport.DialContext == nil {
+		t.Error("DialContext is unset, so the transport dials with no timeout at all")
+	}
+	if dialer := clusterDialer(); dialer.Timeout != connectTimeout {
+		t.Errorf("the dialer's Timeout is %s, want %s", dialer.Timeout, connectTimeout)
+	}
+	if transport.TLSHandshakeTimeout != connectTimeout {
+		t.Errorf("TLSHandshakeTimeout is %s, want %s", transport.TLSHandshakeTimeout, connectTimeout)
+	}
+}
+
+// answeringServer answers the two requests a new client makes before anything
+// else: the ping, and the product check opensearch-go runs on a client's first
+// request. Every other path is handed to serve.
+func answeringServer(t *testing.T, serve http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/" {
+			_, _ = io.WriteString(w, `{"version":{"number":"2.0.0","distribution":"opensearch"}}`)
+			return
+		}
+		serve(w, r)
+	}))
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+// TestBodyThatStopsHalfwayIsBounded covers the calls that take a context from
+// the caller: nothing on the reconcile path puts a deadline on that context,
+// and the transport's ResponseHeaderTimeout stops counting the moment the
+// headers arrive, so a body that starts and then stops is bounded by the
+// deadline the request carries or by nothing.
+func TestBodyThatStopsHalfwayIsBounded(t *testing.T) {
+	oldRequest := requestTimeout
+	requestTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = oldRequest })
+
+	stall := make(chan struct{})
+	srv := answeringServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "100")
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		<-stall
+	})
+	t.Cleanup(func() { close(stall) })
+
+	client, err := NewOsClusterClient(srv.URL, "u", "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "reading a body that stopped halfway", func() error {
+		res, err := client.GetIndices(context.Background(), "test-*")
+		if err != nil {
+			return err
+		}
+		defer func() { _ = res.Body.Close() }()
+		_, err = io.ReadAll(res.Body)
+		return err
+	})
+}
+
+// TestBodyOutlivesTheCallThatFetchedIt is the other half: the deadline is
+// released by the body's Close and not by the call's return, because these
+// calls hand the body back still open and the caller reads it afterwards.
+func TestBodyOutlivesTheCallThatFetchedIt(t *testing.T) {
+	const chunk = 64 << 10
+	const chunks = 16
+
+	srv := answeringServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		for i := 0; i < chunks; i++ {
+			_, _ = w.Write([]byte(strings.Repeat("x", chunk)))
+			w.(http.Flusher).Flush()
+			time.Sleep(5 * time.Millisecond)
+		}
+	})
+
+	client, err := NewOsClusterClient(srv.URL, "u", "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	res, err := client.GetIndices(context.Background(), "test-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = res.Body.Close() }()
+
+	body, err := io.ReadAll(res.Body)
+	if err != nil {
+		t.Fatalf("reading the body after the call returned: %v", err)
+	}
+	if len(body) != chunk*chunks {
+		t.Errorf("read %d bytes of the body, want %d", len(body), chunk*chunks)
+	}
+}
+
+// TestNewClientGivesUpWhenTheProductCheckStalls covers the one request the call
+// site cannot reach: opensearch-go runs a product check before the first
+// request a client makes, builds it with a context.Background() of its own and
+// decodes its body, so a cluster that flushes the headers of that response and
+// then stops holds the check for as long as the process lives. The check runs
+// per client, and the operator builds one per reconcile.
+func TestNewClientGivesUpWhenTheProductCheckStalls(t *testing.T) {
+	old := requestTimeout
+	requestTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = old })
+
+	stall := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Content-Length", "57")
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		<-stall
+	}))
+	t.Cleanup(srv.Close)
+	t.Cleanup(func() { close(stall) })
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "a new client whose product check stalls", func() error {
+		_, err := NewOsClusterClient(srv.URL, "u", "p")
+		return err
+	})
+}
+
+// TestARetriedCallIsBoundedAsAWhole covers what a per-request deadline does not
+// reach: opensearch-go retries a request up to three more times on 502, 503 and
+// 504, and a bound that only sits on the transport starts again on each of
+// them, so a proxy that answers 504 slowly holds the call for four times the
+// budget. The deadline the call carries is what bounds the series.
+func TestARetriedCallIsBoundedAsAWhole(t *testing.T) {
+	const perAttempt = 200 * time.Millisecond
+
+	old := requestTimeout
+	requestTimeout = 300 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = old })
+
+	srv := answeringServer(t, func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(perAttempt)
+		w.WriteHeader(http.StatusServiceUnavailable)
+	})
+
+	client, err := NewOsClusterClient(srv.URL, "u", "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	start := time.Now()
+	res, err := client.GetIndices(context.Background(), "test-*")
+	elapsed := time.Since(start)
+	if err == nil {
+		_ = res.Body.Close()
+		t.Fatal("expected the call to fail once its deadline passed, not to run the retries out")
+	}
+	if elapsed > 3*perAttempt {
+		t.Errorf("the call took %s, which is more than one attempt plus its deadline: the series is unbounded", elapsed)
+	}
+}
