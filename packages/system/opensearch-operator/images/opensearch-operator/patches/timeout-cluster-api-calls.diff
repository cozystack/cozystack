+// A request to a cluster's HTTP API has no bound of its own: a fresh
+// http.Transport carries no dial, handshake or response-header timeout, the
+// client is built without an http.Client, and the Timeout field on a request
+// type is the server-side query parameter, which only helps once something
+// answers. The operator runs one worker per controller, so a single call that
+// never returns stops every OpenSearchCluster from being reconciled, and the
+// finalizer on the next deletion waits out its own termination timeout with
+// nothing in the log to say why.
+//
+// These are variables rather than constants so the tests can shorten them.
+var (
+	// requestTimeout bounds one call this client makes on its own behalf, from
+	// the dial to the last byte of the body. Every such call answers in well
+	// under a second on a healthy cluster, and the controllers requeue on the
+	// order of tens of seconds, so a call still running at this point is not
+	// going to produce an answer worth waiting for.
+	requestTimeout = 30 * time.Second
+
+	// connectTimeout bounds getting a connection up: the dial and the TLS
+	// handshake, each separately. Neither is covered by responseHeaderTimeout,
+	// which the transport only starts counting once the request is written.
+	connectTimeout = 10 * time.Second
+
+	// responseHeaderTimeout bounds the wait for response headers. It is the
+	// only bound on the calls that take a context from the caller and hand the
+	// still-open body back, so it is deliberately looser than requestTimeout:
+	// those are the security, ISM and snapshot-repository calls, and a
+	// repository creation verifies the repository from every node before it
+	// answers.
+	responseHeaderTimeout = 60 * time.Second
+)
+
+// requestContext bounds a single request. The caller must cancel it only once
+// it is done with the response body, which for the calls in this file is when
+// the body has been decoded: cancelling earlier fails the read.
+func requestContext() (context.Context, context.CancelFunc) {
+	return context.WithTimeout(context.Background(), requestTimeout)
+}
+
+// clusterTransport is the transport used when the caller supplies none.
+func clusterTransport() *http.Transport {
+	return &http.Transport{
+		TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
+		// These options are needed as otherwise connections would be kept and leak memory
+		// Connection reuse is not really possible due to each reconcile run being independent
+		DisableKeepAlives:     true,
+		MaxIdleConns:          1,
+		DialContext:           (&net.Dialer{Timeout: connectTimeout}).DialContext,
+		TLSHandshakeTimeout:   connectTimeout,
+		ResponseHeaderTimeout: responseHeaderTimeout,
+	}
+}
+
 type OsClusterClient struct {
 	OsClusterClientOptions
 	client   *opensearch.Client
