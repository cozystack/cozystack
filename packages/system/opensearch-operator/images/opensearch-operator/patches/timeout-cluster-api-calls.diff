diff --git a/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go b/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go
new file mode 100644
index 0000000..51d5025
--- /dev/null
+++ b/opensearch-operator/opensearch-gateway/services/os_client_timeout_test.go
@@ -0,0 +1,135 @@
+package services
+
+import (
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/opensearch-project/opensearch-go"
+)
+
+// blockedTransport is a cluster that has stopped answering: the request goes
+// out and nothing comes back until whoever sent it gives up.
+//
+// It answers the root path, and only the root path, because opensearch-go
+// checks the product it is talking to on a client's first request and gives
+// that check a context.Background() of its own, inside the library, where a
+// deadline set here cannot reach it. That request is bounded by the transport
+// and by nothing else, which is what the transport test below covers.
+type blockedTransport struct{}
+
+func (blockedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Path == "/" {
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(`{"version":{"number":"2.0.0","distribution":"opensearch"}}`)),
+			Request:    req,
+		}, nil
+	}
+	<-req.Context().Done()
+	return nil, req.Context().Err()
+}
+
+// callIsAnsweredOrAbandoned runs call in the background and fails the test if it
+// is still running after grace. Waiting in the test rather than in the call is
+// what turns an unbounded call into a failure instead of a test run that hangs
+// until the CI job is killed.
+func callIsAnsweredOrAbandoned(t *testing.T, grace time.Duration, what string, call func() error) {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- call() }()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatalf("%s: expected the call to fail once its deadline passed", what)
+		}
+	case <-time.After(grace):
+		t.Fatalf("%s: still running after %s, so the call is unbounded", what, grace)
+	}
+}
+
+func TestCallToAClusterThatNeverAnswersGivesUp(t *testing.T) {
+	old := requestTimeout
+	requestTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { requestTimeout = old })
+
+	raw, err := opensearch.NewClient(opensearch.Config{
+		Addresses: []string{"http://os.test:9200"},
+		Transport: blockedTransport{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := &OsClusterClient{client: raw}
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "GetHealth", func() error {
+		_, err := client.GetHealth()
+		return err
+	})
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "CatNodes", func() error {
+		_, err := client.CatNodes()
+		return err
+	})
+}
+
+func TestTransportGivesUpOnAServerThatAcceptsAndSaysNothing(t *testing.T) {
+	old := responseHeaderTimeout
+	responseHeaderTimeout = 200 * time.Millisecond
+	t.Cleanup(func() { responseHeaderTimeout = old })
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ln.Close() })
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			// Held open and never written to. Closing it would be an answer of
+			// a kind, and this test is about the connection that is not.
+			_ = conn
+		}
+	}()
+
+	req, err := http.NewRequest(http.MethodGet, "http://"+ln.Addr().String()+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport := clusterTransport()
+	t.Cleanup(transport.CloseIdleConnections)
+
+	callIsAnsweredOrAbandoned(t, 10*time.Second, "GET through the operator's transport", func() error {
+		res, err := transport.RoundTrip(req)
+		if res != nil {
+			_ = res.Body.Close()
+		}
+		return err
+	})
+}
+
+// TestTransportCarriesConnectionTimeouts pins the bounds the test above cannot
+// reach. A dial that hangs needs an address that neither answers nor refuses,
+// and a TLS handshake that hangs needs a server that stops mid-handshake:
+// neither is something a test can arrange on loopback. The handshake bound is
+// therefore asserted by value, and the dial bound only by being set at all,
+// since a dialer is a function here and its timeout cannot be read back.
+func TestTransportCarriesConnectionTimeouts(t *testing.T) {
+	transport := clusterTransport()
+
+	if transport.DialContext == nil {
+		t.Error("DialContext is unset, so the transport dials with no timeout at all")
+	}
+	if transport.TLSHandshakeTimeout != connectTimeout {
+		t.Errorf("TLSHandshakeTimeout is %s, want %s", transport.TLSHandshakeTimeout, connectTimeout)
+	}
+	if transport.ResponseHeaderTimeout != responseHeaderTimeout {
+		t.Errorf("ResponseHeaderTimeout is %s, want %s", transport.ResponseHeaderTimeout, responseHeaderTimeout)
+	}
+}
