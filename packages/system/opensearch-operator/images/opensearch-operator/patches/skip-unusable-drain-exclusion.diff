@@ -0,0 +1,13 @@
+package responses
+
+// AllocationExplainResponse carries the part of _cluster/allocation/explain this
+// operator reads. The endpoint returns a great deal more; everything else is
+// left out on purpose, so a field the operator never consults cannot break
+// decoding when OpenSearch renames it.
+type AllocationExplainResponse struct {
+	Index string `json:"index"`
+	Shard int    `json:"shard"`
+	// CanMoveToOtherNode is "yes", "no" or "throttled", and is only present for a
+	// shard that is currently assigned.
+	CanMoveToOtherNode string `json:"can_move_to_other_node,omitempty"`
+}
