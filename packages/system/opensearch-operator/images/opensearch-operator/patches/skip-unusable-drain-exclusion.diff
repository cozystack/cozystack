 func (client *OsClusterClient) CatShards(headers []string) ([]responses.CatShardsResponse, error) {
 	req := opensearchapi.CatShardsRequest{Format: "json", H: headers}
 	indicesRes, err := req.Do(context.Background(), client.client)
