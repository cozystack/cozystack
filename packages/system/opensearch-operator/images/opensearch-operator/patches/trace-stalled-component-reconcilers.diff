index 0000000..f01b989
--- /dev/null
+++ b/opensearch-operator/pkg/reconcilers/stallwatchdog.go
@@ -0,0 +1,56 @@
+package reconcilers
+
+import (
+	"time"
+
+	"github.com/go-logr/logr"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+)
+
+// WithStallWatchdog wraps a component reconciler so a call that stops returning
+// keeps saying so, under the name of the component it is stuck in.
+//
+// Of the components the cluster controller runs in sequence, only the TLS one
+// logs when it is entered, so a reconcile that never comes back out of any of
+// the others leaves nothing behind at all: the last line in the operator log
+// stays whatever was written before the stall, the object stops being
+// reconciled, and the two look identical from the outside. Logging every entry
+// instead would put nine lines per cluster into the log every reconcile, so
+// nothing is written while a component behaves.
+//
+// The report repeats rather than firing once, so a log collected at any point
+// during a stall says which component is in flight and for how long, instead of
+// only whoever read it at the right second knowing.
+func WithStallWatchdog(logger logr.Logger, name string, warnAfter, repeatEvery time.Duration, rec ComponentReconciler) ComponentReconciler {
+	return func() (reconcile.Result, error) {
+		done := make(chan struct{})
+		defer close(done)
+
+		go func() {
+			started := time.Now()
+
+			timer := time.NewTimer(warnAfter)
+			defer timer.Stop()
+			select {
+			case <-done:
+				return
+			case <-timer.C:
+			}
+
+			ticker := time.NewTicker(repeatEvery)
+			defer ticker.Stop()
+			for {
+				logger.Info("component reconciler has not returned",
+					"component", name,
+					"elapsed", time.Since(started).String())
+				select {
+				case <-done:
+					return
+				case <-ticker.C:
+				}
+			}
+		}()
+
+		return rec()
+	}
+}
diff --git a/opensearch-operator/pkg/reconcilers/stallwatchdog_test.go b/opensearch-operator/pkg/reconcilers/stallwatchdog_test.go
new file mode 100644
index 0000000..4314196
--- /dev/null
+++ b/opensearch-operator/pkg/reconcilers/stallwatchdog_test.go
@@ -0,0 +1,90 @@
+package reconcilers
+
+import (
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/go-logr/logr/funcr"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+)
+
+type recordingSink struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (r *recordingSink) write(prefix, args string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.lines = append(r.lines, prefix+args)
+}
+
+func (r *recordingSink) snapshot() []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	out := make([]string, len(r.lines))
+	copy(out, r.lines)
+	return out
+}
+
+var errStallWatchdogTest = errors.New("component failed")
+
+var _ = Describe("component reconciler stall watchdog", func() {
+	var sink *recordingSink
+
+	BeforeEach(func() {
+		sink = &recordingSink{}
+	})
+
+	It("passes the wrapped result and error through untouched", func() {
+		want := reconcile.Result{Requeue: true, RequeueAfter: 7 * time.Second}
+		wrapped := WithStallWatchdog(funcr.New(sink.write, funcr.Options{}), "cluster", time.Hour, time.Hour, func() (reconcile.Result, error) {
+			return want, errStallWatchdogTest
+		})
+
+		got, err := wrapped()
+
+		Expect(got).To(Equal(want))
+		Expect(err).To(MatchError(errStallWatchdogTest))
+	})
+
+	It("stays silent while the component returns promptly", func() {
+		wrapped := WithStallWatchdog(funcr.New(sink.write, funcr.Options{}), "cluster", 50*time.Millisecond, 50*time.Millisecond, func() (reconcile.Result, error) {
+			return reconcile.Result{}, nil
+		})
+
+		_, err := wrapped()
+		Expect(err).ToNot(HaveOccurred())
+
+		Consistently(sink.snapshot, 200*time.Millisecond, 20*time.Millisecond).Should(BeEmpty())
+	})
+
+	It("names the component while its call is still in flight", func() {
+		release := make(chan struct{})
+		returned := make(chan struct{})
+		wrapped := WithStallWatchdog(funcr.New(sink.write, funcr.Options{}), "securityconfig", 10*time.Millisecond, 10*time.Millisecond, func() (reconcile.Result, error) {
+			<-release
+			return reconcile.Result{}, nil
+		})
+
+		go func() {
+			defer GinkgoRecover()
+			defer close(returned)
+			_, err := wrapped()
+			Expect(err).ToNot(HaveOccurred())
+		}()
+
+		Eventually(sink.snapshot).Should(ContainElement(ContainSubstring("securityconfig")))
+
+		close(release)
+		Eventually(returned).Should(BeClosed())
+
+		// The goroutine has to stop with the call, or every stalled reconcile
+		// leaves one behind writing for the life of the process.
+		settled := len(sink.snapshot())
+		Consistently(func() int { return len(sink.snapshot()) }, 100*time.Millisecond, 20*time.Millisecond).Should(Equal(settled))
+	})
+})
