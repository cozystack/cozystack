+// votingConfigState is the slice of the cluster state that says who may vote.
+// The coordination metadata names voters by node id, so the node list travels
+// in the same response to resolve an id back to a name.
+type votingConfigState struct {
+	Nodes map[string]struct {
+		Name string `json:"name"`
+	} `json:"nodes"`
+	Metadata struct {
+		ClusterCoordination struct {
+			LastCommittedConfig    []string `json:"last_committed_config"`
+			VotingConfigExclusions []struct {
+				NodeName string `json:"node_name"`
+			} `json:"voting_config_exclusions"`
+		} `json:"cluster_coordination"`
+	} `json:"metadata"`
+}
+
+// ExcludeNodeFromVotingConfig commits a voting configuration that leaves
+// nodeName out, which is what makes the node safe to remove: a node still in
+// the configuration is a vote the cluster keeps counting on.
+func (client *OsClusterClient) ExcludeNodeFromVotingConfig(ctx context.Context, nodeName string) error {
+	path := generateAPIPathVotingConfigExclusions(nodeName)
+	res, err := doHTTPPost(ctx, client.client, path, nil)
+	if err != nil {
+		return err
+	}
+	defer helpers.SafeClose(res.Body)
+	if res.IsError() {
+		return fmt.Errorf("excluding %s from the voting configuration returned %s", nodeName, res.Status())
+	}
+	return nil
+}
+
+// ClearVotingConfigExclusions empties the exclusion list, which is capped and
+// would otherwise keep entries for nodes that are long gone. wait_for_removal
+// stays at its default: clearing without it can re-admit a node that is still
+// running, and the caller has already removed the one it excluded.
+func (client *OsClusterClient) ClearVotingConfigExclusions(ctx context.Context) error {
+	var path strings.Builder
+	path.WriteString("/_cluster/voting_config_exclusions")
+	res, err := doHTTPDelete(ctx, client.client, path)
+	if err != nil {
+		return err
+	}
+	defer helpers.SafeClose(res.Body)
+	if res.IsError() {
+		return fmt.Errorf("clearing the voting configuration exclusions returned %s", res.Status())
+	}
+	return nil
+}
+
+func (client *OsClusterClient) readVotingConfigState(ctx context.Context) (votingConfigState, error) {
+	var state votingConfigState
+	var path strings.Builder
+	path.WriteString("/_cluster/state/nodes,metadata")
+	path.WriteString("?filter_path=nodes.*.name,metadata.cluster_coordination.last_committed_config")
+	path.WriteString(",metadata.cluster_coordination.voting_config_exclusions")
+	res, err := doHTTPGet(ctx, client.client, path)
+	if err != nil {
+		return state, err
+	}
+	defer helpers.SafeClose(res.Body)
+	if res.IsError() {
+		return state, fmt.Errorf("reading the voting configuration returned %s", res.Status())
+	}
+	err = json.NewDecoder(res.Body).Decode(&state)
+	return state, err
+}
+
+// IsInVotingConfig reports whether nodeName is still one of the nodes whose
+// vote counts. An exclusion is committed through the cluster state rather than
+// applied by the time the request returns, so this is what tells a caller the
+// exclusion has actually taken.
+func (client *OsClusterClient) IsInVotingConfig(ctx context.Context, nodeName string) (bool, error) {
+	state, err := client.readVotingConfigState(ctx)
+	if err != nil {
+		return false, err
+	}
+
+	for _, id := range state.Metadata.ClusterCoordination.LastCommittedConfig {
+		if node, ok := state.Nodes[id]; ok && node.Name == nodeName {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// IsVotingConfigExcluded reports whether nodeName is still named in the
+// exclusion list. The list is capped, so an entry left behind for a node that
+// no longer exists costs capacity a later membership change may need.
+func (client *OsClusterClient) IsVotingConfigExcluded(ctx context.Context, nodeName string) (bool, error) {
+	state, err := client.readVotingConfigState(ctx)
+	if err != nil {
+		return false, err
+	}
+
+	for _, ex := range state.Metadata.ClusterCoordination.VotingConfigExclusions {
+		if ex.NodeName == nodeName {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func generateAPIPathVotingConfigExclusions(nodeName string) strings.Builder {
+	var path strings.Builder
+	path.Grow(len("/_cluster/voting_config_exclusions?node_names=") + len(nodeName))
+	path.WriteString("/_cluster/voting_config_exclusions?node_names=")
+	path.WriteString(nodeName)
+	return path
+}
