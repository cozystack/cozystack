+// retireBootstrapPod takes the bootstrap node out of the voting configuration
+// before deleting its pod.
+//
+// The bootstrap node is the one that formed the cluster, so it is the voter the
+// cluster keeps while the voting configuration holds a single node, which is
+// what it holds whenever exactly two nodes are cluster_manager-eligible: the
+// bootstrap pod and one node pool replica. Deleting the pod then takes away the
+// only vote there was, and the survivor can never hold an election again,
+// because changing the voting configuration itself needs a quorum. Excluding
+// the node first moves the configuration onto the surviving node, which is what
+// makes the deletion safe.
+//
+// Every failure to reach the cluster leaves the pod alone and requeues. A
+// bootstrap pod that outlives its purpose costs a pod; a cluster that cannot
+// elect a cluster-manager does not recover without a human.
+func (r *ClusterReconciler) retireBootstrapPod(bootstrapPod *corev1.Pod) (*ctrl.Result, error) {
+	podGone := false
+	if _, err := r.client.GetPod(bootstrapPod.Name, bootstrapPod.Namespace); err != nil {
+		if !k8serrors.IsNotFound(err) {
+			return &ctrl.Result{}, err
+		}
+		podGone = true
+	}
+
+	annotations := map[string]string{"cluster-name": r.instance.GetName()}
+	nodeName := builders.BootstrapPodName(r.instance)
+
+	clusterClient, err := util.CreateClientForCluster(r.client, r.ctx, r.instance, nil)
+	if err != nil {
+		r.logger.Error(err, "Failed to create os client to retire the bootstrap node", "node", nodeName)
+		r.recorder.AnnotatedEventf(r.instance, annotations, "Warning", "Bootstrap",
+			"Cannot reach the cluster to exclude %s from voting; keeping the bootstrap pod", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+
+	// Deleting the pod is a request, not a wait, so the clearing step below can
+	// find the node still in the cluster and fail. Retrying it here is what
+	// keeps a stale entry from sitting in the capped exclusion list forever,
+	// where it would cost a later membership change the capacity it needs.
+	if podGone {
+		return r.clearBootstrapExclusion(clusterClient, nodeName)
+	}
+
+	if err := clusterClient.ExcludeNodeFromVotingConfig(r.ctx, nodeName); err != nil {
+		r.logger.Error(err, "Failed to exclude the bootstrap node from the voting configuration", "node", nodeName)
+		r.recorder.AnnotatedEventf(r.instance, annotations, "Warning", "Bootstrap",
+			"Could not exclude %s from voting; keeping the bootstrap pod", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+
+	// The exclusion travels through the cluster state, so it is committed a
+	// moment after the request returns rather than by the time it does.
+	stillVoting, err := clusterClient.IsInVotingConfig(r.ctx, nodeName)
+	if err != nil {
+		r.logger.Error(err, "Failed to read the voting configuration", "node", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+	if stillVoting {
+		r.logger.Info("Waiting for the bootstrap node to leave the voting configuration", "node", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+
+	result, err := r.client.ReconcileResource(bootstrapPod, reconciler.StateAbsent)
+	if err != nil {
+		return result, err
+	}
+
+	r.recorder.AnnotatedEventf(r.instance, annotations, "Normal", "Bootstrap",
+		"Excluded %s from voting and removed the bootstrap pod", nodeName)
+
+	if cleared, err := r.clearBootstrapExclusion(clusterClient, nodeName); err != nil || cleared.RequeueAfter > 0 {
+		return cleared, err
+	}
+	return result, nil
+}
+
+// clearBootstrapExclusion drops the exclusion this reconciler added, once the
+// node it named is really gone.
+//
+// Clearing empties the whole list rather than one entry, so it is left at the
+// API's default wait_for_removal=true: that is what stops it from re-admitting
+// a node some other operation excluded and is still draining. A failure is
+// therefore expected while the bootstrap pod is terminating, and is answered
+// with a requeue rather than a log line, because nothing else will come back to
+// it.
+func (r *ClusterReconciler) clearBootstrapExclusion(clusterClient *services.OsClusterClient, nodeName string) (*ctrl.Result, error) {
+	excluded, err := clusterClient.IsVotingConfigExcluded(r.ctx, nodeName)
+	if err != nil {
+		r.logger.Error(err, "Failed to read the voting configuration exclusions", "node", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+	if !excluded {
+		return &ctrl.Result{}, nil
+	}
+
+	if err := clusterClient.ClearVotingConfigExclusions(r.ctx); err != nil {
+		r.logger.Error(err, "Failed to clear the voting configuration exclusions", "node", nodeName)
+		return &ctrl.Result{RequeueAfter: bootstrapRetireRetry}, nil
+	}
+	return &ctrl.Result{}, nil
+}
