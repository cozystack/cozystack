+// A group can stand below its min size, for one when the annotation is
+// raised over it, and adding a node to it must not be refused as a
+// decrease: the refusal backs the group off, which also stops the min-size
+// enforcement from lifting it.
+func TestNodeGroupIncreaseSizeBelowMinSize(t *testing.T) {
+	test := func(t *testing.T, testConfig *testConfig) {
+		controller, stop := mustCreateTestController(t, testConfig)
+		defer stop()
+
+		nodegroups, err := controller.nodeGroups()
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		if l := len(nodegroups); l != 1 {
+			t.Fatalf("expected 1 nodegroup, got %d", l)
+		}
+
+		ng := nodegroups[0].(*nodegroup)
+		if err := ng.IncreaseSize(1); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		gvr, err := ng.scalableResource.GroupVersionResource()
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		scalableResource, err := ng.machineController.managementScaleClient.Scales(testConfig.spec.namespace).
+			Get(context.TODO(), gvr.GroupResource(), ng.scalableResource.Name(), metav1.GetOptions{})
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		if scalableResource.Spec.Replicas != 2 {
+			t.Errorf("expected 2, got %v", scalableResource.Spec.Replicas)
+		}
+	}
+
+	annotations := map[string]string{
+		nodeGroupMinSizeAnnotationKey: "3",
+		nodeGroupMaxSizeAnnotationKey: "10",
+	}
+
+	t.Run("MachineSet", func(t *testing.T) {
+		test(t, createMachineSetTestConfig(RandomString(6), RandomString(6), RandomString(6), 1, annotations, nil))
+	})
+
+	t.Run("MachineDeployment", func(t *testing.T) {
+		test(t, createMachineDeploymentTestConfig(RandomString(6), RandomString(6), RandomString(6), 1, annotations, nil))
+	})
+}
+
+func TestNodeGroupSetSizeRefusesDecreaseBelowMinSize(t *testing.T) {
+	test := func(t *testing.T, desired int, testConfig *testConfig) {
+		controller, stop := mustCreateTestController(t, testConfig)
+		defer stop()
+
+		nodegroups, err := controller.nodeGroups()
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+
+		if l := len(nodegroups); l != 1 {
+			t.Fatalf("expected 1 nodegroup, got %d", l)
+		}
+
+		ng := nodegroups[0].(*nodegroup)
+		err = ng.scalableResource.SetSize(desired)
+		if err == nil {
+			t.Fatal("expected an error")
+		}
+		if !strings.Contains(err.Error(), fmt.Sprintf("size decrease too large - desired:%d min:3", desired)) {
+			t.Errorf("unexpected error: %v", err)
+		}
+	}
+
+	annotations := map[string]string{
+		nodeGroupMinSizeAnnotationKey: "3",
+		nodeGroupMaxSizeAnnotationKey: "10",
+	}
+
+	for _, tc := range []struct {
+		description string
+		initial     int
+		desired     int
+	}{
+		{"from above min size", 4, 2},
+		{"from below min size", 2, 1},
+	} {
+		t.Run(tc.description+"/MachineSet", func(t *testing.T) {
+			test(t, tc.desired, createMachineSetTestConfig(RandomString(6), RandomString(6), RandomString(6), tc.initial, annotations, nil))
+		})
+
+		t.Run(tc.description+"/MachineDeployment", func(t *testing.T) {
+			test(t, tc.desired, createMachineDeploymentTestConfig(RandomString(6), RandomString(6), RandomString(6), tc.initial, annotations, nil))
+		})
+	}
+}
