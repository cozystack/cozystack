+		t.controller.infraFactory.Start(stop)
+		Expect(cache.WaitForCacheSync(stop,
+			t.controller.infraFactory.Core().V1().Services().Informer().HasSynced)).To(BeTrue())
+		t.controller.infraDynamicFactory.Start(stop)
+		Expect(cache.WaitForCacheSync(stop,
+			t.controller.infraDynamicFactory.ForResource(vmiGVR).Informer().HasSynced)).To(BeTrue())
+
+		Eventually(func() int { return t.controller.queue.Len() }, "10s", "20ms").Should(Equal(want))
