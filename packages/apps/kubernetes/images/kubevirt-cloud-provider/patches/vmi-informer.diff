+			"Only the Service of this cluster should be requeued")
+		Consistently(func() int { return t.controller.queue.Len() }, "200ms", "20ms").Should(BeZero())
+	}
+
+	expectNoRequeue := func(t *testKubevirtEPSController, why string) {
+		Consistently(func() int { return t.controller.queue.Len() }, "500ms", "20ms").Should(BeZero(), why)
+	}
+
+	g.It("Should requeue the LoadBalancer Services when a VMI appears or disappears", func() {
+		t := setupTestKubevirtEPSController()
+		stop := make(chan struct{})
+		defer close(stop)
+		startTracking(t, stop, 2)
+
+		// A new VMI must trigger a reconciliation, otherwise a node added by a scale up or a
+		// rollout never becomes an endpoint.
+		createVMI(t, createUnstructuredVMIForCluster("vmi-1", "infra-1", "10.0.0.1", "test-cluster"))
+		expectRequeueOf(t, "Creating a VMI should requeue the LoadBalancer Service")
+
+		// A deleted VMI must trigger a reconciliation as well, otherwise its address stays in the
+		// EndpointSlice and the LoadBalancer blackholes the traffic hashed onto it.
+		err := t.infraDynamic.Resource(vmiGVR).Namespace(infraNamespace).
+			Delete(context.TODO(), "vmi-1", metav1.DeleteOptions{})
+		Expect(err).To(BeNil())
+		expectRequeueOf(t, "Deleting a VMI should requeue the LoadBalancer Service")
+	})
+
+	g.It("Should requeue the LoadBalancer Services only on the VMI updates that can change an endpoint", func() {
+		t := setupTestKubevirtEPSController()
+		stop := make(chan struct{})
+		defer close(stop)
+		createVMI(t, createUnstructuredVMIForCluster("vmi-1", "infra-1", "10.0.0.1", "test-cluster"))
+		// Both Service adds, plus the add of the VMI already present.
+		startTracking(t, stop, 3)
+
+		updateVMI(t, "vmi-1", func(u *unstructured.Unstructured) {
+			u.SetAnnotations(map[string]string{"unrelated": "change"})
