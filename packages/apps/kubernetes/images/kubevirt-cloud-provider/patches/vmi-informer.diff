+		})
+		expectRequeueOf(t, "A phase change should requeue the LoadBalancer Service")
+
+		updateVMI(t, "vmi-1", func(u *unstructured.Unstructured) {
+			Expect(unstructured.SetNestedField(u.Object, "infra-2", "status", "nodeName")).To(Succeed())
+		})
+		expectRequeueOf(t, "A node change should requeue the LoadBalancer Service")
+
+		updateVMI(t, "vmi-1", func(u *unstructured.Unstructured) {
