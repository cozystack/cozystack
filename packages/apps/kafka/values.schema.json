      "default": {},
      "required": [
        "replicas",
        "resourcesPreset",
        "size",
        "storageClass"
      ],
      "properties": {
        "replicas": {
          "description": "Number of KRaft controllers. Use an odd number: the metadata quorum needs a majority of them.",
          "type": "integer",
          "default": 3
        },
        "resources": {
          "description": "Explicit CPU and memory configuration. When omitted, the preset defined in `resourcesPreset` is applied.",
          "type": "object",
