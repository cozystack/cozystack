{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "whitelistHTTP": {
      "description": "Secure HTTP by enabling client networks whitelisting.",
      "type": "boolean",
      "default": true
    },
    "whitelist": {
      "description": "List of client networks.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "machines": {
      "description": "Configuration of physical machine instances.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "arch",
          "hostname",
          "ip",
          "leaseTime",
          "uefi"
        ],
        "properties": {
          "arch": {
            "description": "Architecture.",
            "type": "string"
          },
          "hostname": {
            "description": "Hostname.",
            "type": "string"
          },
          "ip": {
            "description": "IP address configuration.",
            "type": "object",
            "required": [
              "address",
              "gateway",
              "netmask"
            ],
            "properties": {
              "address": {
                "description": "IP address.",
                "type": "string"
              },
              "gateway": {
                "description": "IP gateway.",
                "type": "string"
              },
              "netmask": {
                "description": "Netmask.",
                "type": "string"
              }
            }
          },
          "leaseTime": {
            "description": "Lease time.",
            "type": "integer"
          },
          "mac": {
            "description": "MAC addresses.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nameServers": {
            "description": "Name servers.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeServers": {
            "description": "Time servers.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uefi": {
            "description": "UEFI.",
            "type": "boolean"
          }
        }
      }
    },
    "schedulingClass": {
      "description": "Name of a SchedulingClass CR (cluster-scoped, group cozystack.io) applied to this application's workloads in place of the tenant's. Must be the tenant's own class or one listed in the tenant's `allowedSchedulingClasses`; any other value is refused. Empty means inherit from the tenant.",
      "type": "string",
      "default": "",
      "maxLength": 63
    }
  }
}
