{
  "id": "arm64",
  "name": "arm64",
  "boot": {
    "kernel": "/assets/vmlinuz-arm64",
    "initrd": ["/assets/initramfs-arm64.xz"],
    "args": [
      "initrd=initramfs-arm64.xz",
      "init_on_alloc=1",
      "slab_nomerge",
      "pti=on",
      "console=tty0",
      "console=ttyAMA0",
      "printk.devkmsg=on",
      "talos.platform=metal"
    ]
  }
}
