#!/bin/sh
# Migration 67 --> 68
# Convert MongoDB users to platform-minted credentials, first part.
#
# The converted mongodb chart renders a CredentialTemplate per user, and each
# user of the PerconaServerMongoDB reads its password from the template's
# account Secret, which cozystack-controller seeds with a random password only
# on a release marked for seeding. MongoDB computes SCRAM from the plaintext,
# so the account Secret stores the password itself (format plaintext). The old
# chart kept each user's password in its own Secret, <release>-user-<name>,
# under the key password, so the source is per account rather than
# <release>-credentials, which holds only the databaseAdmin platform account
# and is left alone. This hook runs before any component chart changes version
# and writes the account Secrets, unowned, for every existing MongoDB release
# from those per-user Secrets, so clients keep logging in at every point of the
# upgrade; the controller adopts them once the templates exist. A release
# whose every account got its Secret is marked for seeding, so users added
# later are seeded too.
#
# The second part is the cozystack-credentials-migration-67 Job, which waits
# per release for its chart to switch, then strips users.*.password from the
# values and deletes any per-user Secret Helm did not prune. This hook creates
# that Job directly rather than rendering it from the platform chart: a
# chart-rendered Job has a fixed name and an image that changes every release,
# so the next platform upgrade cannot patch its immutable pod template, and
# helm-controller would wait on a Job that runs for up to 30 minutes and exits
# non-zero while any release is left out. It runs the image this hook runs as,
# read from its own pod, and is deleted and recreated rather than patched.
#
# The Job's ServiceAccount, ClusterRole and ClusterRoleBinding carry the
# migration number. Each conversion migration creates its own: one platform
# upgrade can run several of them back to back, and a shared ServiceAccount
# deleted by a later hook would cut off an earlier Job still running as it.
# The ServiceAccount is owned by the Job, so the garbage collector removes it
# with the Job; the ClusterRoleBinding and ClusterRole cannot be owned by a
# namespaced Job and are left, granting to no subject once the ServiceAccount
# is gone. While any release is left out, credentials-migrate labels its state
# ConfigMap credentials.cozystack.io/incomplete=true, which the
# CredentialsMigrationIncomplete alert fires on. To rerun it by hand, delete
# the Job and re-apply the manifest below.
#
# Fail-closed: migrations never re-run, so an error here stops the upgrade
# rather than stamping the version past a release that was not recorded.

set -euo pipefail

# shellcheck source=lib/cozystack-version.sh
. "$(dirname "$0")/lib/cozystack-version.sh"

NAMESPACE="${NAMESPACE:-cozy-system}"

credentials-migrate seed \
  --migration 67 \
  --kind MongoDB \
  --format plaintext \
  --accounts-path users \
  --source-suffix -user- \
  --source-key password \
  --source-per-account

# The finish Job runs the same image as this hook, so a release and its
# conversion share the credentials-migrate build. Read it from this pod's own
# container by name rather than render it from values, which the hook does not
# carry, and rather than by position, which a webhook-injected container shifts.
image=$(kubectl get pod "$(hostname)" \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.spec.containers[?(@.name=="migration")].image}')
if [ -z "$image" ]; then
  echo "cannot read this pod's image to run the finish Job" >&2
  exit 1
fi

# Delete any Job left by an earlier run of this hook: its pod template is
# immutable, so a rerun on a newer image would fault on apply. finish recovers
# its progress from the state ConfigMap, so recreating the Job loses nothing.
# Delete the ServiceAccount with it: an earlier run may have left it owned by
# the Job just deleted, and the apply below does not touch ownerReferences, so
# without this the garbage collector could remove the re-applied ServiceAccount
# out from under the ownerReference patch. A fresh, owner-less ServiceAccount is
# never collected before the patch names the new Job.
kubectl delete job cozystack-credentials-migration-67 \
  --namespace "$NAMESPACE" \
  --ignore-not-found
kubectl delete serviceaccount cozystack-credentials-migration-67 \
  --namespace "$NAMESPACE" \
  --ignore-not-found

kubectl apply --filename - <<YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cozystack-credentials-migration-67
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "create", "patch", "delete"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create"]
  - apiGroups: ["helm.toolkit.fluxcd.io"]
    resources: ["helmreleases"]
    verbs: ["get", "list", "patch"]
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cozystack-credentials-migration-67
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cozystack-credentials-migration-67
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cozystack-credentials-migration-67
subjects:
  - kind: ServiceAccount
    name: cozystack-credentials-migration-67
    namespace: ${NAMESPACE}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: cozystack-credentials-migration-67
  namespace: ${NAMESPACE}
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels:
        policy.cozystack.io/allow-to-apiserver: "true"
    spec:
      serviceAccountName: cozystack-credentials-migration-67
      restartPolicy: OnFailure
      containers:
        - name: migration
          image: ${image}
          command:
            - credentials-migrate
            - finish
            - --migration=67
            - --kind=MongoDB
            - --format=plaintext
            - --accounts-path=users
            - --source-suffix=-user-
            - --source-key=password
            - --source-per-account
            - --timeout=30m
          env:
            - name: CREDENTIALS_MIGRATE_ACTOR
              value: system:serviceaccount:${NAMESPACE}:cozystack-credentials-migration-67
YAML

# Tie the ServiceAccount's lifetime to the Job: when the Job is deleted (its
# ttlSecondsAfterFinished, a rerun's delete above, or an operator by hand) the
# garbage collector removes the ServiceAccount, on the success and the failure
# path alike, so the least-privilege identity does not stand indefinitely after
# a release the conversion left out.
job_uid=$(kubectl get job cozystack-credentials-migration-67 \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.metadata.uid}')
if [ -z "$job_uid" ]; then
  echo "cannot read the finish Job's uid to own its ServiceAccount" >&2
  exit 1
fi
kubectl patch serviceaccount cozystack-credentials-migration-67 \
  --namespace "$NAMESPACE" \
  --type merge \
  --patch "{\"metadata\":{\"ownerReferences\":[{\"apiVersion\":\"batch/v1\",\"kind\":\"Job\",\"name\":\"cozystack-credentials-migration-67\",\"uid\":\"${job_uid}\"}]}}"

stamp_cozystack_version 68
