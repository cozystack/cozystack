#!/bin/sh
# Migration 64 --> 65
# Convert MariaDB accounts to platform-minted credentials, first part.
#
# The converted mariadb chart renders a CredentialTemplate per user, and each
# mariadb-operator User reads its mysql_native_password hash from the
# template's account Secret, which cozystack-controller seeds with a random
# password only on a release marked for seeding. This hook runs before any
# component chart changes version and writes those Secrets, unowned, for
# every existing MariaDB release from the passwords in <release>-credentials,
# so clients keep logging in at every point of the upgrade; the controller
# adopts them once the templates exist. A release whose every account got its
# Secret is marked for seeding, so users added later are seeded too. A
# users.root entry is skipped: the chart has always ignored it, and root is
# the platform's own account.
#
# The second part is the cozystack-credentials-migration-64 Job, which waits
# per release for its chart to switch, then strips any leftover plaintext from
# the values and removes the tenant keys from <release>-credentials. root
# stays there, since rootPasswordSecretKeyRef cannot change once set, and the
# converted chart hides that Secret from tenants. This Job does not rotate
# root: mariadb-operator reads it on every SQL reconcile, the server pods take
# it as MARIADB_ROOT_PASSWORD at start and their probes log in with it, so an
# ALTER USER without a coordinated pod restart fails every probe. The root
# password tenants could read before the conversion keeps working until a
# platform administrator rotates it.
#
# The hook creates the Job directly rather than rendering it from the platform
# chart, for the reasons migration 62 gives, under names of its own: migration
# 62's Job may still be running when this hook deletes and recreates its own,
# and a shared ServiceAccount would be deleted out from under it. The Job's
# ServiceAccount is bound to a least-privilege ClusterRole (CRUD on Secrets,
# get/list/patch on HelmReleases, create on Events, its state ConfigMap) and
# owned by the Job, so the garbage collector removes it with the Job. While
# any release is left out, credentials-migrate labels its state ConfigMap
# credentials.cozystack.io/incomplete=true, which the
# CredentialsMigrationIncomplete alert fires on. To rerun it by hand, delete
# the Job and re-apply the manifest below.
#
# Fail-closed: migrations never re-run, so an error here stops the upgrade
# rather than stamping the version past a release that was not recorded.

set -euo pipefail

# shellcheck source=lib/cozystack-version.sh
. "$(dirname "$0")/lib/cozystack-version.sh"

NAMESPACE="${NAMESPACE:-cozy-system}"

credentials-migrate seed \
  --migration 64 \
  --kind MariaDB \
  --format mysql-native \
  --accounts-path users \
  --skip-account root \
  --label 'k8s.mariadb.com/watch='

# The finish Job runs the same image as this hook, so a release and its
# conversion share the credentials-migrate build. Read it from this pod's own
# container by name rather than render it from values, which the hook does not
# carry, and rather than by position, which a webhook-injected container shifts.
image=$(kubectl get pod "$(hostname)" \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.spec.containers[?(@.name=="migration")].image}')
if [ -z "$image" ]; then
  echo "cannot read this pod's image to run the finish Job" >&2
  exit 1
fi

# Delete any Job left by an earlier run of this hook: its pod template is
# immutable, so a rerun on a newer image would fault on apply. finish recovers
# its progress from the state ConfigMap, so recreating the Job loses nothing.
# Delete the ServiceAccount with it: an earlier run may have left it owned by
# the Job just deleted, and the apply below does not touch ownerReferences, so
# without this the garbage collector could remove the re-applied ServiceAccount
# out from under the ownerReference patch. A fresh, owner-less ServiceAccount is
# never collected before the patch names the new Job.
kubectl delete job cozystack-credentials-migration-64 \
  --namespace "$NAMESPACE" \
  --ignore-not-found
kubectl delete serviceaccount cozystack-credentials-migration-64 \
  --namespace "$NAMESPACE" \
  --ignore-not-found

kubectl apply --filename - <<YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cozystack-credentials-migration-64
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "create", "patch", "delete"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create"]
  - apiGroups: ["helm.toolkit.fluxcd.io"]
    resources: ["helmreleases"]
    verbs: ["get", "list", "patch"]
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cozystack-credentials-migration-64
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cozystack-credentials-migration-64
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cozystack-credentials-migration-64
subjects:
  - kind: ServiceAccount
    name: cozystack-credentials-migration-64
    namespace: ${NAMESPACE}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: cozystack-credentials-migration-64
  namespace: ${NAMESPACE}
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels:
        policy.cozystack.io/allow-to-apiserver: "true"
    spec:
      serviceAccountName: cozystack-credentials-migration-64
      restartPolicy: OnFailure
      containers:
        - name: migration
          image: ${image}
          command:
            - credentials-migrate
            - finish
            - --migration=64
            - --kind=MariaDB
            - --format=mysql-native
            - --accounts-path=users
            - --skip-account=root
            - --label=k8s.mariadb.com/watch=
            - --platform-key=root
            - --timeout=30m
          env:
            - name: CREDENTIALS_MIGRATE_ACTOR
              value: system:serviceaccount:${NAMESPACE}:cozystack-credentials-migration-64
YAML

# Tie the ServiceAccount's lifetime to the Job: when the Job is deleted (its
# ttlSecondsAfterFinished, a rerun's delete above, or an operator by hand) the
# garbage collector removes the ServiceAccount, on the success and the failure
# path alike, so the least-privilege identity does not stand indefinitely after
# a release the conversion left out.
job_uid=$(kubectl get job cozystack-credentials-migration-64 \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.metadata.uid}')
if [ -z "$job_uid" ]; then
  echo "cannot read the finish Job's uid to own its ServiceAccount" >&2
  exit 1
fi
kubectl patch serviceaccount cozystack-credentials-migration-64 \
  --namespace "$NAMESPACE" \
  --type merge \
  --patch "{\"metadata\":{\"ownerReferences\":[{\"apiVersion\":\"batch/v1\",\"kind\":\"Job\",\"name\":\"cozystack-credentials-migration-64\",\"uid\":\"${job_uid}\"}]}}"

stamp_cozystack_version 65
