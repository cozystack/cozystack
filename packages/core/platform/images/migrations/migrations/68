#!/bin/sh
# Migration 68 --> 69
# Convert RabbitMQ users to platform-minted credentials, first part.
#
# The converted rabbitmq chart renders a CredentialTemplate per user and
# points each User's importCredentialsSecret at the template's account
# Secret, which cozystack-controller seeds with a random password only on a
# release marked for seeding. This hook runs before any component chart
# changes version and writes those Secrets, unowned, for every existing
# RabbitMQ release from the per-user <release>-<user>-credentials Secrets the
# old chart generated, so clients keep logging in at every point of the
# upgrade; the controller adopts them once the templates exist. The old
# chart kept one Secret per user, holding username and password, so they are
# found by label and by the Helm release that rendered them. A release whose
# every user got its Secret is marked for seeding, so users added later are
# seeded too. The account Secret carries the label messaging-topology-operator
# caches Secrets by; without it the operator's admission webhook refuses the
# User.
#
# The second part is the cozystack-credentials-migration-68 Job, which waits
# per release for its chart to switch, then strips any users.<name>.password
# left in the values, deletes a per-user Secret Helm did not prune, and labels
# the operator's <release>-default-user Secret not tenant-visible. That Secret
# holds the administrator messaging-topology-operator logs in with. The
# converted ApplicationDefinition excludes it, which keeps it hidden on every
# rewrite by the cluster operator: that rewrite replaces the Secret's labels,
# and the lineage webhook stamps it again from the definition. The label is
# still needed for the Secret as it stands, which the webhook stamped visible
# under the old definition and leaves alone until such a rewrite. It goes on
# only once the definition in the API excludes the Secret: the rabbitmq-rd
# chart upgrades after the new cluster operator is Ready, whose first pass
# rewrites the Secret, and a label written before would be undone by it. Its
# password is not rotated here: the broker takes the default user's password
# only at first boot, so a rotation is a broker operation this Job does not
# have.
#
# The Job is created directly rather than rendered from the platform chart,
# for the reasons migration 64 gives, and runs the image this hook runs as.
# Its ServiceAccount, ClusterRole and binding carry this migration's number,
# so a conversion running in the same upgrade never deletes or re-owns
# another's identity. The ClusterRole is least-privilege: finish needs CRUD
# and list on Secrets (list, for the per-user sources), get/list/patch on
# HelmReleases, create on Events, and its state ConfigMap. The ServiceAccount
# is owned by the Job, so the garbage collector removes it with the Job; the
# ClusterRoleBinding cannot be owned by a namespaced Job and is left, granting
# to no subject once the ServiceAccount is gone. To rerun the Job by hand,
# delete it and re-apply the manifest below.
#
# Fail-closed: migrations never re-run, so an error here stops the upgrade
# rather than stamping the version past a release that was not recorded.

set -euo pipefail

# shellcheck source=lib/cozystack-version.sh
. "$(dirname "$0")/lib/cozystack-version.sh"

NAMESPACE="${NAMESPACE:-cozy-system}"
NAME=cozystack-credentials-migration-68

credentials-migrate seed \
  --migration 68 \
  --kind RabbitMQ \
  --format plaintext \
  --accounts-path users \
  --source-selector 'apps.cozystack.io/user-secret=true' \
  --source-key password \
  --label 'rabbitmq.com/topology-operator=true'

# The finish Job runs the same image as this hook. Read it from this pod's
# own container by name, as migration 64 does.
image=$(kubectl get pod "$(hostname)" \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.spec.containers[?(@.name=="migration")].image}')
if [ -z "$image" ]; then
  echo "cannot read this pod's image to run the finish Job" >&2
  exit 1
fi

# Delete any Job and ServiceAccount left by an earlier run of this hook: the
# pod template is immutable, and a ServiceAccount still owned by the deleted
# Job could be collected after the apply below. finish recovers its progress
# from the state ConfigMap, so recreating the Job loses nothing.
kubectl delete job "$NAME" \
  --namespace "$NAMESPACE" \
  --ignore-not-found
kubectl delete serviceaccount "$NAME" \
  --namespace "$NAMESPACE" \
  --ignore-not-found

kubectl apply --filename - <<YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ${NAME}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "patch", "delete"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create"]
  - apiGroups: ["helm.toolkit.fluxcd.io"]
    resources: ["helmreleases"]
    verbs: ["get", "list", "patch"]
  - apiGroups: ["cozystack.io"]
    resources: ["applicationdefinitions"]
    verbs: ["list"]
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${NAME}
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${NAME}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ${NAME}
subjects:
  - kind: ServiceAccount
    name: ${NAME}
    namespace: ${NAMESPACE}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${NAME}
  namespace: ${NAMESPACE}
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels:
        policy.cozystack.io/allow-to-apiserver: "true"
    spec:
      serviceAccountName: ${NAME}
      restartPolicy: OnFailure
      containers:
        - name: migration
          image: ${image}
          command:
            - credentials-migrate
            - finish
            - --migration=68
            - --kind=RabbitMQ
            - --format=plaintext
            - --accounts-path=users
            - --source-selector=apps.cozystack.io/user-secret=true
            - --source-key=password
            - --label=rabbitmq.com/topology-operator=true
            - --hide-secret-suffix=-default-user
            - --timeout=30m
          env:
            - name: CREDENTIALS_MIGRATE_ACTOR
              value: system:serviceaccount:${NAMESPACE}:${NAME}
YAML

# Tie the ServiceAccount's lifetime to the Job, as migration 64 does.
job_uid=$(kubectl get job "$NAME" \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.metadata.uid}')
if [ -z "$job_uid" ]; then
  echo "cannot read the finish Job's uid to own its ServiceAccount" >&2
  exit 1
fi
kubectl patch serviceaccount "$NAME" \
  --namespace "$NAMESPACE" \
  --type merge \
  --patch "{\"metadata\":{\"ownerReferences\":[{\"apiVersion\":\"batch/v1\",\"kind\":\"Job\",\"name\":\"${NAME}\",\"uid\":\"${job_uid}\"}]}}"

stamp_cozystack_version 69
