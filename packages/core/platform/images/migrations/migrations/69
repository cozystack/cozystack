#!/bin/sh
# Migration 69 --> 70
# Convert the Redis password to platform-minted credentials, first part.
#
# The converted redis chart renders one CredentialTemplate, for the default
# user, while authEnabled is on, and points the RedisFailover's
# auth.secretPath at its account Secret, which cozystack-controller seeds
# with a random password only on a release marked for seeding. This hook runs
# before any component chart changes version and writes that Secret, unowned,
# for every existing Redis release from the password in <release>-auth, so
# the clients keep the password they have at every point of the upgrade.
# (Replication, the Sentinels, the probes and the exporter move to the
# operator's own internal account when the operator is upgraded,
# independently of this migration.) The controller adopts the Secret once
# the template exists. A release whose Secret was written, or that has
# authentication off, is marked for seeding.
# The Redis backup strategy reads the same account Secret, so the next
# backup authenticates with the migrated password.
#
# The hook also suspends every Redis release until the redis-operator
# Deployment runs its new revision. Every application chart switches the
# moment the platform chart moves the packages source, while the operator
# rolls out later, and the converted chart changes the pod template: the
# old operator rolls such a change by deleting the master, failing writes
# for about a minute, where the new one moves the master off first and
# applies the password with no restart. The finish Job resumes the
# releases once the new operator runs, and may read Deployments for that.
#
# The second part is the cozystack-credentials-migration-69 Job, which waits
# per release for its chart to switch, then deletes whatever is left of
# <release>-auth, which the switched chart no longer renders. The hook creates
# the Job directly, with a least-privilege ServiceAccount the Job owns, for the
# reasons migration 64 gives: a chart-rendered Job would hold up the platform
# release and fault on its immutable pod template at the next upgrade. To
# rerun it by hand, delete the Job and re-apply the manifest below.
#
# Fail-closed: migrations never re-run, so an error here stops the upgrade
# rather than stamping the version past a release that was not recorded.

set -euo pipefail

# shellcheck source=lib/cozystack-version.sh
. "$(dirname "$0")/lib/cozystack-version.sh"

NAMESPACE="${NAMESPACE:-cozy-system}"

credentials-migrate seed \
  --migration 69 \
  --kind Redis \
  --format plaintext \
  --fixed-account default \
  --source-key password \
  --enabled-flag authEnabled \
  --source-suffix=-auth \
  --hold-until-rollout cozy-redis-operator/redis-operator

# The finish Job runs the same image as this hook, so a release and its
# conversion share the credentials-migrate build. Read it from this pod's own
# container by name rather than render it from values, which the hook does not
# carry, and rather than by position, which a webhook-injected container shifts.
image=$(kubectl get pod "$(hostname)" \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.spec.containers[?(@.name=="migration")].image}')
if [ -z "$image" ]; then
  echo "cannot read this pod's image to run the finish Job" >&2
  exit 1
fi

# Delete any Job left by an earlier run of this hook: its pod template is
# immutable, so a rerun on a newer image would fault on apply. finish recovers
# its progress from the state ConfigMap, so recreating the Job loses nothing.
# Delete the ServiceAccount with it: an earlier run may have left it owned by
# the Job just deleted, and the apply below does not touch ownerReferences, so
# without this the garbage collector could remove the re-applied ServiceAccount
# out from under the ownerReference patch. A fresh, owner-less ServiceAccount is
# never collected before the patch names the new Job.
kubectl delete job cozystack-credentials-migration-69 \
  --namespace "$NAMESPACE" \
  --ignore-not-found
kubectl delete serviceaccount cozystack-credentials-migration-69 \
  --namespace "$NAMESPACE" \
  --ignore-not-found

kubectl apply --filename - <<YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cozystack-credentials-migration-69
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "create", "patch", "delete"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create"]
  - apiGroups: ["helm.toolkit.fluxcd.io"]
    resources: ["helmreleases"]
    verbs: ["get", "list", "patch"]
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get"]
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cozystack-credentials-migration-69
  namespace: ${NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cozystack-credentials-migration-69
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cozystack-credentials-migration-69
subjects:
  - kind: ServiceAccount
    name: cozystack-credentials-migration-69
    namespace: ${NAMESPACE}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: cozystack-credentials-migration-69
  namespace: ${NAMESPACE}
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 604800
  template:
    metadata:
      labels:
        policy.cozystack.io/allow-to-apiserver: "true"
    spec:
      serviceAccountName: cozystack-credentials-migration-69
      restartPolicy: OnFailure
      containers:
        - name: migration
          image: ${image}
          command:
            - credentials-migrate
            - finish
            - --migration=69
            - --kind=Redis
            - --format=plaintext
            - --fixed-account=default
            - --source-key=password
            - --enabled-flag=authEnabled
            - --source-suffix=-auth
            - --timeout=30m
          env:
            - name: CREDENTIALS_MIGRATE_ACTOR
              value: system:serviceaccount:${NAMESPACE}:cozystack-credentials-migration-69
YAML

# Tie the ServiceAccount's lifetime to the Job: when the Job is deleted (its
# ttlSecondsAfterFinished, a rerun's delete above, or an operator by hand) the
# garbage collector removes the ServiceAccount, on the success and the failure
# path alike, so the least-privilege identity does not stand indefinitely after
# a release the conversion left out.
job_uid=$(kubectl get job cozystack-credentials-migration-69 \
  --namespace "$NAMESPACE" \
  --output 'jsonpath={.metadata.uid}')
if [ -z "$job_uid" ]; then
  echo "cannot read the finish Job's uid to own its ServiceAccount" >&2
  exit 1
fi
kubectl patch serviceaccount cozystack-credentials-migration-69 \
  --namespace "$NAMESPACE" \
  --type merge \
  --patch "{\"metadata\":{\"ownerReferences\":[{\"apiVersion\":\"batch/v1\",\"kind\":\"Job\",\"name\":\"cozystack-credentials-migration-69\",\"uid\":\"${job_uid}\"}]}}"

stamp_cozystack_version 70
